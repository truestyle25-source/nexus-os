# NEXUS OS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commit o arquivo .env com valores reais.

# Chave da API Google Gemini (NEXUS IA)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.6-flash

# Segredo JWT (mínimo 32 caracteres — gere com: openssl rand -hex 32)
JWT_SECRET=sua_chave_jwt_com_minimo_32_caracteres_aqui

# Resend (e-mails transacionais)
RESEND_API_KEY=re_sua_chave_resend_aqui
EMAIL_FROM=no-responder@seudominio.com

# URLs permitidas para CORS (frontend)
FRONTEND_URLS=https://producao.seudominio.com,http://localhost:3000

# URL pública da API (frontend)
NEXT_PUBLIC_API_URL=http://localhost:3333

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nexus_os?schema=public

# Dias de trial para novo cadastro
TRIAL_DAYS=7

# Snapshot diário de estoque
SNAPSHOT_AUTO_ENABLED=true
SNAPSHOT_HOUR_UTC=2

# Backup
BACKUP_DIR=./backups
BACKUP_RETENCAO_DIAS=30

# Fuso horário padrão da empresa
EMPRESA_FUSO=America/Sao_Paulo