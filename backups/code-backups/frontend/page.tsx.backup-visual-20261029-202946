/** BOM (ï»¿) para o Excel abrir os acentos (mesma tÃ©cnica de /vendas e /fluxo). */
function baixarCsv(cabecalho: string[], linhas: string[][], nome: string): void {
  const conteudo = [cabecalho, ...linhas]
