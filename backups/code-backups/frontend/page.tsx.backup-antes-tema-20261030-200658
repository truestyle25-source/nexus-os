  const [storageOk, setStorageOk] = useState<boolean | null>(null);
  const [storageMsg, setStorageMsg] = useState<string>('');

  // calendário / relógio
  const [mesRef, setMesRef] = useState(() => new Date());
  const [horaAgora, setHoraAgora] = useState('');

  // painel de IA
  const [iaTexto, setIaTexto] = useState('');
  const [iaLoading, setIaLoading] = useState(false);

  // dados integrados: batidas, relógio, desempenho
  const [batidas, setBatidas] = useState<any[]>([]);
  const [relogio, setRelogio] = useState<any>(null);
  const [desempenho, setDesempenho] = useState<any>(null);
  const [syncLoading, setSyncLoading] = useState(false);

  // formulário de funcionário (criar/editar)
