/**
 * Converte o registro do banco (`Desligamento` do Prisma) no formato que a
 * tela usa. As VERBAS vêm prontas do servidor, calculadas a partir do salário
 * persistido — a tela não recalcula nem inventa valor, e `demo` deixa de
 * existir: registro agora é sempre real (a rota devolve 404/409 em vez de
 * fabricar).
 */
/**
 * Etapa real do fluxo disciplinar, a partir do HISTÓRICO do funcionário.
 *
 * Antes era `HOMOLOGADO ? 4 : ASSINADO ? 3 : 2`: a timeline acendia 4/4
 * apenas porque o status era HOMOLOGADO, sem olhar se a pessoa passou por
 * advertência ou suspensão — e nada impedia pular direto para HOMOLOGADO.
 * Agora cada etapa depende de existir ato correspondente no banco.
 */
function etapaFluxoReal(d: Desligamento): { etapa: number; rotulo: string } {
  if (d.status === 'CANCELADO') return { etapa: 0, rotulo: 'Cancelado' };
  const temAdvertencia = d.advertencias > 0;
  const temSuspensao = d.suspensoes > 0;
  // 1 = advertência, 2 = suspensão, 3 = justa causa/desligamento, 4 = homologado
  let etapa = 1;
  if (temSuspensao) etapa = 2;
  if (temAdvertencia || temSuspensao) etapa = Math.max(etapa, 2);
  if (d.status === 'HOMOLOGADO') etapa = 4;
  else if (d.status === 'ASSINADO') etapa = 3;
  else etapa = temAdvertencia || temSuspensao ? 2 : 1;
  const rotulo =
    etapa === 4 ? 'Homologado'
    : etapa === 3 ? 'Assinado'
    : etapa === 2 ? 'Em processo disciplinar'
    : 'Advertência registrada';
  return { etapa, rotulo };
}

function normalizarDesligamento(d: any): Desligamento {
  const tipo = TIPOS_DESLIG.find((t) => t.value === d.tipo);
  const num = (v: any) => Number(v ?? 0);
  return {
    id: String(d.id),
    funcionarioId: String(d.funcionarioId),
    data: d.data ? String(d.data).slice(0, 10) : '',
    tipo: String(d.tipo ?? ''),
    tipoLabel: String(d.tipoLabel ?? tipo?.label ?? ''),
    art: String(d.art ?? tipo?.art ?? ''),
    cor: tipo?.cor ?? 'zinc',
    motivo: String(d.motivo ?? ''),
    alineas: Array.isArray(d.alineas) ? d.alineas : [],
    aviso: (d.aviso === 'dispensado' || d.aviso === 'trabalhado' ? d.aviso : 'indenizado') as AvisoTipo,
    saldoDias: num(d.saldoDias),
    obs: String(d.observacoes ?? ''),
    docs: Array.isArray(d.documentos) ? d.documentos : [],
    status: (d.status === 'ASSINADO' || d.status === 'HOMOLOGADO' ? d.status : 'PENDENTE') as DesligStatus,
    verbas: {
      // `saldo` é o VALOR em reais do saldo de dias (salário ÷ 30 × dias),
      // gravado pelo servidor em `verbasSaldo`. Antes aqui vinha
      // `num(d.saldoDias)` — a contagem de dias — e o termo imprimia
      // "R$ 10,00" para 10 dias de saldo, que valem R$ 1.000 num salário de
      // R$ 3.000.
      saldo: num(d.verbasSaldo),
      decimo: num(d.verbas13),
      // O banco guarda `verbasFerias` = vencidas + proporcionais; o
      // proporcional vem separado em `verbasFeriasProporc`.
      ferias: num(d.verbasFerias),
      feriasProporc: num(d.verbasFeriasProporc),
      terco: num(d.verbasTerco),
      avisoPrevio: num(d.verbasAviso),
      // FGTS e multa são `null` no banco: não há saldo depositado para apurar
      // (ver `montarVerbas` no backend). Ficar em 0 seria dizer "apurado como
      // zero", que é diferente de "não apurado".
      fgtsMulta: null,
      fgtsApurado: d.fgtsApurado === true,
      total: num(d.verbasTotal),
    },
    // Rótulo da etapa do fluxo disciplinar calculado a partir do HISTÓRICO
    // real do funcionário (quantas advertências e suspensões existem), e não
    // só do status. Ver `etapaFluxoReal`.
    dossieGeradoEm: d.dossieGeradoEm ? String(d.dossieGeradoEm) : null,
    documentoNome: d.documentoNome ? String(d.documentoNome) : null,
    advertencias: 0,
    suspensoes: 0,
    criadoEm: d.createdAt ? String(d.createdAt) : new Date().toISOString(),
  };
}

