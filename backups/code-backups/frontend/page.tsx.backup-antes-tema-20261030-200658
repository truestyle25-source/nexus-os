  /**
   * Verifica se o bucket está configurado.
   *
   * Existe rota `GET /rh/documentos/storage` exatamente para isso: desligar o
   * botão com a mensagem "defina STORAGE_PROVIDER no .env" é melhor do que
   * deixar o operador escolher o arquivo e só depois receber um 502.
   *
   * Falha ao consultar NÃO é tratada como storage quebrado: pode ser rede. Nesse
   * caso a interface assume "configurado" e o erro real aparece no envio, que é
   * a mensagem verdadeira.
   */
  async function consultarStorage() {
    try {
      const s = await statusStorage();
      setStorageOk(s.configurado);
      setStorageMsg(s.mensagem || '');
    } catch {
      setStorageOk(true);
    }
  }

  // Consulta assim que a tela carrega, e não ao abrir o modal: o usuário pode
  // levar alguns segundos para chegar na seção de documentos, e o botão
  // desabilitado sem explicação nenhuma parece quebrado.
  useEffect(() => {
    void consultarStorage();
  }, []);

  /** Adiciona arquivos ao estado, recusando formato/tamanho inválidos. */
  function adicionarArquivos(lista: FileList | File[] | null) {
    if (!lista) return;
    const novos = Array.from(lista);
    const rejeitados: string[] = [];
    const aceitos: File[] = [];
    for (const f of novos) {
      const problema = validarArquivo(f);
      if (problema) rejeitados.push(`${f.name}: ${problema}`);
      else aceitos.push(f);
    }
    if (aceitos.length) {
      setArquivos((p) => {
        // Descarta o reenvio do mesmo arquivo: o `File` já escolhido seria
        // enviado duas vezes, ocupando o bucket com cópia idêntica.
        const nomes = new Set(p.map((f) => `${f.name}:${f.size}`));
        return [...p, ...aceitos.filter((f) => !nomes.has(`${f.name}:${f.size}`))];
      });
    }
    if (rejeitados.length) setError(rejeitados.join(' '));
    else if (aceitos.length) setError(null);
  }

