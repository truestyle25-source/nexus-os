      valeAlimentacao: fun.valeAlimentacao === true,
      valorValeAlimentacao: Number(fun.valorValeAlimentacao ?? 0) > 0 ? String(fun.valorValeAlimentacao) : '',
      valeRefeicao: fun.valeRefeicao === true,
