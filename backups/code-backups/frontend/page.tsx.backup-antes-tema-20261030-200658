      .catch(() => {
        if (vivo) setEmpresaTermo(null);
      });
    return () => {
      vivo = false;
    };
  }, []);

  /** Recarrega só a lista de funcionários (usado após um desligamento). */
  async function recarregarFuncionarios() {
    try {
      const { data } = await api.get('/funcionarios');
      setFuncs(Array.isArray(data) ? data : []);
    } catch {
      /* mantém a lista atual: falhar aqui não deve apagar a tela */
    }
  }

  useEffect(() => {
    if (!getToken()) { router.replace('/'); return; }
    load();
    // Ponto, relógio e desempenho eram fetchados em `.catch(() => undefined)`
    // separados do `load()`. Uma falha em qualquer um deixava o estado vazio
    // sem aviso, e a tela mostrava "Nenhum funcionário." ou um painel em branco
    // como se a empresa não tivesse dados. Agora a falha é registrada.
    api.get('/rh/ponto')
      .then((r) => setBatidas(Array.isArray(r.data) ? r.data : []))
      .catch(() => setError(msgErro({ message: traduzir('falha_ponto', 'Não foi possível carregar as batidas de ponto.') }, '')));
    api.get('/rh/relogio')
      .then((r) => setRelogio(r.data))
      .catch(() => setRelogio(null));
    api.get('/rh/desempenho')
      .then((r) => setDesempenho(r.data))
      .catch(() => setError(msgErro({ message: traduzir('falha_desempenho', 'Não foi possível carregar o desempenho da equipe.') }, '')));
  }, [router]);

  async function sincronizarRelogio() {
    if (!relogio?.id) { setError('Configure a integração do relógio (Integrações) antes de sincronizar.'); return; }
    setSyncLoading(true); setError(null); setNotice(null);
    try {
      const r = await api.post(`/ponto/sincronizar/${relogio.id}`);
      setNotice(`Relógio sincronizado: ${r.data?.processados ?? 0} registros processados.`);
      const [pr, rl] = await Promise.all([api.get('/rh/ponto'), api.get('/rh/relogio')]);
      setBatidas(pr.data); setRelogio(rl.data);
    } catch (err: any) {
      setError(msgErro(err, 'Falha ao sincronizar com o relógio.'));
    } finally { setSyncLoading(false); }
  }

  /**
   * Baixa o PDF do documento.
   *
   * Antes isto chamava `POST .../documento` e recebia `{documentoNome}` — a
   * rota só gravava o nome no banco e nenhum arquivo era produzido. A tela
   * então trocava o botão por um texto "📄 nome-do-arquivo" que não baixava
   * nada, e o usuário ficava sem termo.
   *
   * Agora a rota responde `application/pdf`, e o download é feito por
   * `fetch` + blob: assim o cabeçalho `Authorization` acompanha a requisição
   * (abrir a URL numa aba nova não enviaria o token e o servidor devolveria
   * 401). O objeto é revogado em seguida para não vazar memória.
   */
  /**
   * Baixa documento da folha.
   *
   * `variante` mapeia para as duas rotas reais: `completa` traz a folha inteira
   * e `recibo` o holerite de UM funcionário. São endpoints distintos no
   * backend, então não dá para reaproveitar `baixarDocumento` (que aponta para
   * `/rh/{tipo}/{id}/documento`).
   *
   * Ambas são `GET`: são leituras do que já está gravado, e o `api.download` usa
   * GET por padrão. Antes passava `{}` e o helper fazia POST, o que não casava
   * com o verbo da rota e resultava em 404.
   */
  const baixarDocumentoFolha = useCallback(
    async (folhaId: string, variante: 'completa' | 'recibo', funcionarioId?: string) => {
      setError(null);
      setNotice(null);
      try {
        const caminho = variante === 'recibo'
          ? `/rh/folhas/${folhaId}/recibo/${funcionarioId}`
          : `/rh/folhas/${folhaId}/completa`;
        const { blob, nome } = await api.download(caminho);
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = nome;
        a.click();
        URL.revokeObjectURL(url);
        setNotice(traduzir('pdf_gerado', 'PDF gerado e baixado.'));
      } catch (err: any) {
        setError(msgErro(err, traduzir('pdf_erro', 'Não foi possível gerar o PDF.')));
      }
    },
    [],
  );

  const baixarDocumento = useCallback(
    async (tipo: 'advertencias' | 'suspensoes' | 'desligamentos', id: string) => {
      setError(null);
      setNotice(null);
      try {
        // `post: true` porque a rota é POST: gerar o termo é uma AÇÃO
        // (o servidor registra auditoria e marca o documento como gerado), e
        // não a leitura de um arquivo já pronto como o PDF da folha.
        const { blob, nome } = await api.download(`/rh/${tipo}/${id}/documento`, { post: true });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = nome;
        a.click();
        URL.revokeObjectURL(url);
        setNotice(traduzir('pdf_gerado', 'PDF gerado e baixado.'));
        await load();
      } catch (err: any) {
        setError(msgErro(err, traduzir('pdf_erro', 'Não foi possível gerar o PDF.')));
      }
    },
    [load],
  );

