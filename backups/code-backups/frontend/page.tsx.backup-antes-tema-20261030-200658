/**
 * Minutos de jornada no formato hh:mm.
 *
 * `formatClock` do lib/format recebe uma Data (é o relógio do PDV); para
 * duração em minutos do espelho, converter na hora — usar `toLocaleTimeString`
 * com um número daria sempre 00:00.
 */
function horasMin(min: number): string {
  if (!min) return '—';
  const m = Math.round(min);
  return `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
}

