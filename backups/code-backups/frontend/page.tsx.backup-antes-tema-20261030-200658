      departamentoTexto: fun.departamento?.nome ?? '',
      cargoTexto: fun.cargo?.nome ?? '',
      idExternoPonto: fun.idExternoPonto ?? '', matricula: fun.matricula ?? '',
      salario: fun.salario != null ? String(fun.salario) : '', tipoContrato: fun.tipoContrato ?? 'CLT',
      cargaHoraria: fun.cargaHoraria ?? '', jornada: fun.jornada ?? '',
      horarioEntradaPrevisto: fun.horarioEntradaPrevisto ?? '', horarioSaidaPrevisto: fun.horarioSaidaPrevisto ?? '', status: fun.status ?? 'ATIVO',
      // Os benefícios são carregados para o formulário, senão editar um
