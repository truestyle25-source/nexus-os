/**
 * Chave de dia de um registro de ponto, no MESMO fuso em que o banco grava.
 *
 * `Ponto.data` é `@db.Date`: o Postgres guarda a data pura (2026-09-30 vira
 * `2026-09-30T00:00:00.000Z`, sem hora) e o Prisma devolve essa string ISO.
 *
 * Duas formas de ler, e as duas ERRAM em direções opostas:
 *   • `String(b.data).slice(0,10)` → "2026-09-30" (corta em UTC, correto para
 *     o valor que o banco gravou);
 *   • `new Date(b.data).getDate()` → dia 29 em São Paulo, porque 00:00 UTC é
 *     21:00 do dia ANTERIOR no horário de Brasília. Era este que o `isoDia`
 *     usava: um dia de ponto aparecia na linha de cima.
 *
 * Por isso a comparação é feita sobre a string, e o lado esquerdo (o dia do
 * calendário, montado com `new Date(ano, mes, dia)`, que é data local) é
 * convertido para o mesmo formato ISO antes.
 */
function isoDia(v: string | Date) {
  if (typeof v === 'string') return v.slice(0, 10);
  const d = v;
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

/** Dia do calendário (data local) no mesmo formato ISO usado por `isoDia`. */
function isoDiaLocal(ano: number, mes1a12: number, dia: number) {
  return `${ano}-${String(mes1a12).padStart(2, '0')}-${String(dia).padStart(2, '0')}`;
}

/** Hora de uma batida, no formato escolhido em Configurações (12h/24h). */
function hhmm(v: any) {
  if (!v) return '—';
  return formatTime(v);
}

function minutosEntre(inicio: any, fim: any) {
  if (!inicio || !fim) return 0;
  const a = new Date(inicio).getTime();
  const b = new Date(fim).getTime();
  if (Number.isNaN(a) || Number.isNaN(b) || b <= a) return 0;
  return Math.round((b - a) / 60000);
}

/**
 * Jornada diária alvo, em minutos trabalhados (desconta o intervalo da faixa).
 *
 * Prioridade dos dados: os horários previstos separados
 * (`horarioEntradaPrevisto`/`horarioSaidaPrevisto`) vêm primeiro, porque são
 * campos próprios e já vêm subtraindo o intervalo. O texto livre `jornada`
 * ("08:00-17:00") continua sendo lido depois, para os cadastros que só têm ele —
 * e por último a `cargaHoraria`.
 */
function jornadaMinutos(func?: { horarioEntradaPrevisto?: string | null; horarioSaidaPrevisto?: string | null; jornada?: string | null; cargaHoraria?: string | null } | null) {
  const hhmmMin = (v: unknown): number | null => {
    const m = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(String(v ?? '').trim());
    return m ? Number(m[1]) * 60 + Number(m[2]) : null;
  };
  const entrada = hhmmMin(func?.horarioEntradaPrevisto);
  const saida = hhmmMin(func?.horarioSaidaPrevisto);
  if (entrada !== null && saida !== null && saida > entrada) {
    return Math.min(saida - entrada, 12 * 60);
  }
  const texto = `${func?.jornada ?? ''} ${func?.cargaHoraria ?? ''}`.toLowerCase();
  const cargaHoras = texto.match(/(\d{1,2})\s*h(?:oras?)?/);
  if (cargaHoras) return Math.min(Number(cargaHoras[1]) * 60, 12 * 60);
  const faixa = texto.match(/(\d{1,2}):(\d{2})\s*(?:-|até|ate|to)\s*(\d{1,2}):(\d{2})/);
  if (faixa) {
    const span = (Number(faixa[3]) * 60 + Number(faixa[4])) - (Number(faixa[1]) * 60 + Number(faixa[2]));
    // Faixa de 10h significa 8h trabalhadas (2h de intervalo).
    return Math.max(60, span > 9 * 60 ? span - 120 : span);
  }
  return 8 * 60;
}

/**
 * Linhas do espelho do mês — SOMENTE a partir das batidas REAIS de
 * GET /rh/ponto.
 *
 * ANTES: dias sem registro viravam linhas de demonstração geradas por um LCG
 * (`pseudoRandom`), com entrada 08:xx / saída 17:00, e 5,5% de chance de virar
 * "falta". Essas linhas entravam no filtro de faltas/atrasos e em `totaisPonto`
 * junto com as reais — quem usasse o espelho para desconto de falta estava
 * descontando número sorteado. Um LCG não é "ilustração de layout": é um
 * registro de ponto falso, e a tela de RH é documento de trabalho.
 *
 * AGORA: o que não tem batida não vira linha. Um dia sem registro aparece como
 * "sem registro" (cinza), que é a informação verdadeira. A soma de horas e a
 * contagem de faltas passam a refletir só o que existe no banco.
 */
function gerarLinhasPonto(mes: string, batidas: any[], funcId: string, minAlvo: number): LinhaPonto[] {
  const [ano, mesNum] = mes.split('-').map(Number);
  if (!ano || !mesNum) return [];
  const totalDias = new Date(ano, mesNum, 0).getDate();
  const dow = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];

  const porDia = new Map<string, any>();
  for (const b of batidas) {
    if (b.funcionarioId !== funcId) continue;
    porDia.set(isoDia(b.data), b);
  }

  const linhas: LinhaPonto[] = [];

  for (let dia = 1; dia <= totalDias; dia++) {
    const data = new Date(ano, mesNum - 1, dia);
    const base: LinhaPonto = {
      dia, dow: dow[data.getDay()], status: 'sem-registro',
      entrada: '—', saidaIntervalo: '—', retornoIntervalo: '—', saida: '—',
      min: 0, extraMin: 0,
    };

    // O registro do dia é consultado ANTES da checagem de domingo.
    //
    // Antes o domingo era descartado aqui, com `continue`, e a batida nunca era
    // procurada: quem trabalhava num domingo — ou registrava a marcação num dia
    // de fim de semana — tinha o dado gravado no banco e via "domingo" no
    // espelho, sem uma hora sequer. O dia da semana só define o RÓTULO de um
    // dia sem registro; havendo batida real, ela manda.
    const reg = porDia.get(isoDiaLocal(ano, mesNum, dia));

    if (data.getDay() === 0 && !reg) {
      linhas.push({ ...base, status: 'domingo' });
      continue;
    }

    if (!reg) {
      // Sem batida real: fica "sem registro". Não gera horário, não conta
      // falta e não soma hora — apenas informa que o dia não tem dado.
      linhas.push(base);
      continue;
    }

    // Jornada aberta (entrada sem saída) não é dia trabalhado: sem a saída não
    // há quanto tempo a pessoa ficou. Some 0 e não vira crédito de hora extra.
    const jornadaFechada = Boolean(reg.entrada && reg.saida);
    // O intervalo é o REGISTRADO, não uma constante.
    //
    // Antes descontavam 60 minutos fixos, o que errava duas vezes: um almoço de
    // 2h desconta 1h e credita 1h de hora extra, e um intervalo de 20min
    // desconta 1h. Pior, o sistema passou a gravar `saidaIntervalo` e
    // `retornoIntervalo` e este cálculo os ignorava. Sem intervalo registrado não
    // se inventa pausa nenhuma: a jornada fica bruta, que é o que o relógio
    // mostra — e a meta (`minAlvo`) também é bruta, então as duas bases ficam
    // iguais e a hora extra não é creditada por um almoço não registrado.
    const pausa = reg.saidaIntervalo && reg.retornoIntervalo
      ? minutosEntre(reg.saidaIntervalo, reg.retornoIntervalo)
      : 0;
    const min = reg.falta || !jornadaFechada ? 0 : Math.max(0, minutosEntre(reg.entrada, reg.saida) - pausa);
    linhas.push({
      ...base,
      status: reg.falta ? 'falta' : !jornadaFechada ? 'sem-registro' : (reg.atrasoMinutos ?? 0) > 0 ? 'atraso' : 'ok',
      entrada: hhmm(reg.entrada),
      saidaIntervalo: hhmm(reg.saidaIntervalo),
      retornoIntervalo: hhmm(reg.retornoIntervalo),
      saida: hhmm(reg.saida),
      min,
      extraMin: Math.max(0, min - minAlvo),
    });
  }
  return linhas;
}

/**
 * Totais do espelho — contam SOMENTE o que existe no banco.
 *
 * `sem-registro` e `domingo` saem da contagem: um dia sem batida não é falta
 * (falta é um registro com `falta: true`), é ausência de dado. Somar "sem
 * registro" como falta faria o espelho acusar falta em todos os dias que
 * simplesmente não tiveram marcação.
 */
function totaisPonto(linhas: LinhaPonto[]) {
  let min = 0; let faltas = 0; let atrasos = 0; let extraMin = 0; let dias = 0; let semRegistro = 0;
  for (const l of linhas) {
    if (l.status === 'domingo') continue;
    if (l.status === 'sem-registro') { semRegistro++; continue; }
    dias++;
    if (l.status === 'falta') { faltas++; continue; }
    min += l.min;
    if (l.status === 'atraso') atrasos++;
    extraMin += l.extraMin;
  }
  return { min, faltas, atrasos, extraMin, dias, semRegistro, horas: Math.floor(min / 60), restoMin: min % 60 };
}

export default function RH() {
