   * Empresa REAL para o termo de desligamento. Antes o documento imprimia
   * "Helix Corp Ltda" e CNPJ "00.000.000/0001-00" fixos no código — um termo
   * de rescisão com dados inventados. Agora vem de `GET /empresas`; se a API
   * falhar, o campo fica "—" em vez de mentir.
   */
  const [empresaTermo, setEmpresaTermo] = useState<any>(null);
  useEffect(() => {
    if (!getToken()) return;
    let vivo = true;
    api
      .get<any[]>('/empresas')
      .then(({ data }) => {
        if (vivo) setEmpresaTermo(Array.isArray(data) ? data[0] ?? null : null);
