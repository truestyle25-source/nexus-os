   * vinculados — a relação continua a mesma, só o rótulo muda.
   */
  async function salvarDepartamento(e: React.FormEvent) {
    e.preventDefault(); setError(null); setNotice(null);
    try {
      if (editandoDep) {
        await api.put(`/departamentos/${editandoDep}`, { nome: depNome });
        setNotice(traduzir('departamento_atualizado', 'Departamento atualizado.'));
        setEditandoDep(null);
      } else {
        await api.post('/departamentos', { nome: depNome });
        setNotice(traduzir('departamento_criado', 'Departamento criado.'));
      }
      setDepNome('');
      await load();
    } catch (err: any) { setError(msgErro(err, traduzir('falha_departamento', 'Falha ao salvar departamento.'))); }
  }

  function editarDepartamento(d: any) {
    setEditandoDep(d.id);
    setCargoDep('');
    setDepNome(d.nome ?? '');
  }

  /**
   * Exclui um departamento. O servidor recusa (409) quando há cargo ou
   * funcionário vinculado — a mensagem chega aqui e é mostrada, em vez de a
   * linha sumir sem explicação.
   */
  async function excluirDepartamento(id: string, nome: string) {
    setError(null); setNotice(null);
    try {
      await api.delete(`/departamentos/${id}`);
      setNotice(traduzir('departamento_excluido', `Departamento "${nome}" excluído.`));
      if (editandoDep === id) { setEditandoDep(null); setDepNome(''); }
      await load();
    } catch (err: any) { setError(msgErro(err, traduzir('falha_excluir_departamento', 'Não foi possível excluir o departamento.'))); }
  }

  /** Salva cargo em modo criação OU edição (inclusive mudando o departamento). */
  async function salvarCargo(e: React.FormEvent) {
    e.preventDefault(); setError(null); setNotice(null);
    try {
      if (editandoCargo) {
        // `departamentoId: null` desvincula; enviar o id move para outro
        // departamento. A distinção existe porque o backend trata as duas
        // coisas de forma diferente.
        await api.put(`/cargos/${editandoCargo}`, { nome: cargoNome, departamentoId: cargoDep || null });
        setNotice(traduzir('cargo_atualizado', 'Cargo atualizado.'));
        setEditandoCargo(null);
      } else {
        await api.post('/cargos', { nome: cargoNome, departamentoId: cargoDep || undefined });
        setNotice(traduzir('cargo_criado', 'Cargo criado.'));
      }
      setCargoNome(''); setCargoDep('');
      await load();
    } catch (err: any) { setError(msgErro(err, traduzir('falha_cargo', 'Falha ao salvar cargo.'))); }
  }

  function editarCargo(c: any) {
    setEditandoCargo(c.id);
    setCargoNome(c.nome ?? '');
    setCargoDep(c.departamentoId ?? '');
  }

  /** Exclui um cargo — recusado (409) pelo servidor se houver funcionário vinculado. */
  async function excluirCargo(id: string, nome: string) {
    setError(null); setNotice(null);
    try {
      await api.delete(`/cargos/${id}`);
      setNotice(traduzir('cargo_excluido', `Cargo "${nome}" excluído.`));
      if (editandoCargo === id) { setEditandoCargo(null); setCargoNome(''); setCargoDep(''); }
      await load();
    } catch (err: any) { setError(msgErro(err, traduzir('falha_excluir_cargo', 'Não foi possível excluir o cargo.'))); }
  }

  const porDepartamento = useMemo(() => {
    const m = new Map<string, number>();
    for (const fu of funcs) if (fu.departamentoId) m.set(fu.departamentoId, (m.get(fu.departamentoId) || 0) + 1);
    return m;
  }, [funcs]);
  void porDepartamento;

  const filtrados = useMemo(() => funcs.filter((fu: any) => {
    const q = busca.toLowerCase();
    const okBusca = !busca || (fu.nome || '').toLowerCase().includes(q) || (fu.cpf || '').includes(busca) || (fu.matricula || '').toLowerCase().includes(q) || (fu.idExternoPonto || '').toLowerCase().includes(q);
    const okDep = !filtroDep || fu.departamentoId === filtroDep;
    const okStatus = !filtroStatus || (filtroStatus === 'ATIVOS' ? fu.status === 'ATIVO' : filtroStatus === 'AFASTADOS' ? (fu.status === 'AFASTADO' || fu.status === 'FERIAS') : true);
    return okBusca && okDep && okStatus;
  }), [funcs, busca, filtroDep, filtroStatus]);

  const totalAtivos = useMemo(() => funcs.filter((fu: any) => fu.status === 'ATIVO').length, [funcs]);

  // calendário
  const hoje = new Date();
  const diasDoMes = useMemo(() => {
    const y = mesRef.getFullYear(), m = mesRef.getMonth();
    return Array.from({ length: new Date(y, m + 1, 0).getDate() }, (_, i) => i + 1);
  }, [mesRef]);
  const vazio = useMemo(() => new Date(mesRef.getFullYear(), mesRef.getMonth(), 1).getDay(), [mesRef]);
  const mesTitulo = `${MESES[mesRef.getMonth()]} ${mesRef.getFullYear()}`;
  function ehHoje(dia: number) {
    return hoje.getFullYear() === mesRef.getFullYear() && hoje.getMonth() === mesRef.getMonth() && hoje.getDate() === dia;
  }
  const relogioOk = funcs.some((fu: any) => fu.idExternoPonto);

  async function gerarInsight() {
    setIaLoading(true); setIaTexto('');
    try {
      const r = await api.post('/ia/perguntar', {
        pergunta: `Gere uma análise curta do desempenho da equipe: ${JSON.stringify(indicadores)}`,
      });
      setIaTexto(typeof r.data === 'string' ? r.data : (r.data?.resposta ?? r.data?.texto ?? JSON.stringify(r.data)));
    } catch {
      setIaTexto('Não foi possível gerar a análise agora. Verifique a configuração da IA.');
    } finally { setIaLoading(false); }
  }

  const totalAtivosDep = totalAtivos;
  void totalAtivosDep;

  // ==========================================================================
  // Desligamento (CLT) + Espelho de ponto
  // ==========================================================================

  // Funcionário selecionado no espelho; até o usuário escolher, usa o primeiro da lista.
  const funcAtivo = useMemo(
    () => funcs.find((fu: any) => fu.id === espelhoFunc) || funcs[0],
    [funcs, espelhoFunc],
  );
  const minAlvo = useMemo(() => jornadaMinutos(funcAtivo), [funcAtivo]);

  // Batidas REAIS do mês escolhido — só busca quando a aba de espelho está aberta.
  useEffect(() => {
    if (aba !== 'espelho' || !funcAtivo?.id) { setPontoBatidas([]); return; }
    const [ano, mesNum] = espelhoMes.split('-').map(Number);
    if (!ano || !mesNum) { setPontoBatidas([]); return; }
    const ultimo = new Date(ano, mesNum, 0).getDate();
    const qs = `dataInicio=${espelhoMes}-01&dataFim=${espelhoMes}-${String(ultimo).padStart(2, '0')}`;
    let vivo = true;
    setPontoLoading(true);
    api.get(`/rh/ponto?${qs}`)
      .then((r) => { if (vivo) setPontoBatidas(Array.isArray(r.data) ? r.data : []); })
      .catch(() => { if (vivo) setPontoBatidas([]); })
      .finally(() => { if (vivo) setPontoLoading(false); });
    return () => { vivo = false; };
  }, [aba, espelhoMes, funcAtivo?.id]);

  const pontoLinhas = useMemo(
    () => gerarLinhasPonto(espelhoMes, pontoBatidas, funcAtivo?.id ?? '', minAlvo),
    [espelhoMes, pontoBatidas, funcAtivo?.id, minAlvo],
  );
  const pontoLinhasFiltradas = useMemo(
    () => (pontoFiltro === 'todos' ? pontoLinhas : pontoLinhas.filter((l) => (pontoFiltro === 'faltas' ? l.status === 'falta' : l.status === 'atraso'))),
    [pontoLinhas, pontoFiltro],
  );
  const pontoTotais = useMemo(() => totaisPonto(pontoLinhas), [pontoLinhas]);
  const pontoTemDadosReais = useMemo(
    () => pontoLinhas.some((l) => l.status !== 'domingo'),
    [pontoLinhas],
  );

  // Desligamentos REAIS vindos de `GET /rh/desligamentos`.
  //
  // Antes isto não existia: a lista vivia só no estado do navegador (sumia ao
  // recarregar) e, quando ficava vazia, a tela FABRICAVA um registro de
  // exemplo — termo com motivo e salário fictícios. Agora os desligamentos
  // são registros reais do banco; se não houver nenhum, a lista fica vazia
  // e a tela mostra o estado vazio honesto.
  useEffect(() => {
    if (loading) return;
    let vivo = true;
    api
      .get<any[]>('/rh/desligamentos')
      .then(({ data }) => {
        if (!vivo) return;
        setDesligamentos((Array.isArray(data) ? data : []).map(normalizarDesligamento));
      })
      .catch(() => {
        if (vivo) setDesligamentos([]);
      });
    return () => {
      vivo = false;
    };
  }, [loading]);

  const funcDoDeslig = (d: Desligamento) => funcs.find((fu: any) => fu.id === d.funcionarioId);
  const termoFunc = useMemo(
    () => (showTermo ? funcs.find((fu: any) => fu.id === showTermo.funcionarioId) : undefined),
    [showTermo, funcs],
  );
  const formFunc = useMemo(() => funcs.find((fu: any) => fu.id === form.funcionarioId), [funcs, form.funcionarioId]);
  const desligFiltrados = useMemo(() => {
    const q = desligBusca.trim().toLowerCase();
    if (!q) return desligamentos;
    return desligamentos.filter((d) => {
      const alvo = funcs.find((fu: any) => fu.id === d.funcionarioId);
      return `${alvo?.nome ?? ''} ${alvo?.cargo?.nome ?? ''} ${d.tipoLabel}`.toLowerCase().includes(q);
    });
  }, [desligamentos, desligBusca, funcs]);

  // ---------------------------------------------------------------------------
  //  Preview das verbas — VEM DO SERVIDOR
  //
  //  Antes o cliente tinha um `calcVerbas` próprio, com percentuais fixos que
  //  não batiam com o que o servidor gravava: para salário R$ 3.000 a tela mostrava
  //  R$ 10.340 e o banco gravava R$ 5.296. Agora `null` significa "ainda não
  //  apurado" e o valor exibido é literalmente o que será gravado e impresso no PDF.
  // ---------------------------------------------------------------------------
  const [preview, setPreview] = useState<{ verbas: any; apuracao?: any } | null>(null);
  const [carregandoPreview, setCarregandoPreview] = useState(false);

  /** Pede as verbas ao servidor sempre que os dados do formulaário mudam. */
  const atualizarPreview = useCallback(async () => {
    if (!form.funcionarioId || !form.data || !form.tipo) {
      setPreview(null);
      return;
    }
    setCarregandoPreview(true);
    try {
      const { data } = await api.post('/rh/desligamentos/preview', {
        funcionarioId: form.funcionarioId,
        data: form.data,
        tipo: form.tipo,
        aviso: form.aviso,
        saldoDias: Number(form.saldoDias) || 0,
      });
      setPreview(data);
    } catch (err: any) {
      // Sem preview a tela mostra "—" em vez de estimar por conta própria:
      // inventar número em verba rescisória é o que não pode acontecer.
      setPreview(null);
      if (err?.message) setError(err.message);
    } finally {
      setCarregandoPreview(false);
    }
  }, [form.funcionarioId, form.data, form.tipo, form.aviso, form.saldoDias]);

  useEffect(() => {
    if (aba === 'desligamento' && showModal) void atualizarPreview();
  }, [aba, showModal, atualizarPreview]);

  // Área de ARQUIVADOS: funcionários que passaram da janela de 30 dias após o
  // desligamento. O cadastro e o histórico são preservados — arquivar não apaga.
  const [arquivados, setArquivados] = useState<any[]>([]);
  const [verArq, setVerArq] = useState(false);
  const [cancelandoId, setCancelandoId] = useState<string | null>(null);
  const [motivoCancel, setMotivoCancel] = useState('');
  const [ocupadoDoc, setOcupadoDoc] = useState<string | null>(null);

  const carregarArquivados = useCallback(async () => {
    try {
      const { data } = await api.get('/rh/funcionarios/arquivados');
      setArquivados(Array.isArray(data) ? data : []);
    } catch {
      setArquivados([]);
    }
  }, []);

  /**
   * Arquiva os desligamentos que já venceram a janela de 30 dias.
   *
   * A rota `POST /rh/funcionarios/arquivar-vencidos` existe e o próprio backend
   * é explícito: "arquivar é uma decisão de retenção, não efeito colateral de
   * passar o tempo". Só que NENHUM botão da tela chamava ela — a área de
   * arquivados ficaria permanentemente vazia, e o gestor não teria como
   * liberar espaço operacional depois do prazo, nem como arquivar um caso
   * específico. A ação é real, grava no PostgreSQL e registra auditoria.
   */
  const arquivarVencidos = useCallback(async () => {
    setOcupadoDoc('arquivar');
    setError(null); setNotice(null);
    try {
      const { data } = await api.post<{ arquivados: number }>(
        '/rh/funcionarios/arquivar-vencidos',
        {},
      );
      const n = Number(data?.arquivados ?? 0);
      setNotice(
        n > 0
          ? `${n} desligamento(s) arquivado(s). O cadastro e o histórico continuam preservados.`
          : 'Nenhum desligamento passou da janela de 30 dias. Nada foi arquivado.',
      );
      await carregarArquivados();
      await load();
    } catch (err: any) {
      setError(msgErro(err, 'Não foi possível arquivar os desligamentos vencidos.'));
    } finally {
      setOcupadoDoc(null);
    }
  }, [carregarArquivados]);

  useEffect(() => {
    if (verArq) void carregarArquivados();
  }, [verArq, carregarArquivados]);

  /**
   * Baixa o dossê completo (cadastro + advertências + suspensões + rescisão).
   *
   * Só é possível dentro da janela de 30 dias do desligamento; depois disso o
   * servidor recusa com 409 e o registro vai para ARQUIVADO.
   */
  const baixarDossie = useCallback(
    async (funcionarioId: string, nome: string) => {
      setError(null);
      try {
        // `post: true` porque a rota é POST: o dossiê é gerado sob demanda e o
        // servidor grava `dossieGeradoEm` na rescisão.
        const { blob, nome: nomeArq } = await api.download(`/rh/funcionarios/${funcionarioId}/dossie`, { post: true });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = nomeArq || `Dossie-${nome}.pdf`;
        a.click();
        URL.revokeObjectURL(url);
        setNotice(traduzir('dossie_gerado', 'Dossiê completo gerado e baixado.'));
      } catch (err: any) {
        setError(msgErro(err, traduzir('dossie_erro', 'Não foi possível gerar o dossiê.')));
      }
    },
    [],
  );

  /** Cancela o desligamento e reativa o funcionário (o registro não é apagado). */
  const confirmarCancelamento = useCallback(async () => {
    if (!cancelandoId) return;
    if (motivoCancel.trim().length < 5) {
      setError(traduzir('motivo_curto_cancel', 'Informe o motivo do cancelamento (mínimo 5 caracteres).'));
      return;
    }
    try {
      await api.post(`/rh/desligamentos/${cancelandoId}/cancelar`, { motivo: motivoCancel.trim() });
      setNotice(traduzir('desligamento_cancelado', 'Desligamento cancelado. O funcionário voltou a ATIVO e o histórico foi preservado.'));
      setCancelandoId(null);
      setMotivoCancel('');
      await load();
      void recarregarFuncionarios();
    } catch (err: any) {
      setError(msgErro(err, traduzir('falha_cancelar_desligamento', 'Não foi possível cancelar o desligamento.')));
    }
  }, [cancelandoId, motivoCancel]);

  // ==========================================================================
  //  Folha de Pagamento
  //
  //  A tela NÃO calcula nada. Não existe fórmula de INSS, IRRF, 13º ou saldo de
  //  horas neste arquivo: tudo vem de `POST /rh/folhas/:id/processar` e
  //  `GET /rh/folhas/:id`, que persistiram no Postgres o que o servidor apurou.
  //  É o que garante que o card, o KPI, o recibo em PDF e o banco mostrem o mesmo
  //  número — e que a taxa do INSS atualizada por lei não dependa de mudança aqui.
  // ==========================================================================
  const [competencia, setCompetencia] = useState(() => new Date().toISOString().slice(0, 7));
  const [folhas, setFolhas] = useState<any[]>([]);
  const [folhaAtual, setFolhaAtual] = useState<any>(null);
  const [carregandoFolha, setCarregandoFolha] = useState(false);
  const [processandoFolha, setProcessandoFolha] = useState(false);
  const [folhaBusca, setFolhaBusca] = useState('');
  const [folhaStatus, setFolhaStatus] = useState('');
  const [folhaDept, setFolhaDept] = useState('');
  const [expandidoFolha, setExpandidoFolha] = useState<string | null>(null);
  const [modalLancamento, setModalLancamento] = useState<string | null>(null);
  const [modalFechamento, setModalFechamento] = useState(false);
  const [modalDecimo, setModalDecimo] = useState(false);
  const [anoDecimo, setAnoDecimo] = useState(() => new Date().getFullYear());
  const [decimos, setDecimos] = useState<any[]>([]);
  const [ocupadoFolha, setOcupadoFolha] = useState(false);
  /** Form do modal de lançamento. Reinicia ao abrir para não vazar valor antigo. */
  const [formLanc, setFormLanc] = useState({ codigo: '', descricao: '', tipo: 'PROVENTO' as 'PROVENTO' | 'DESCONTO', valor: '' });

  const carregarFolhas = useCallback(async () => {
    try {
      const { data } = await api.get('/rh/folhas');
      setFolhas(Array.isArray(data) ? data : []);
    } catch (err: any) {
      setError(msgErro(err, traduzir('falha_folhas', 'Não foi possível carregar as folhas.')));
    }
  }, []);

  /** Abre a folha da competência (cria se ainda não existir) e traz o detalhe. */
  const abrirFolha = useCallback(async (comp: string) => {
    if (!comp) return;
    setCompetencia(comp);
    setCarregandoFolha(true);
    try {
      const { data: criada } = await api.post('/rh/folhas', { competencia: comp });
      const { data: detalhe } = await api.get(`/rh/folhas/${criada.id}`);
      setFolhaAtual(detalhe);
    } catch (err: any) {
      setError(msgErro(err, traduzir('falha_abrir_folha', 'Não foi possível abrir a folha.')));
      setFolhaAtual(null);
    } finally {
      setCarregandoFolha(false);
    }
  }, []);

  const processarFolha = useCallback(async () => {
    if (!folhaAtual?.folha?.id) return;
    setProcessandoFolha(true);
    setError(null);
    try {
      await api.post(`/rh/folhas/${folhaAtual.folha.id}/processar`, {});
      const { data } = await api.get(`/rh/folhas/${folhaAtual.folha.id}`);
      setFolhaAtual(data);
      await carregarFolhas();
      setNotice(traduzir('folha_processada', 'Folha processada com os valores apurados no servidor.'));
    } catch (err: any) {
      setError(msgErro(err, traduzir('falha_processar_folha', 'Não foi possível processar a folha.')));
    } finally {
      setProcessandoFolha(false);
    }
  }, [folhaAtual, carregarFolhas]);

  /** Fecha a folha. Antes mostra o resumo real — nunca um número presumido. */
  const fecharFolha = useCallback(async () => {
    if (!folhaAtual?.folha?.id) return;
    setOcupadoFolha(true);
    try {
      await api.post(`/rh/folhas/${folhaAtual.folha.id}/fechar`, {});
      const { data } = await api.get(`/rh/folhas/${folhaAtual.folha.id}`);
      setFolhaAtual(data);
      await carregarFolhas();
      setModalFechamento(false);
      setNotice(traduzir('folha_fechada', 'Folha fechada. Lançamentos e pagamentos bloqueados.'));
    } catch (err: any) {
      setError(msgErro(err, traduzir('falha_fechar_folha', 'Não foi possível fechar a folha.')));
    } finally {
      setOcupadoFolha(false);
    }
  }, [folhaAtual, carregarFolhas]);

  const reabrirFolha = useCallback(async () => {
    if (!folhaAtual?.folha?.id) return;
    setOcupadoFolha(true);
    try {
      await api.post(`/rh/folhas/${folhaAtual.folha.id}/reabrir`, {
        motivo: 'Reabertura solicitada pelo RH para correção de lançamento.',
      });
      const { data } = await api.get(`/rh/folhas/${folhaAtual.folha.id}`);
      setFolhaAtual(data);
      setNotice(traduzir('folha_reaberta', 'Folha reaberta. A reabertura ficou registrada na auditoria.'));
    } catch (err: any) {
      setError(msgErro(err, traduzir('falha_reabrir_folha', 'Não foi possível reabrir a folha.')));
    } finally {
      setOcupadoFolha(false);
    }
  }, [folhaAtual]);

  /** Lança provento/desconto. O valor recalculado vem do servidor — a tela só exibe. */
  const lancarEmFolha = useCallback(async (funcionarioId: string, dados: any) => {
    if (!folhaAtual?.folha?.id) return;
    try {
      await api.post(`/rh/folhas/${folhaAtual.folha.id}/lancamentos`, { funcionarioId, ...dados });
      const { data } = await api.get(`/rh/folhas/${folhaAtual.folha.id}`);
      setFolhaAtual(data);
      await carregarFolhas();
      setModalLancamento(null);
      setNotice(traduzir('lancamento_registrado', 'Lançamento registrado e folha recalculada no servidor.'));
    } catch (err: any) {
      setError(msgErro(err, traduzir('falha_lancar', 'Não foi possível registrar o lançamento.')));
    }
  }, [folhaAtual, carregarFolhas]);

  /** Marca o pagamento. Data de pagamento vazia é preenchida pelo servidor. */
  const registrarPagamento = useCallback(async (funcionarioId: string, dados: any) => {
    if (!folhaAtual?.folha?.id) return;
    try {
      await api.put(`/rh/folhas/${folhaAtual.folha.id}/pagamentos/${funcionarioId}`, dados);
      const { data } = await api.get(`/rh/folhas/${folhaAtual.folha.id}`);
      setFolhaAtual(data);
      setNotice(traduzir('pagamento_registrado', 'Pagamento registrado.'));
    } catch (err: any) {
      setError(msgErro(err, traduzir('falha_pagamento', 'Não foi possível registrar o pagamento.')));
    }
  }, [folhaAtual]);

  const carregarDecimos = useCallback(async (ano: number) => {
    try {
      const { data } = await api.get(`/rh/decimo-terceiro?ano=${ano}`);
      setDecimos(Array.isArray(data) ? data : []);
    } catch {
      setDecimos([]);
    }
  }, []);

  const gerarDecimo = useCallback(async () => {
    setOcupadoFolha(true);
    try {
      const { data } = await api.post('/rh/decimo-terceiro/gerar', { ano: anoDecimo });
      await carregarDecimos(anoDecimo);
      setModalDecimo(false);
      setNotice(traduzir('decimo_gerado', `13º de ${anoDecimo} gerado para ${data.gerados} funcionário(s).`));
    } catch (err: any) {
