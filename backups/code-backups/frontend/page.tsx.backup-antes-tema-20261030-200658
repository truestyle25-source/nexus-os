  /**
   * Carrega os anexos já gravados de um funcionário.
   *
   * Serve para reabrir um desligamento já salvo: o modal mostra o que existe de
   * fato no bucket, e não um array de nomes que veio do banco.
   */
  async function carregarDocs(funcionarioId: string) {
    if (!funcionarioId) { setDocsSalvos([]); return; }
    try {
      setDocsSalvos(await listarDocumentos({ funcionarioId }));
    } catch {
      setDocsSalvos([]);
    }
  }

  async function baixarDoc(doc: Documento) {
