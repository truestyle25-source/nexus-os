      valorValeAlimentacao: f.valeAlimentacao ? Number(f.valorValeAlimentacao || 0) : 0,
      valorValeRefeicao: f.valeRefeicao ? Number(f.valorValeRefeicao || 0) : 0,
    };
    try {
      if (editId) {
