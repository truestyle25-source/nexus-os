                        <div className="rounded-[10px] bg-[#15151F] border border-[#2A2A3A] p-2.5">
                          <div className="text-zinc-500">{traduzir('saldo_salario', 'Saldo salário')}</div>
                          <div className="font-semibold text-white mono mt-1">{brl(preview.verbas.saldoSalario)}</div>
                        </div>
                        <div className="rounded-[10px] bg-[#15151F] border border-[#2A2A3A] p-2.5">
                          <div className="text-zinc-500">13º proporcional</div>
                          <div className="font-semibold text-white mono mt-1">{brl(preview.verbas.decimoTerceiro)}</div>
                        </div>
                        <div className="rounded-[10px] bg-[#15151F] border border-[#2A2A3A] p-2.5">
                          <div className="text-zinc-500">{traduzir('ferias_um_terco', 'Férias + 1/3')}</div>
                          <div className="font-semibold text-white mono mt-1">
                            {brl(preview.verbas.feriasVencidas + preview.verbas.feriasProporcionais + preview.verbas.tercoConstitucional)}
                          </div>
                        </div>
                        <div className="rounded-[10px] bg-[#15151F] border border-[#2A2A3A] p-2.5">
                          <div className="text-zinc-500">{traduzir('aviso_previo', 'Aviso prévio')}</div>
                          <div className="font-semibold text-white mono mt-1">{brl(preview.verbas.avisoPrevio)}</div>
                        </div>
                        {/*
                          FGTS e multa ficam SEM valor, e não estimados por 8%/40%.
                          Não existe tabela de depósitos de FGTS no banco, então
                          qualquer percentual aqui seria número inventado em
                          documento rescisório. O total abaixo também não os inclui.
                        */}
                        <div className="rounded-[10px] bg-[#15151F] border border-[#2A2A3A] p-2.5">
                          <div className="text-zinc-500">{traduzir('fgts_multa', 'Multa FGTS 40%')}</div>
                          <div className="font-semibold text-zinc-500 mono mt-1">
                            {traduzir('nao_apurado', 'não apurado')}
                          </div>
                        </div>
                        <div className="rounded-[10px] bg-violet-500/10 border border-violet-500/20 p-2.5">
                          <div className="text-violet-300">{traduzir('total_estimado', 'TOTAL ESTIMADO')}</div>
                          <div className="font-bold text-violet-200 mono mt-1 text-[13px]">{brl(preview.verbas.total)}</div>
                        </div>
                      </div>
                      <p className="text-[11px] text-zinc-500 mt-3 leading-relaxed">
                        {traduzir(
                          'fgts_nao_apurado',
                          'Calculado pelo servidor a partir do salário e das datas do cadastro. FGTS e multa rescisória não são apurados: dependem do saldo depositado, que deve ser conferido no extrato da conta vinculada.',
                        )}
                      </p>
                    </>
                  )}
                </div>

                <div className="sm:col-span-2 space-y-2">
                  <span className="text-[11px] font-bold tracking-wide text-zinc-400 flex items-center gap-1.5">
                    <UploadCloud size={12} /> {traduzir('documentos_dossie', 'DOCUMENTOS • DOSSIÊ')}
                  </span>
                  {/*
                    O input fica OCULTO e é acionado por botão/clique na zona.
                    Um `<input type="file">` visível quebraria o layout e, pior,
                    exibiria o caminho completo do Windows no campo — o
                    valor precisa ser zerado a cada escolha, senão reescolher o
                    MESMO arquivo não dispara `change` e o usuário conclui que
                    o clique não fez nada.
                  */}
                  <input
                    id="input-arquivos-dossie"
                    type="file"
                    multiple
                    className="hidden"
                    accept=".pdf,.png,.jpg,.jpeg,.webp,.gif,.doc,.docx,.xls,.xlsx,.csv,.txt,.odt"
                    onChange={(e) => {
                      adicionarArquivos(e.target.files);
                      e.target.value = '';
                    }}
                  />

                  <div
                    role="button"
                    tabIndex={0}
                    onClick={() => { if (storageOk !== false) abrirSeletor(); }}
                    onKeyDown={(e) => {
                      if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        if (storageOk !== false) abrirSeletor();
                      }
                    }}
                    onDragOver={(e) => { e.preventDefault(); setArrastando(true); }}
                    onDragLeave={() => setArrastando(false)}
                    onDrop={(e) => {
                      e.preventDefault();
                      setArrastando(false);
                      if (storageOk === false) return;
                      // `dataTransfer.files` é o que faz o texto "arraste
                      // arquivos" deixar de ser decorativo.
                      adicionarArquivos(e.dataTransfer.files);
                    }}
                    className={`rounded-[14px] border border-dashed bg-[#11111A] p-4 flex flex-col sm:flex-row items-center gap-3 cursor-pointer transition ${
                      arrastando
                        ? 'border-violet-500/60 bg-violet-500/[0.06]'
                        : storageOk === false
                          ? 'border-[#2A2A3A] opacity-60 cursor-not-allowed'
                          : 'border-[#2A2A3A] hover:border-violet-500/40'
                    }`}
                  >
                    <div className="w-10 h-10 rounded-xl bg-[#1C1C2A] border border-[#2A2A3A] flex items-center justify-center text-zinc-500 shrink-0">
                      <UploadCloud size={18} className={enviando ? 'animate-pulse' : ''} />
                    </div>
                    <div className="flex-1 text-center sm:text-left">
                      <div className="text-[12px] font-medium text-zinc-300">
                        {arrastando
                          ? traduzir('solte_os_arquivos', 'Solte os arquivos aqui')
                          : traduzir('arraste_arquivos', 'Arraste arquivos ou clique para anexar')}
                      </div>
                      <div className="text-[11px] text-zinc-500">
                        {traduzir('formatos_dossie', `PDF, imagens, ponto, advertências • máx ${TAMANHO_MAXIMO_BYTES / 1024 / 1024}MB cada`)}
                      </div>
                    </div>
                    <div className="flex gap-2">
                      <button
                        type="button"
                        disabled={storageOk === false}
                        onClick={(e) => { e.stopPropagation(); abrirSeletor(); }}
                        className="px-4 py-2 rounded-full bg-white text-black text-[12px] font-semibold hover:bg-zinc-100 transition disabled:opacity-40 disabled:cursor-not-allowed"
                      >
                        {traduzir('adicionar', 'Adicionar')}
                      </button>
                    </div>
                  </div>

                  {/* Falha de configuração do bucket dita AQUI, e não como toast:
                      sem storage o upload é impossível, e o operador precisa do
                      caminho do .env para resolver. */}
                  {storageOk === false && (
                    <div className="rounded-[12px] bg-amber-500/10 border border-amber-500/20 px-4 py-3 flex gap-2.5">
                      <AlertTriangle size={14} className="text-amber-300 shrink-0 mt-0.5" />
                      <div className="text-[11px] leading-relaxed text-amber-200/80">
                        {storageMsg || traduzir('sem_storage', 'Armazenamento não configurado no servidor. Defina STORAGE_PROVIDER e STORAGE_BUCKET no .env do backend.')}
                      </div>
                    </div>
                  )}
                  {/*
                    Arquivos ESCOLHIDOS, ainda não enviados. Ficam aqui até o
                    desligamento ser gravado, porque o upload real só pode
                    acontecer depois que o registro existir — `entidadeId` é a
                    chave primária dele.
                  */}
                  {arquivos.length > 0 && (
                    <div className="space-y-1.5">
                      {arquivos.map((f, i) => (
                        <div key={`${f.name}-${f.size}-${i}`} className="flex items-center gap-2.5 rounded-[12px] bg-[#15151F] border border-[#2A2A3A] px-3 py-2">
                          <FileText size={13} className="text-zinc-500 shrink-0" />
                          <span className="text-[12px] text-zinc-300 truncate flex-1">{f.name}</span>
                          <span className="text-[10px] text-zinc-500 mono shrink-0">{tamanhoLegivel(f.size)}</span>
                          <button
                            type="button"
                            onClick={() => removerArquivo(i)}
                            className="text-zinc-500 hover:text-white shrink-0"
                            aria-label={traduzir('remover', 'Remover')}
                          >
                            <X size={12} />
                          </button>
                        </div>
                      ))}
                      <p className="text-[10px] text-zinc-500 leading-relaxed">
                        {traduzir('anexos_ao_salvar', 'Os arquivos sobem para o bucket quando você salva o desligamento.')}
                      </p>
                    </div>
                  )}

                  {/*
                    Documentos JÁ gravados no bucket (reabrir um desligamento
                    existente). Antes esta lista era `form.docs`, que vinha do
                    banco como array de NOMES — podia exibir um documento cujo
                    arquivo não existia. Aqui a lista vem de `Documento`, que só
                    tem registro depois que o objeto subiu.
                  */}
                  {docsSalvos.length > 0 && (
                    <div className="space-y-1.5">
                      <div className="text-[10px] font-bold tracking-[0.14em] uppercase text-zinc-500">
                        {traduzir('no_bucket', 'NO BUCKET')}
                      </div>
                      {docsSalvos.map((d) => (
                        <div key={d.id} className="flex items-center gap-2.5 rounded-[12px] bg-emerald-500/[0.06] border border-emerald-500/20 px-3 py-2">
                          <FileText size={13} className="text-emerald-400/70 shrink-0" />
                          <span className="text-[12px] text-zinc-300 truncate flex-1">{d.nomeOriginal}</span>
                          <span className="text-[10px] text-zinc-500 mono shrink-0">{tamanhoLegivel(d.tamanho)}</span>
                          <button
                            type="button"
                            onClick={() => baixarDoc(d)}
                            className="text-zinc-500 hover:text-emerald-400 shrink-0"
                            aria-label={traduzir('baixar', 'Baixar')}
                            title={traduzir('baixar', 'Baixar')}
                          >
                            <Download size={12} />
                          </button>
                          <button
                            type="button"
                            onClick={() => apagarDoc(d)}
                            className="text-zinc-500 hover:text-red-400 shrink-0"
                            aria-label={traduzir('excluir', 'Excluir')}
                            title={traduzir('excluir', 'Excluir')}
                          >
                            <Trash2 size={12} />
                          </button>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <label className="space-y-2 sm:col-span-2">
                  <span className="text-[11px] font-bold tracking-wide text-zinc-400">
                    {traduzir('observacoes_testemunhas', 'OBSERVAÇÕES • TESTEMUNHAS')}
                  </span>
                  <textarea
                    rows={2}
                    placeholder={traduzir('observacoes_placeholder', 'Detalhes, testemunhas, coordenador...')}
                    className="w-full rounded-[14px] bg-[#1C1C2A] border border-[#2A2A3A] p-3 text-[13px] text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-violet-500/50 resize-none"
                    value={form.obs}
                    onChange={(e) => setForm((p) => ({ ...p, obs: e.target.value }))}
                  />
                </label>

                <label className="space-y-2">
                  <span className="text-[11px] font-bold tracking-wide text-zinc-400">STATUS</span>
                  <select
                    className="w-full h-[44px] rounded-[14px] bg-[var(--nx-surface-2)] border border-[var(--nx-border)] px-3 text-[13px] text-zinc-100 focus:outline-none focus:border-violet-500/50 appearance-none"
                    value={form.status}
                    onChange={(e) => setForm((p) => ({ ...p, status: e.target.value as DesligStatus }))}
                  >
                    <option value="PENDENTE">{traduzir('pendente', 'Pendente')}</option>
                    <option value="ASSINADO">{traduzir('assinado', 'Assinado')}</option>
                    <option value="HOMOLOGADO">{traduzir('homologado', 'Homologado')}</option>
                  </select>
                </label>

                <div className="rounded-[12px] bg-amber-500/10 border border-amber-500/20 px-4 py-3 flex gap-2.5">
                  <AlertTriangle size={14} className="text-amber-300 shrink-0 mt-0.5" />
                  <div className="text-[11px] leading-relaxed text-amber-200/80">
                    {traduzir('alerta_art482', 'Valide advertências e suspensões anteriores. Art. 482 exige prova e imediatidade.')}
                  </div>
                </div>
              </div>
            </div>

            <div className="sticky bottom-0 bg-[var(--nx-surface)] border-t border-[var(--nx-border)] px-7 py-4 flex gap-3 justify-end shrink-0">
              <button
                type="button"
                onClick={() => setShowModal(false)}
                className="h-[42px] px-5 rounded-full bg-[var(--nx-surface-2)] border border-[var(--nx-border)] text-[13px] font-medium hover:bg-white/[0.08] transition"
              >
                {traduzir('cancelar', 'Cancelar')}
              </button>
              <button
                type="button"
                onClick={handleSaveDeslig}
                disabled={!form.funcionarioId || salvandoDeslig}
                className="h-[42px] px-6 rounded-full bg-[var(--nx-accent)] text-white text-[13px] font-semibold shadow-[0_0_24px_rgba(var(--nx-accent-rgb)/0.45)] hover:bg-[var(--nx-accent-2)] transition flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:shadow-none"
              >
                <CheckCircle2 size={14} /> {traduzir('salvar_desligamento', 'Salvar Desligamento')}
              </button>
            </div>
          </div>
        </div>
      )}

      </div>
    </main>
  );
}

