const CORES_AVATAR = ['violet', 'fuchsia', 'amber', 'emerald', 'blue'] as const;

/**
 * Gradiente estável do avatar a partir do nome.
 *
 * Deriva do próprio nome (e não de um índice fixo na lista) para que o mesmo
 * funcionário tenha sempre a mesma cor, independentemente de quantos existem.
 */
/** Mesma paleta do avatar, mas no formato de gradiente Tailwind. */
function gradienteAvatar(id?: string): string {
  const mapa: Record<string, string> = {
    violet: 'from-violet-500 to-indigo-600',
    fuchsia: 'from-fuchsia-500 to-pink-500',
    amber: 'from-amber-500 to-orange-500',
    emerald: 'from-emerald-400 to-teal-500',
    blue: 'from-blue-500 to-cyan-500',
  };
  return mapa[id ? avatarCor(id) : 'violet'];
}

function avatarCor(nome?: string): string {
  if (!nome) return 'violet';
  let h = 0;
  for (let i = 0; i < nome.length; i++) h = (h * 31 + nome.charCodeAt(i)) >>> 0;
  return CORES_AVATAR[h % CORES_AVATAR.length];
}

