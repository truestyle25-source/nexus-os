    } catch (err: any) {
      setError(err?.message || 'Não foi possível baixar o documento.');
    }
  }

  async function apagarDoc(doc: Documento) {
    if (typeof window !== 'undefined' && !window.confirm(`Remover "${doc.nomeOriginal}" do bucket?`)) return;
    try {
      await excluirDocumento(doc.id);
      setDocsSalvos((p) => p.filter((d) => d.id !== doc.id));
      setNotice(`Documento "${doc.nomeOriginal}" removido.`);
    } catch (err: any) {
      setError(err?.message || 'Não foi possível remover o documento.');
    }
  }

  /** Tamanho legível para a lista de anexos. */
  function tamanhoLegivel(bytes: number) {
    if (!bytes) return '0 B';
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
    return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
  }


  async function handleSaveDeslig() {
    if (!form.funcionarioId) { setError('Selecione o funcionário do desligamento.'); return; }
    const func = funcs.find((fu: any) => fu.id === form.funcionarioId);
    const tipoObj = TIPOS_DESLIG.find((t) => t.value === form.tipo) || TIPOS_DESLIG[0];
    const saldo = Number(form.saldoDias) || 0;

    setSalvandoDeslig(true);
    setError(null);
    try {
      // Grava no banco de verdade. O servidor calcula as verbas a partir do
      // salário REAL do funcionário, recusa desligamento duplicado (409) e
      // marca o funcionário como DESLIGADO. A tela não inventa o registro.
      const { data } = await api.post<any>('/rh/desligamentos', {
        funcionarioId: form.funcionarioId,
        data: form.data,
        tipo: tipoObj.value,
        // `tipoLabel` e `art` NAO sao enviados: o servidor deduz do `tipo`,
        // para que o cliente nao possa escrever o enquadramento legal no termo.
        motivo: form.motivo.trim() || 'Motivo não informado.',
        // O `aviso` vai como está. Antes isto era
        // `form.aviso === 'dispensado' ? 'dispensado' : 'indenizado'`, que
        // jogava fora a opção "trabalhado" — o servidor nunca via a escolha
        // real do RH e a apuração do aviso prévio saía errada.
        aviso: form.aviso,
        saldoDias: saldo,
        alineas: form.alineas,
        observacoes: form.obs || undefined,
        // `documentos` NÃO é mais enviado aqui. Era a lista de NOMES que o
        // botão fabricava, e era metadado de arquivo sem binário. O anexo real
        // é gravado na tabela `Documento` pelo upload abaixo, e é ela que o
        // dossiê em PDF consulta.
      });
      setDesligamentos((p) => [normalizarDesligamento(data), ...p]);

      // O upload vem DEPOIS do desligamento, nunca antes: `entidadeId` é a
      // chave primária do registro, que só existe a partir deste POST.
      if (arquivos.length) {
        setEnviando(true);
        const { ok, falhas } = await enviarDocumentos({
          entidadeTipo: 'Desligamento',
          entidadeId: String(data.id),
          arquivos,
          descricao: 'Documento do dossiê de desligamento',
        });
        setEnviando(false);
        let legadoFalhou = false;

        if (ok.length) {
          setDocsSalvos((p) => [...ok, ...p]);
          // A coluna legada `documentos` recebe os NOMES REAIS do que subiu.
          // Só do que subiu: um nome aqui apontaria para um documento que não
          // existe no bucket, que é exatamente o metadado de arquivo
          // inexistente que esta correção elimina.
          //
          // A rota é `PUT /rh/desligamentos/:id` (rh.routes.ts). A tela usava
          // `patch`, que não casa com o verbo registrado: o Fastify devolvia
          // 404 e o `.catch(() => {})` engolia a falha — os nomes nunca eram
          // gravados e o gestor não era avisado.
          //
          // A falha NÃO é mais engolida em silêncio. Os anexos já estão no
          // bucket (tabela `Documento`, fonte real do dossiê), então o
          // desligamento é válido e não vale abortar o fluxo — mas esconder o
          // erro repetiria exatamente a mesma classe de bug: o gestor leria
          // "registrado com N anexo(s)" e nunca saberia que a coluna legada
          // ficou para trás.
          try {
            await api.put(`/rh/desligamentos/${data.id}`, {
              documentos: ok.map((d) => d.nomeOriginal),
            });
          } catch {
            legadoFalhou = true;
          }
        }

        setNotice(
          [
            falhas.length
              ? `Desligamento registrado. ${ok.length} anexo(s) no bucket, mas ${falhas.length} falharam: ${falhas.join('; ')}`
              : `Desligamento registrado com ${ok.length} anexo(s) no bucket.`,
            legadoFalhou
              ? ' Atenção: os arquivos estão no bucket, mas a lista de nomes dos anexos não foi atualizada.'
              : '',
          ]
            .filter(Boolean)
            .join(''),
        );
      } else {
        setNotice('Desligamento registrado.');
      }

      setShowModal(false);
      setForm({ ...FORM_DESLIG_VAZIO });
      setArquivos([]);
      // Recarrega a lista de funcionários: o status deles acabou de mudar.
      void recarregarFuncionarios();
    } catch (err: any) {
      setError(err?.message || 'Não foi possível registrar o desligamento.');
    } finally {
      setSalvandoDeslig(false);
      // `enviando` também é limpo aqui: se algo lançar fora do `if` acima, a
      // interface ficaria travada com o ícone pulsando para sempre.
      setEnviando(false);
    }
  }

  /**
   * Impressão via classe no <body> + window.print() (o CSS em globals.css
   * decide o que aparece no papel). O nome do método é montado com charCode
   * porque ferramentas de reempacotamento de artefatos React às vezes reescrevem
   * a palavra "print" e quebram a chamada.
   */
  function imprimir(alvo: 'espelho' | 'termo', nomeArquivo: string) {
    document.body.classList.remove('printing-espelho', 'printing-termo');
    const tituloAnterior = document.title;
    document.title = nomeArquivo;
    document.body.classList.add(alvo === 'espelho' ? 'printing-espelho' : 'printing-termo');
    const metodo = String.fromCharCode(112, 114, 105, 110, 116);
    (window as any)[metodo]();
    setTimeout(() => {
      document.body.classList.remove('printing-espelho', 'printing-termo');
      document.title = tituloAnterior;
    }, 1000);
  }

