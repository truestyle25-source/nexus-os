      dataNascimento: fun.dataNascimento ? String(fun.dataNascimento).slice(0, 10) : '',
      dataAdmissao: fun.dataAdmissao ? String(fun.dataAdmissao).slice(0, 10) : '',
      departamentoId: fun.departamentoId ?? '', cargoId: fun.cargoId ?? '', usuarioId: fun.usuarioId ?? '',
      // Abre o formulário com o TEXTO que já está salvo, não o id: o campo é
