{
  "name": "nexus-os-backend",
  "version": "0.1.0",
  "description": "NEXUS OS - Backend (Fase 1: Fundação)",
  "type": "module",
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "@prisma/client": "5.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "prisma": "5.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
