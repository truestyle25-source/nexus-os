# ============================================================
# NEXUS OS — Backend — Variáveis de ambiente (EXEMPLO)
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" real no Git.
# ============================================================

# Porta em que o backend vai rodar
PORT=3333

# String de conexão do PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nexus_os

# Segredo usado para assinar os tokens JWT.
# Gere um valor forte com: openssl rand -hex 32
# NUNCA reutilize o mesmo segredo entre ambientes (dev/prod).
JWT_SECRET=troque_por_um_valor_aleatorio_de_32_ou_mais_caracteres

# Origem permitida para requisições CORS (URL do frontend)
CORS_ORIGIN=http://localhost:3000

# Ambiente de execução: development | production | test
NODE_ENV=development

# ------------------------------------------------------------
# Variáveis das fases futuras (deixe vazio até serem configuradas
# — a Fase 1 não usa nenhuma delas):
# ------------------------------------------------------------

