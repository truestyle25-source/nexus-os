NODE_ENV="development"
PORT="3333"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexus_os?schema=public"
JWT_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
FRONTEND_URLS="http://localhost:3000,https://seu-frontend-em-producao.exemplo"
# IA do NEXUS OS — usa exclusivamente a API oficial do Google Gemini
# (modelo definido em GEMINI_MODEL, consumido por backend/src/modules/ia/ia.routes.ts).
# A chave fica SOMENTE no backend — nunca no frontend (Seção 39).
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Modelo do Gemini usado pela NEXUS AI. Modelos antigos são descontinuados pela
# Google e passam a retornar HTTP 404 (casos reais: gemini-2.0-flash e
# gemini-1.5-flash). Confira os modelos vivos em:
# https://generativelanguage.googleapis.com/v1beta/models?key=SUA_CHAVE
GEMINI_MODEL="gemini-flash-latest"
CONTROLID_URL=""
CONTROLID_USER=""
INFINITEPAY_CHECKOUT_URL="https://pay.infinitepay.io/nexus_os/Ri0x-Bgp7ZEVEIK-19,90"
TRIAL_DAYS="7"
SUBSCRIPTION_PRICE="19.90"
# E-mail transacional (recuperação de senha) — crie uma conta em resend.com,
# gere uma API key e configure o domínio remetente antes de ir para produção.
RESEND_API_KEY=""
EMAIL_FROM="NEXUS OS <onboarding@resend.dev>"
# Snapshot diário de estoque (giro real) — agendador embutido no processo
# do backend (ver src/scripts/scheduler.ts). "true" habilita; se você já
# tem um cron externo chamando POST /estoque/snapshot/gerar ou
# `npm run estoque:snapshot`, deixe "false" para não rodar em duplicidade.
SNAPSHOT_AUTO_ENABLED="true"
SNAPSHOT_HOUR_UTC="3"
# ===========================================================================
# Mercado Livre — OAuth 2.0 (server side). Crie a aplicação em
# https://developers.mercadolivre.com.br/pt_br/gerencie-seu-aplicativo e
# copie Client ID e Client Secret. O Redirect URI cadastrado no app DEVE ser
# exatamente o valor de MERCADOLIVRE_REDIRECT_URI abaixo (é para lá que o
# Mercado Livre devolve o browser com ?code=&state= — rota pública
# GET /integracoes/mercadolivre/callback do backend).
# ===========================================================================
MERCADOLIVRE_CLIENT_ID=""
MERCADOLIVRE_CLIENT_SECRET=""
MERCADOLIVRE_REDIRECT_URI="http://localhost:3333/integracoes/mercadolivre/callback"
# URLs oficiais (padrão do código; descomente só para sandbox/testes):
# MERCADOLIVRE_AUTH_URL="https://auth.mercadolivre.com.br/authorization"
# MERCADOLIVRE_TOKEN_URL="https://api.mercadolibre.com/oauth/token"
# MERCADOLIVRE_USER_URL="https://api.mercadolibre.com/users/me"
# Sincronização automática persistente (padrões: pedidos 5 min, estoque 15 min,
# produtos 360 min). Mantenha ML_SYNC_AUTO diferente de false em produção.
# ML_SYNC_AUTO="true"
# ML_SYNC_PEDIDOS_MIN="5"
# ML_SYNC_ESTOQUE_MIN="15"
# ML_SYNC_PRODUTOS_MIN="360"
# Backup (npm run backup / npm run backup:restaurar) — requer pg_dump e
# pg_restore instalados no ambiente que rodar o script.
BACKUP_DIR="./backups"
BACKUP_RETENCAO_DIAS="30"

# Shopee Open Platform — credenciais globais do app somente no backend.
# Configure no Developer Console o callback correspondente a SHOPEE_REDIRECT_URI.
# Não informe os valores reais em documentação, frontend ou chat.
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
SHOPEE_REDIRECT_URI="http://localhost:3333/integracoes/shopee/callback"
# Região/ambiente podem ser definidos pela configuração aplicável ao app.
# Padrão de produção: https://partner.shopeemobile.com
# SHOPEE_API_BASE_URL="https://partner.shopeemobile.com"
# SHOPEE_AUTH_BASE_URL="https://partner.shopeemobile.com"
SHOPEE_SYNC_AUTO=true

# ===========================================================================
# Armazenamento de documentos (bucket)
#
# Os anexos do RH (ficha de funcionário, advertência, suspensão, dossiê) vão
# para um bucket PRIVADO. Sem estas variáveis, `GET /rh/documentos/storage`
# responde `configurado: false` e a interface desabilita o upload com a
# mensagem certa — o sistema nunca finge que gravou o arquivo.
#
# Escolha UM provedor. A chave da SERVICE ROLE do Supabase e a
# AWS_SECRET_ACCESS_KEY ficam SOMENTE no backend — nunca no frontend.
# ===========================================================================

# --- Opção 1: AWS S3 ---
# STORAGE_PROVIDER="s3"
# STORAGE_BUCKET="nexus-documentos"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# Para S3-compatible (MinIO, Cloudflare R2, DigitalOcean Spaces), defina também
# o endpoint SEM o esquema:
# AWS_S3_ENDPOINT="https://SEU-ENDPOINT"

# --- Opção 2: Supabase Storage ---
# STORAGE_PROVIDER="supabase"
# STORAGE_BUCKET="documentos"
# SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
#
# No painel do Supabase, crie o bucket como PRIVADO (padrão). Se ele for
# público, qualquer pessoa com a URL do objeto lê o documento.

# Limite por arquivo, em MB. O padrão é 10.
# STORAGE_MAX_UPLOAD_MB="10"
