  quantidade    Decimal  @db.Decimal(14, 3)
  custoUnitario Decimal  @db.Decimal(14, 6)
  valorTotal    Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  @@unique([filialId, produtoId, data])
  @@index([empresaId, data])
}

model EstoqueMovimentacao {
  id              String         @id @default(cuid())
  empresaId       String
  produtoId       String
  produto         Produto        @relation(fields: [produtoId], references: [id])
  // Filial onde o efeito de estoque desta linha ocorre. Para TRANSFERENCIA,
  // esta +ÃƒÂ¯Ã‚Â¿Ã‚Â½ a filial de ORIGEM (a quantidade sai daqui); filialDestinoId
  // aponta a filial que recebe ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ uma segunda linha (tipo TRANSFERENCIA,
  // quantidade positiva) +ÃƒÂ¯Ã‚Â¿Ã‚Â½ criada na filial de destino, ligada pelo mesmo
  // valor de `documento` (ver estoque.service.ts).
  filialId        String
  filial          Filial         @relation("MovOrigem", fields: [filialId], references: [id])
  filialDestinoId String?
  filialDestino   Filial?        @relation("MovDestino", fields: [filialDestinoId], references: [id])
  usuarioId       String?
  usuario         Usuario?       @relation(fields: [usuarioId], references: [id])
  quantidade      Decimal @db.Decimal(14, 3) // positivo entrada, negativo saida - mas tipo define
  tipo            TipoMovEstoque
  motivo          String?
  documento       String? // NF, pedido, venda id; para TRANSFERENCIA, agrupa as duas pontas
  origem          Origem
  createdAt       DateTime       @default(now())

  @@index([empresaId, produtoId])
  @@index([empresaId, filialId])
  @@index([createdAt])
}

// --- Se+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o 11 Fornecedores ---
model Fornecedor {
  // v2 (aba /fornecedores ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â artefato "nexus-fornecedores-add-v2"):
  // - status virou TEXT: o design system exige Ativo/CrÃƒÆ’Ã‚Â­tico/Inativo e o enum
  //   StatusGeral nÃƒÆ’Ã‚Â£o tem "CrÃƒÆ’Ã‚Â­tico" (migraÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o converte ATIVO/INATIVO/ARQUIVADO).
  // - cnpjCpf renomeado para cnpj (campo do formulÃƒÆ’Ã‚Â¡rio ADD).
  // - relaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o Produto[] renomeada para produtosVinculados para liberar o nome
  //   `produtos` do CSV textual ("Camisa, BonÃƒÆ’Ã‚Â©") exigido pelo modal ADD.
  // - categoria com default "Outros" para o POST legado (tela de Compras)
  //   continuar gravando sem enviar a coluna.
  id                 String             @id @default(cuid())
  empresaId          String
  empresa            Empresa            @relation(fields: [empresaId], references: [id])
  nome               String
  cnpj               String?
  categoria          String             @default("Outros") // Malharia, Jeans, BonÃƒÆ’Ã‚Â©s, AcessÃƒÆ’Ã‚Â³rios, CalÃƒÆ’Ã‚Â§ados, Outros
  status             String             @default("Ativo") // Ativo, CrÃƒÆ’Ã‚Â­tico, Inativo
  contato            String?
  whatsapp           String?
  telefone           String?
  email              String?
  endereco           String?
  produtos           String? // CSV "Camisa, BonÃƒÆ’Ã‚Â©" ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â o que o fornecedor fornece
  condicaoPagamento  String? // ÃƒÆ’Ã¢â€šÂ¬ vista, 30 dias, 30/60, 30/60/90
  observacoes        String?
  totalComprado      Decimal            @default(0) @db.Decimal(12, 2) // soma de CompraFornecedor.valor
  totalPedidos       Int                @default(0)
  ultimoPedidoAt     DateTime?
  origem             Origem             @default(MANUAL)
  produtosVinculados Produto[]
  compras            Compra[]
  comprasFornecedor  CompraFornecedor[]
  fatoresConversao   FatorConversao[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([empresaId])
  @@index([empresaId, status])
  @@index([empresaId, categoria])
}

// ===== Fornecedores ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â pedidos de compra por fornecedor (SeÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o 11 v2) =====
// Uma linha por pedido da aba /fornecedores. `compraId` ÃƒÆ’Ã‚Â© extensÃƒÆ’Ã‚Â£o do modelo
// do artefato: sem o vÃƒÆ’Ã‚Â­nculo com a Compra original nÃƒÆ’Ã‚Â£o seria possÃƒÆ’Ã‚Â­vel
// estornar/atualizar o pedido quando a compra muda de status.
model CompraFornecedor {
  id           String     @id @default(cuid())
  empresaId    String
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  compraId     String?    @unique
  valor        Decimal    @db.Decimal(12, 2)
  status       String // Pendente, Entregue, Atrasado
  dataPedido   DateTime   @default(now())
  dataEntrega  DateTime?

  @@index([empresaId, fornecedorId])
  @@index([empresaId, status])
}

// --- Se+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o 10 Compras ---
// Decis+ÃƒÂ¯Ã‚Â¿Ã‚Â½o arquitetural (Fase 3): a filial de destino +ÃƒÂ¯Ã‚Â¿Ã‚Â½ definida na CRIA+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½O
// da compra, n+ÃƒÂ¯Ã‚Â¿Ã‚Â½o solta no momento do recebimento. Motivo: uma ordem de
// compra real j+ÃƒÂ¯Ã‚Â¿Ã‚Â½ nasce sabendo para onde a mercadoria vai (or+ÃƒÂ¯Ã‚Â¿Ã‚Â½amento,
// centro de custo, planejamento de estoque da filial); aceitar a filial s+ÃƒÂ¯Ã‚Â¿Ã‚Â½
// no recebimento permitiria receber uma compra numa filial diferente da
// planejada sem nenhum registro de que isso +ÃƒÂ¯Ã‚Â¿Ã‚Â½ uma exce+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o. Com
// Compra.filialId fixo, POST /compras/:id/receber deixa de aceitar
// filialId no corpo e usa sempre compra.filialId ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ imposs+ÃƒÂ¯Ã‚Â¿Ã‚Â½vel divergir.
model Compra {
  id              String       @id @default(cuid())
  empresaId       String
  filialId        String
  filial          Filial       @relation(fields: [filialId], references: [id])
  fornecedorId    String
  fornecedor      Fornecedor   @relation(fields: [fornecedorId], references: [id])
  valorTotal      Decimal      @db.Decimal(12, 2)
  status          StatusCompra @default(SOLICITADA)
  condPagamento   String?
  dataCompra      DateTime     @default(now())
  dataRecebimento DateTime?
  origem          Origem       @default(MANUAL)
  itens           CompraItem[]
  createdAt       DateTime     @default(now())

  @@index([empresaId])
  @@index([empresaId, filialId])
}

model CompraItem {
  id              String  @id @default(cuid())
  compraId        String
  compra          Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId       String
  produto         Produto @relation(fields: [produtoId], references: [id])
  quantidade      Decimal @db.Decimal(14, 3) // quantidade na unidade de compra
  unidadeCompra   String? // sÃƒÆ’Ã‚Â­mbolo da unidade de compra no momento (ex: "saco", "cx", "kg")
  fatorAplicado   Decimal? @db.Decimal(14, 6) // fator usado para converter para unidade base
  quantidadeBase  Decimal? @db.Decimal(14, 3) // quantidade convertida para unidade base
  valorUnit       Decimal @db.Decimal(14, 6) // preÃƒÆ’Ã‚Â§o por unidade de compra
}

// --- Se+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o 12 Clientes ---
model Cliente {
