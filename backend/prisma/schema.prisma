generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Origem {
  MANUAL
  IMPORTADO
  API
  AUTOMATICO
  PDV
  PONTO
  INTEGRACAO
  IA
}

enum StatusGeral {
  ATIVO
  INATIVO
  ARQUIVADO
}

enum AcaoAuditoria {
  CRIAR
  EDITAR
  EXCLUIR
  LOGIN
  LOGOUT
  IMPORTAR
  SINCRONIZAR
  ALTERAR_PERMISSAO
  ALTERAR_CONFIG
}

enum TipoMovEstoque {
  ENTRADA
  SAIDA
  AJUSTE
  INVENTARIO
  PERDA
  AVARIA
  TRANSFERENCIA
  DEVOLUCAO
  VENDA
  COMPRA
}

enum StatusCompra {
  SOLICITADA
  PEDIDO
  RECEBIDA
  CANCELADA
}

model Empresa {
  id                String       @id @default(cuid())
  nome              String
  razaoSocial       String?
  cnpj              String?      @unique
  inscricaoEstadual String?
  responsavelCpf    String?
  responsavelRg     String?
  cep               String?
  endereco          String?
  cidade            String?
  estado            String?
  // Fuso IANA da empresa. O registro de ponto usa para decidir a que DIA
  // pertence uma marcaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o: ÃƒÆ’Ã‚Â s 23h30 em SÃƒÆ’Ã‚Â£o Paulo a batida ÃƒÆ’Ã‚Â© do dia 27, e o
  // mesmo instante em UTC seria do dia 28. Ausente => `America/Sao_Paulo`.
  fusoHorario       String?      @default("America/Sao_Paulo")
  status            StatusGeral  @default(ATIVO)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  origem            Origem       @default(MANUAL)
  filiais           Filial[]
  usuarios          Usuario[]
  setores           Setor[]
  produtos          Produto[]
  fornecedores      Fornecedor[]
  clientes          Cliente[]
  assinatura        Assinatura?
  importacoes       Importacao[]
  sincronizacoesML  SincronizacaoTarefa[]
  notificacoesMercadoLivre NotificacaoMercadoLivre[]
  shopeeConexoes     ShopeeConexao[]
  shopeeAutorizacoes ShopeeOAuthState[]
  producoesKit      ProducaoKit[]
  dimensoes         Dimensao[]
  unidades          Unidade[]
  tiposProduto      TipoProduto[]
  fatoresConversao  FatorConversao[]
  consumosInternos  ConsumoInterno[]
  nexusErpRecords NexusErpRecord[]
}

// --- ImportaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o de dados (CSV/API) --------------------------------------------
// A tabela existe desde a migration 202609130001_importacao; o model entrou no
// schema na FASE 1 (correÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o das migrations) para manter paridade total entre
// schema.prisma e a cadeia de migrations (migrate diff vazio).
model Importacao {
  id           String   @id
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipo         String
  status       String
  mapeamento   Json?
  erros        Json?
  qtdTotal     Int      @default(0)
  qtdImportada Int      @default(0)
  qtdErro      Int      @default(0)
  origem       Origem   @default(IMPORTADO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([empresaId, createdAt])
}

model Filial {
  id                   String                  @id @default(cuid())
  empresaId            String
  empresa              Empresa                 @relation(fields: [empresaId], references: [id])
  nome                 String
  cnpj                 String?
  cidade               String?
  estado               String?
  // FASE 1 PDV PRO ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â fuso IANA da filial. Prevalece sobre Empresa.fusoHorario
  // para data operacional do caixa/vendas. Ausente => America/Sao_Paulo.
  // UTC continua sendo o instante absoluto (createdAt); o fuso sÃƒÆ’Ã‚Â³ deriva o DIA operacional.
  fusoHorario          String?                 @default("America/Sao_Paulo")
  status               StatusGeral             @default(ATIVO)
  origem               Origem                  @default(MANUAL)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  setores              Setor[]
  usuarios             Usuario[]
  estoques             Estoque[]
  movimentacoesOrigem  EstoqueMovimentacao[]   @relation("MovOrigem")
  movimentacoesDestino EstoqueMovimentacao[]   @relation("MovDestino")
  compras              Compra[]
  snapshotsEstoque     EstoqueSnapshotDiario[]
  caixas               Caixa[]
  producoesKit          ProducaoKit[]
  consumosInternos      ConsumoInterno[]

  @@index([empresaId])
  sessoesInventario   SessaoInventario[]
}

model Setor {
  id        String      @id @default(cuid())
  empresaId String
  filialId  String?
  empresa   Empresa     @relation(fields: [empresaId], references: [id])
  filial    Filial?     @relation(fields: [filialId], references: [id])
  nome      String
  descricao String?
  status    StatusGeral @default(ATIVO)
  origem    Origem      @default(MANUAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  usuarios  Usuario[]

  @@index([empresaId, filialId])
}

model Usuario {
  id                String                  @id @default(cuid())
  empresaId         String
  filialId          String?
  setorId           String?
  empresa           Empresa                 @relation(fields: [empresaId], references: [id])
  filial            Filial?                 @relation(fields: [filialId], references: [id])
  setor             Setor?                  @relation(fields: [setorId], references: [id])
  nome              String
  email             String                  @unique
  senhaHash         String
  status            StatusGeral             @default(ATIVO)
  origem            Origem                  @default(MANUAL)
  ultimoLogin       DateTime?
  permissoes        Permissao[]
  caixas            Caixa[]
  auditorias        Auditoria[]
  documentosEnviados Documento[]
  folhaFechadaPor   Folha[]
  movimentacoes     EstoqueMovimentacao[]
  tokensRecuperacao TokenRecuperacaoSenha[]
  fichaFuncionario  Funcionario[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([empresaId])
  sessoesInventarioCriou  SessaoInventario[] @relation("SessaoInventarioCriador")
  sessoesInventarioFechou  SessaoInventario[] @relation("SessaoInventarioConclusor")
  contagensInventarioFeitas ContagemInventario[] @relation("ContagemInventarioAutor")
  importacoes       Importacao[]
  shopeeAutorizacoes ShopeeOAuthState[]
  producoesKit      ProducaoKit[]
  consumosInternos       ConsumoInterno[]
  consumosInternosAprovou ConsumoInterno[] @relation("ConsumoInternoAprovador")
}

model Permissao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo    String
  acao      String
  permitido Boolean  @default(false)
  origem    Origem   @default(MANUAL)
  createdAt DateTime @default(now())

  @@unique([usuarioId, modulo, acao])
  @@index([usuarioId])
}

// Se+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o 5 - recupera+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o de senha. Armazena apenas o hash do token; o valor
// bruto +ÃƒÂ¯Ã‚Â¿Ã‚Â½ entregue uma +ÃƒÂ¯Ã‚Â¿Ã‚Â½nica vez ao usu+ÃƒÂ¯Ã‚Â¿Ã‚Â½rio pelo canal de envio (e-mail),
// que ainda n+ÃƒÂ¯Ã‚Â¿Ã‚Â½o est+ÃƒÂ¯Ã‚Â¿Ã‚Â½ integrado nesta base (ver PEND+ÃƒÂ¯Ã‚Â¿Ã‚Â½NCIAS no relat+ÃƒÂ¯Ã‚Â¿Ã‚Â½rio).
model TokenRecuperacaoSenha {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
}

model Auditoria {
  id            String        @id @default(cuid())
  usuarioId     String?
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id])
  empresaId     String?
  acao          AcaoAuditoria
  entidade      String
  entidadeId    String?
  valorAnterior Json?
  valorNovo     Json?
  origem        Origem
  ip            String?
  contexto      String?
  createdAt     DateTime      @default(now())

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([createdAt])
}

// --- PARTE 2: Se+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o 8 Produtos ---
model Categoria {
  id        String    @id @default(cuid())
  empresaId String
  nome      String
  descricao String?
  produtos  Produto[]
  createdAt DateTime  @default(now())

  @@index([empresaId])
}

model Produto {
  id               String                  @id @default(cuid())
  empresaId        String
  empresa          Empresa                 @relation(fields: [empresaId], references: [id])
  categoriaId      String?
  categoria        Categoria?              @relation(fields: [categoriaId], references: [id])
  fornecedorId     String?
  fornecedor       Fornecedor?             @relation(fields: [fornecedorId], references: [id])
  tipoProdutoId    String?
  tipoProduto      TipoProduto?            @relation(fields: [tipoProdutoId], references: [id])
  unidadeBaseId    String?
  unidadeBase      Unidade?                @relation("ProdutoUnidadeBase", fields: [unidadeBaseId], references: [id])
  politicaCusto    PoliticaCusto           @default(MEDIO_PONDERADO)
  nome             String
  marca            String?
  sku              String?
  codigoBarras     String?
  custo            Decimal                 @db.Decimal(14, 6)
  precoVenda       Decimal                 @db.Decimal(10, 2)
  margem           Decimal?                @db.Decimal(5, 2) // calculada: (preco-custo)/preco*100
  unidade          String                  @default("UN") // unidade legado ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â mantida para compatibilidade de leitura antiga
  estoqueMinimo    Decimal                 @default(5) @db.Decimal(14, 3)
  estoqueMaximo    Decimal                 @default(100) @db.Decimal(14, 3)
  pontoPedido      Decimal                 @default(0) @db.Decimal(14, 3)
  peso             String?
  ncm              String?
  precoPromocional Decimal?                @db.Decimal(10, 2)
  promocaoInicio   DateTime?
  promocaoFim      DateTime?
  promocaoLimite   Int?
  validade         DateTime?
  imagem           String?
  descricao        String?
  status           StatusGeral             @default(ATIVO)
  ehKit            Boolean                 @default(false)
  origem           Origem                  @default(MANUAL)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  estoques         Estoque[]
  movimentacoes    EstoqueMovimentacao[]
  snapshotsEstoque EstoqueSnapshotDiario[]
  comprasItens     CompraItem[]
  composicaoComoKit ComposicaoKit[]          @relation("KitProduto")
  composicaoComoIngrediente ComposicaoKit[]  @relation("IngredienteProduto")
  producoesKit      ProducaoKit[]
  consumosInternos  ConsumoInterno[]
  fatoresConversao  FatorConversao[]

  @@unique([empresaId, sku])
  @@unique([empresaId, codigoBarras])
  @@index([empresaId])
  @@index([sku])
  @@index([empresaId, tipoProdutoId])
}

model ComposicaoKit {
  id                  String   @id @default(cuid())
  empresaId           String
  kitProdutoId        String
  ingredienteProdutoId String
  quantidadePorKit    Decimal  @db.Decimal(12, 3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  kitProduto          Produto  @relation("KitProduto", fields: [kitProdutoId], references: [id], onDelete: Cascade)
  ingredienteProduto  Produto  @relation("IngredienteProduto", fields: [ingredienteProdutoId], references: [id], onDelete: Restrict)

  @@unique([kitProdutoId, ingredienteProdutoId])
  @@index([empresaId, kitProdutoId])
  @@index([empresaId, ingredienteProdutoId])
}

model ProducaoKit {
  id                 String   @id @default(cuid())
  empresaId          String
  filialId           String
  produtoKitId       String
  usuarioId          String?
  quantidade         Decimal  @db.Decimal(14, 3) // quantidade produzida (na unidade de produÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o)
  unidadeProducao    String?  // sÃƒÆ’Ã‚Â­mbolo da unidade de produÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o
  fatorAplicado      Decimal? @db.Decimal(14, 6) // fator para converter para unidade base do produto
  quantidadeProduzida Decimal @db.Decimal(14, 3) // quantidade efetivamente produzida (apÃƒÆ’Ã‚Â³s perdas)
  perda              Decimal  @default(0) @db.Decimal(14, 3) // perda registrada na produÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o
  custoUnitario      Decimal  @db.Decimal(14, 6)
  custoTotal         Decimal  @db.Decimal(14, 2)
  composicaoSnapshot Json     // cÃƒÆ’Ã‚Â³pia da ficha tÃƒÆ’Ã‚Â©cnica, fatores e custos da data da produÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o
  idempotencyKey     String
  createdAt          DateTime @default(now())
  filial             Filial   @relation(fields: [filialId], references: [id], onDelete: Restrict)
  produtoKit         Produto  @relation(fields: [produtoKitId], references: [id], onDelete: Restrict)
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario            Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, produtoKitId, createdAt])
  @@index([filialId, createdAt])
}

// --- Se+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o 9 Estoque ---
model Estoque {
  id         String   @id @default(cuid())
  empresaId  String
  filialId   String
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  filial     Filial   @relation(fields: [filialId], references: [id])
  quantidade Decimal  @default(0) @db.Decimal(14, 3)
  valorTotal Decimal  @default(0) @db.Decimal(14, 2)
  lote       String? // nÃƒÆ’Ã‚Âºmero do lote para controle de validade
  local      String? // local de armazenamento (prateleira, estante, etc.)
  updatedAt  DateTime @updatedAt

  @@unique([filialId, produtoId])
  @@index([empresaId])
  contagens      ContagemInventario[]
}

// Decis+ÃƒÂ¯Ã‚Â¿Ã‚Â½o arquitetural (Fase 3, d+ÃƒÂ¯Ã‚Â¿Ã‚Â½vida t+ÃƒÂ¯Ã‚Â¿Ã‚Â½cnica registrada em
// DEBITO-TECNICO.md item 8): giro real precisa de estoque m+ÃƒÂ¯Ã‚Â¿Ã‚Â½dio no
// per+ÃƒÂ¯Ã‚Â¿Ã‚Â½odo, que por sua vez precisa de uma s+ÃƒÂ¯Ã‚Â¿Ã‚Â½rie hist+ÃƒÂ¯Ã‚Â¿Ã‚Â½rica de saldo di+ÃƒÂ¯Ã‚Â¿Ã‚Â½rio
// ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ a posi+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o atual (Estoque) e o log de eventos (EstoqueMovimentacao) n+ÃƒÂ¯Ã‚Â¿Ã‚Â½o
// bastam sozinhos porque reconstruir o saldo em cada dia passado a partir
// s+ÃƒÂ¯Ã‚Â¿Ã‚Â½ do log seria caro de consultar toda vez. Uma linha por
// produto+ÃƒÂ¯Ã‚Â¿Ã‚Â½filial+ÃƒÂ¯Ã‚Â¿Ã‚Â½dia +ÃƒÂ¯Ã‚Â¿Ã‚Â½ o suficiente (n+ÃƒÂ¯Ã‚Â¿Ã‚Â½o guarda hist+ÃƒÂ¯Ã‚Â¿Ã‚Â½rico de pre+ÃƒÂ¯Ã‚Â¿Ã‚Â½o por
// unidade nem lote ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ isso seria over-engineering para o que a Se+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o 9
// pede). Alimentada por src/scripts/gerarSnapshotsDiarios.ts (rodado uma
// vez por dia por um agendador externo ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½ este projeto n+ÃƒÂ¯Ã‚Â¿Ã‚Â½o inclui um
// scheduler) ou por POST /estoque/snapshot/gerar.
// ===========================================================================
//  Ciclo 6 ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â SessÃƒÆ’Ã‚Â£o de InventÃƒÆ’Ã‚Â¡rio
// ===========================================================================
//
//  POR QUE UMA SESSÃƒÆ’Ã†â€™O E NÃƒÆ’Ã†â€™O UM CAMPO NA FOLHA
//  -----------------------------------------
//  A folha de inventÃƒÆ’Ã‚Â¡rio morre com a tela: fechar o navegador perde a contagem
//  inteira. Um inventÃƒÆ’Ã‚Â¡rio de depÃƒÆ’Ã‚Â³sito leva horas ou dias, e a empresa fecha a
//  loja ÃƒÆ’Ã‚Â s 18h com metade dela contada. A sessÃƒÆ’Ã‚Â£o ÃƒÆ’Ã‚Â© o registro que sobrevive ao
//  navegador ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â reabrir amanhÃƒÆ’Ã‚Â£ continua de onde parou.
//
//  O SALDO DO SISTEMA ÃƒÆ’Ã¢â‚¬Â° CONGELADO NA ABERTURA
//  --------------------------------------------
//  `quantidadeSistema` ÃƒÆ’Ã‚Â© gravada no momento em que a sessÃƒÆ’Ã‚Â£o ÃƒÆ’Ã‚Â© criada e nunca
//  muda. Isso nÃƒÆ’Ã‚Â£o ÃƒÆ’Ã‚Â© economia de consulta, ÃƒÆ’Ã‚Â© o que dÃƒÆ’Ã‚Â¡ sentido ao nÃƒÆ’Ã‚Âºmero: se o
//  estoque muda no meio da contagem (uma venda, uma entrada de compra) e a
//  divergÃƒÆ’Ã‚Âªncia fosse recalculada a cada leitura, o inventÃƒÆ’Ã‚Â¡rio compararia a
//  contagem fÃƒÆ’Ã‚Â­sica com um alvo que se moveu ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â e acharia desvio onde sÃƒÆ’Ã‚Â³ houve
//  operaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o normal. Congelado, a divergÃƒÆ’Ã‚Âªncia ÃƒÆ’Ã‚Â© a diferenÃƒÆ’Ã‚Â§a entre o que estava
//  lÃƒÆ’Ã‚Â¡ quando alguÃƒÆ’Ã‚Â©m abriu a folha e o que realmente existe.
//
//  A IDENTIFICAÃƒÆ’Ã¢â‚¬Â¡ÃƒÆ’Ã†â€™O DO ITEM ÃƒÆ’Ã¢â‚¬Â° COPIADA, NÃƒÆ’Ã†â€™O REFERENCIADA
//  ---------------------------------------------------
//  Produto, unidade e local sÃƒÆ’Ã‚Â£o gravados como texto. Um inventÃƒÆ’Ã‚Â¡rio ÃƒÆ’Ã‚Â© documento
//  de trabalho: ele precisa continuar legÃƒÆ’Ã‚Â­vel depois que o produto foi
//  renomeado ou desativado, e uma linha que vira "null" porque o cadastro
//  mudou ÃƒÆ’Ã‚Â© pior que inÃƒÆ’Ã‚Âºtil. O `estoqueId` fica sÃƒÆ’Ã‚Â³ como rastro, e pode sumir.
//
//  VISÃƒÆ’Ã†â€™O CEGA FICA REGISTRADA
//  --------------------------
//  `cegas` diz se aquela sessÃƒÆ’Ã‚Â£o foi contada sem o saldo visÃƒÆ’Ã‚Â­vel. Um perÃƒÆ’Ã‚Â­odo
//  depois, o histÃƒÆ’Ã‚Â³rico mostra se a contagem foi cega ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â e o `criadoPorId` diz
//  quem abriu. ÃƒÆ’Ã¢â‚¬Â° a diferenÃƒÆ’Ã‚Â§a entre "inventÃƒÆ’Ã‚Â¡rio" e "conferÃƒÆ’Ã‚Âªncia", e precisa ser
//  auditÃƒÆ’Ã‚Â¡vel.

enum StatusSessaoInventario {
  ABERTA
  CONCLUIDA
  CANCELADA
}

model SessaoInventario {
  id         String @id @default(cuid())
  empresaId  String
  /// RÃƒÆ’Ã‚Â³tulo que a empresa dÃƒÆ’Ã‚Â¡ ÃƒÆ’Ã‚Â  contagem ("InventÃƒÆ’Ã‚Â¡rio 3T2026 ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â Centro").
  nome       String
  filialId   String
  filial     Filial @relation(fields: [filialId], references: [id])
  status     StatusSessaoInventario @default(ABERTA)
  /// `true` quando a folha foi aberta sem o saldo do sistema ÃƒÆ’Ã‚Â  vista.
  cegas      Boolean @default(true)
  /// Quem abriu a folha e quando ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â a autoria ÃƒÆ’Ã‚Â© o que dÃƒÆ’Ã‚Â¡ valor ao histÃƒÆ’Ã‚Â³rico.
  criadoPorId String?
  criadoPor   Usuario? @relation("SessaoInventarioCriador", fields: [criadoPorId], references: [id])
  criadoEm   DateTime @default(now())
  /// Quem fechou a contagem. NULL enquanto a sessÃƒÆ’Ã‚Â£o estÃƒÆ’Ã‚Â¡ aberta.
  concluidoPorId String?
  concluidoPor   Usuario? @relation("SessaoInventarioConclusor", fields: [concluidoPorId], references: [id])
  concluidoEm DateTime?
  observacoes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contagens  ContagemInventario[]

  /// Duas folhas abertas na mesma filial transformam uma contagem em duas
  /// versÃƒÆ’Ã‚Âµes diferentes do mesmo nÃƒÆ’Ã‚Âºmero.
  @@index([empresaId, status])
  @@index([empresaId, filialId, criadoEm])
}

model ContagemInventario {
  id         String @id @default(cuid())
  empresaId  String
  sessaoId   String
  sessao     SessaoInventario @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  /// Rastro da linha de estoque contada. `SetNull`: o produto pode ser
  /// desativado ou a linha removida, e a contagem jÃƒÆ’Ã‚Â¡ feita continua valendo.
  estoqueId  String?
  estoque    Estoque? @relation(fields: [estoqueId], references: [id], onDelete: SetNull)

  // CÃƒÆ’Ã‚Â³pia do que foi contado ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â o inventÃƒÆ’Ã‚Â¡rio precisa continuar legÃƒÆ’Ã‚Â­vel.
  produtoId   String
