// --- PARTE 3: Se+ÃƒÂ¯Ã‚Â¿Ã‚Â½+ÃƒÂ¯Ã‚Â¿Ã‚Â½o 13 Vendas ---
enum StatusVenda {
  ABERTA
  FINALIZADA
  CANCELADA
  DEVOLVIDA
  ESTORNADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

model Venda {
  id              String         @id @default(cuid())
  empresaId       String
  filialId        String
  setorId         String?
  clienteId       String?
  cliente         Cliente?       @relation(fields: [clienteId], references: [id])
  funcionarioId   String? // Usuario que vendeu
  formaPagamento  FormaPagamento @default(DINHEIRO)
  /// Em quantas parcelas o cliente pagou (1 = ÃƒÆ’Ã‚Â  vista). O PDV oferecia 1x a 6x
  /// e o cupom imprimia "3x", mas o nÃƒÆ’Ã‚Âºmero nÃƒÆ’Ã‚Â£o era gravado em lugar nenhum:
  /// o comprovante do cliente afirmava um parcelamento inexistente no sistema.
  /// NÃƒÆ’Ã†â€™O implica receber em N parcelas no financeiro ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â a receita continua
  /// uma linha pelo total; isto registra o que foi combinado na venda.
  parcelas       Int            @default(1)
  status          StatusVenda    @default(ABERTA)
  subtotal        Decimal        @db.Decimal(12, 2)
  desconto        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  origem          Origem         @default(MANUAL)
  pdvId           String?
  pdvSincronizado Boolean        @default(false)
  caixaId         String? // PDV: turno de caixa que fechou a venda
  caixa           Caixa?         @relation(fields: [caixaId], references: [id])
  // FASE 1 PDV PRO ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â idempotÃƒÆ’Ã‚Âªncia: mesma key + mesma empresa = mesma operaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o.
  // Nulo nas vendas antigas; novas vendas PDV devem preencher. O backend impÃƒÆ’Ã‚Âµe
  // unicidade via tabela IdempotencyKey (fonte normativa), este campo ÃƒÆ’Ã‚Â© ÃƒÆ’Ã‚Â­ndice auxiliar.
  idempotencyKey String?
  // FASE 1 PDV PRO ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â dia operacional da filial (YYYY-MM-DD como Date UTC meia-noite).
  // Derivado de createdAt + Filial.fusoHorario no momento da criaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o; nunca editado.
  // Backfill cobre vendas antigas; novas vendas sempre preenchem.
  dataOperacional DateTime? @db.Date
  troco             Decimal?         @db.Decimal(10, 2)   // troco devolvido ao cliente
  valorRecebido     Decimal?         @db.Decimal(10, 2)   // valor pago pelo cliente
  observacao        String?          @db.VarChar(500)   // observação livre
  // FASE 1 PDV PRO ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â desconto com alÃƒÆ’Ã‚Â§ada: quem autorizou quando passou do limite do operador.
  descontoAutorizadoPor String?
  motivoDesconto String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  itens           VendaItem[]
  pagamentos      VendaPagamento[]
  reservas        EstoqueReserva[]
  movimentacoesCaixa MovimentacaoCaixa[]

  @@index([empresaId, filialId])
  @@index([caixaId])
  @@index([createdAt])
  @@index([empresaId, filialId, dataOperacional])
  @@index([empresaId, idempotencyKey])
}

model VendaItem {
  id              String  @id @default(cuid())
  vendaId         String
  venda           Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId       String
  quantidade      Decimal @db.Decimal(14, 3) // quantidade na unidade de venda
  unidadeVenda    String? // sÃƒÆ’Ã‚Â­mbolo da unidade de venda no momento (ex: "UN", "dz", "kg")
  fatorAplicado   Decimal? @db.Decimal(14, 6) // fator usado para converter para unidade base
  quantidadeBase  Decimal? @db.Decimal(14, 3) // quantidade convertida para unidade base (baixa de estoque)
  preco           Decimal @db.Decimal(10, 2)
  custoUnitario   Decimal @db.Decimal(10, 2)
  desconto        Decimal @default(0) @db.Decimal(10, 2)
  total           Decimal @db.Decimal(12, 2)

  @@index([vendaId])
}

// --- SeÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½o 14 PDV ÃƒÂ¯Ã‚Â¿Ã‚Â½ Caixa (turno de operaÃƒÂ¯Ã‚Â¿Ã‚Â½ÃƒÂ¯Ã‚Â¿Ã‚Â½o de balcÃƒÂ¯Ã‚Â¿Ã‚Â½o) ---
enum StatusCaixa {
  ABERTO
  FECHADO
  BLOQUEADO
  EM_FECHAMENTO
  DIVERGENCIA
}

enum TipoMovimentoCaixa {
  ABERTURA
  SANGRIA
  SUPRIMENTO
  VENDA
  ESTORNO
  DEVOLUCAO
  AJUSTE
  FECHAMENTO
}

model Caixa {
