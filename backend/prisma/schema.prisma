}

/// SituaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o do pagamento de UM funcionÃƒÆ’Ã‚Â¡rio dentro da competÃƒÆ’Ã‚Âªncia.
/// `ATRASADO` ÃƒÆ’Ã‚Â© DERIVADO, nunca gravado: depende da data prevista e de hoje.
enum StatusPagamentoFolha {
  PENDENTE
  PAGO
}

/// Provento credita o funcionÃƒÆ’Ã‚Â¡rio; desconto debita.
enum TipoLancamento {
  PROVENTO
