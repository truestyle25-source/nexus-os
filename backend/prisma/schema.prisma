// ===== PARTE 6 - IA (mesclado de schema-additions-ia.prisma) =====
enum TipoAlerta {
  ESTOQUE_BAIXO
  ESTOQUE_ZERADO
  VALIDADE
  QUEDA_VENDAS
  META_BAIXA
  CONTA_VENCIDA
  DESPESA_ALTA
  FALTA
  ATRASO
  HORA_EXTRA
  ANOMALIA_IA
  COMPRA_PENDENTE
  SEGURANCA
  INTEGRACAO
}

