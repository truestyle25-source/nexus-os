  createdAt    DateTime        @default(now())

  @@index([assinaturaId, status])
  @@index([orderNsu])
}

// ===== Relatórios gerados pela IA (Seção 33 + IA NEXUS) =====
model RelatorioGerado {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  perguntaOriginal String
  titulo           String
  tipo             String
  dados            Json
  insights         Json?
  criadoEm         DateTime @default(now())

  @@index([empresaId, criadoEm])
}

// ===========================================================================
//  Seção 22 — Folha de Pagamento
//
//  DECISÃO DE PROJETO: por que estes modelos são novos e não reaproveitados
//  --------------------------------------------------------------------------
//  O `Pagamento` que já existe no schema é da ASSINATURA SaaS (vinculado a
//  `Assinatura`, com `assinaturaId` e cobranca de 19,90/mês). Não é folha de
//  pagamento de funcionário — reutilizá-lo misturaria a receita da plataforma com
//  obrigação trabalhista, e aï¿½ï¿½o tém empresas deēfusos de vida diferentes. Por
//  isso a folha tem modelos próprios, e `PagamentoRH` é o nome deliberado.
//
//  O cálculo NÃO fica no schema: `Folha.lancamentos` guarda o resultado apurado
//  pelo servidor como SNAPSHOT, pelo mesmo motivo das verbas de rescisão — folha
//  fechada não pode mudar porque o salário foi reajustado depois.
// ===========================================================================

/// Situação da folha mensal. `FECHADA` impede lançamentos (ver rotas).
enum StatusFolha {
  ABERTA
  PROCESSADA
  FECHADA
}

/// Situação do pagamento de UM funcionário dentro da competência.
/// `ATRASADO` é DERIVADO, nunca gravado: depende da data prevista e de hoje.
enum StatusPagamentoFolha {
  PENDENTE
  PAGO
}

/// Provento credita o funcionário; desconto debita.
enum TipoLancamento {
  PROVENTO
  DESCONTO
}

/// De onde veio o lançamento. `PONTO` só existe se o módulo de ponto tiver
/// batidas reais na competência; `AUTOMATICO` é o salário-base e adicionais
/// derivados do cadastro.
enum OrigemLancamento {
  AUTOMATICO
  PONTO
  MANUAL
}

/// Competência mensal (AAAA-MM). `Folha` é única por empresa+competência.
model Folha {
  id                String      @id @default(cuid())
  empresaId         String
  empresa           Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  /// AAAA-MM. Texto e não DateTime de propósito: competência é período, não
  /// instante, e um DateTime traria fuso e horário para uma informação que não os tem.
  competencia       String
  status            StatusFolha @default(ABERTA)
  dataAbertura      DateTime    @default(now())
  dataProcessamento DateTime?
  dataFechamento    DateTime?
  fechadaPorId      String?
  fechadaPor        Usuario?    @relation(fields: [fechadaPorId], references: [id])
  /// Totais da competência, gravados no fechamento como snapshot do fechamento.
  /// A listagem usa estes valores em vez de somar linha a linha a cada leitura.
  totalProventos    Decimal     @default(0) @db.Decimal(12, 2)
  totalDescontos    Decimal     @default(0) @db.Decimal(12, 2)
  totalLiquido      Decimal     @default(0) @db.Decimal(12, 2)
  observacoes       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lancamentos LancamentoFolha[]
  pagamentos  PagamentoRH[]

  @@unique([empresaId, competencia])
  @@index([empresaId, status])
}

/// Um lançamento de provento ou desconto na folha.
model LancamentoFolha {
  id            String           @id @default(cuid())
  empresaId     String
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  folhaId       String
  folha         Folha            @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  funcionarioId String
  funcionario   Funcionario      @relation(fields: [funcionarioId], references: [id])
  /// Código da rubrica (ex.: "001", "HORA_EXTRA", "INSS"). Label-like, não únique
  /// global: a mesma rubrica pode mudar de descrição entre competências.
  codigo        String
  descricao     String
  tipo          TipoLancamento
  /// Quantidade/referência (horas, dias, %). NULL quando a rubrica não tem.
  referencia    Decimal?         @db.Decimal(12, 4)
  valor         Decimal          @db.Decimal(12, 2)
  /// Salário-base no momento do lançamento. Guardado para que o histórico
  /// sobreviva a reajuste salarial: o 13º de março não pode virar 13º de
  /// setembro reescalado.
  salarioBase   Decimal?         @db.Decimal(12, 2)
  /// "% de desconto do empregado sobre o total de proventos", quando o lançamento
  /// representa um percentual (INSS, IRRF, vale-transporte). Guardado como
  /// REFERÊNcia, nunca aplicado sobre outro total.
  percentual    Decimal?         @db.Decimal(6, 4)
  observacoes   String?
  origem        OrigemLancamento @default(MANUAL)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([empresaId, folhaId])
  @@index([funcionarioId, folhaId])
}

/// Pagamento do salário líquido de UM funcionário numa competência.
model PagamentoRH {
  id             String               @id @default(cuid())
  empresaId      String
  empresa        Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  folhaId        String
  folha          Folha                @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  funcionarioId  String
  funcionario    Funcionario          @relation(fields: [funcionarioId], references: [id])
  /// Líquido apurado no fechamento — snapshot. O valor real do pagamento não pode
  /// divergir do líquido (adiantamentos, ajustes); os dois são gravados.
  valorLiquido   Decimal              @db.Decimal(12, 2)
  valorPago      Decimal?             @db.Decimal(12, 2)
  status         StatusPagamentoFolha @default(PENDENTE)
  dataPrevista   DateTime?
  dataPagamento  DateTime?
  formaPagamento String?
  observacoes    String?
  /// Comprovante em PDF, referência a `Documento` (bucket). NULL até o anexo.
  documentoId    String?
  documento      Documento?           @relation(fields: [documentoId], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([empresaId, folhaId])
  @@index([funcionarioId, status])
}

/// 13º salary: controle por ano-calendário, com parcelas e proporcionalidade.
model DecimoTerceiro {
  id                   String      @id @default(cuid())
  empresaId            String
  empresa              Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  funcionarioId        String
  funcionario          Funcionario @relation(fields: [funcionarioId], references: [id])
  /// Ano-calendário do 13º.
  ano                  Int
  salarioBase          Decimal     @db.Decimal(12, 2)
  /// Meses de direito proporcional (1..12). Vem da data de admissão real.
  mesesDireito         Int         @default(12)
  valorBruto           Decimal     @db.Decimal(12, 2)
  /// Primeira parcela (adiantamento) — 50% do bruto, pago até 30/11.
  valorPrimeiraParcela Decimal?    @db.Decimal(12, 2)
  dataPrimeiraParcela  DateTime?
  valorSegundaParcela  Decimal?    @db.Decimal(12, 2)
  dataSegundaParcela   DateTime?
  /// Descontos aplicáveis — INSS, IRRF, adiantamentos. Soma dos lançamentos
  /// marcados como desconto NA folha deste funcionário/ano.
  totalDescontos       Decimal     @default(0) @db.Decimal(12, 2)
  valorLiquido         Decimal     @db.Decimal(12, 2)
  /// Percentual de fgts a cargo da empresa — guardado como REFERÊNcia para o
  /// pagamento do 13º. Ver `lib/folha.ts`: sem histórico de saldos, isto é
  /// informação, e não cálculo.
  fgtsReferencia       Decimal?    @db.Decimal(6, 4)
  /// Saldo de FGTS do funcionário. NULL até existir tabela de depósitos (não há no
  /// schema) — é o que impede estimar multa/FGTS por percentual.
  saldoFgts            Decimal?    @db.Decimal(12, 2)
  /// `null` = "não apurável com os dados atuais".
  status               String      @default("PENDENTE")
  dataPagamento        DateTime?
  observacoes          String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([empresaId, ano])
  @@index([funcionarioId, ano])
}

// ===== PIX universal (recebimento direto na conta do lojista) =====
enum TipoChavePix {
  CPF
  CNPJ
  PHONE
  EMAIL
  RANDOM
}

enum StatusCobrancaPix {
  PENDENTE
  PAGO
  EXPIRADO
  CANCELADO
}

model PixSettings {
  id           String       @id @default(cuid())
  empresaId    String       @unique
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  enabled      Boolean      @default(false)
  keyType      TipoChavePix
  pixKey       String // criptografada com AES (lib/secrets.ts) — nunca em texto puro
  merchantName String // max 25 (BACEN campo 59)
  merchantCity String // max 15 (BACEN campo 60)
  document     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([empresaId])
}

model PixCobranca {
  id        String            @id @default(cuid())
  empresaId String
  empresa   Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  vendaId   String?
  txid      String            @unique // BACEN: [A-Za-z0-9]{1,25}
  valor     Decimal           @db.Decimal(12, 2)
  payload   String // BR Code EMV (copia e cola)
  status    StatusCobrancaPix @default(PENDENTE)
  pagoEm    DateTime?
  expiraEm  DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([empresaId, status])
  @@index([vendaId])
}

model ChaveApi {
  id                 String    @id @default(cuid())
  empresaId          String
  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nome               String
  prefixo            String
  chaveHash          String    @unique
  escopos            String[]
  criadaPorUsuarioId String?
  status             String    @default("ATIVA")
  ultimoUso          DateTime?
  revogadaEm         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([empresaId])
  @@index([status])
}

model IntegracaoExterno {
  id                String    @id @default(cuid())
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipo              String    @default("MERCADO_LIVRE") // MERCADO_LIVRE
  state             String? // Nonce OAuth: valor único que valida o callback (gerado com randomBytes(24).base64url)
  stateExpiraEm     DateTime? // Validade do state (uso único, expira em 10 min); nulo quando não há tentativa pendente
  nome              String
  // Credenciais OAuth (clientId / clientSecret / redirectUri). Sempre
  // criptografadas antes de gravar e NUNCA expostas na resposta.
  clientId          String?
  clientSecret      String?
  redirectUri       String?
  // Informações da conta vinculada após o OAuth
  accountName       String?
  accountId         String?
  // Token de acesso (criptografado)
  accessToken       String?
  refreshToken      String?
  tokenExpiry       DateTime?
  scope             String?
  // Controle de estado de sincronização
  status            String    @default("NAO_CONFIGURADO") // NAO_CONFIGURADO | CONECTANDO | CONECTADO | EXPIRADO | ERRO | REVOGADO
  erros             Json?
  ultimoTesteEm     DateTime?
  ultimoSyncEm      DateTime?
  // Central de Integrações (provedores por credencial, ex.: ASAAS):
  // `credenciais` = JSON dos campos secretos, cifrado inteiro em secrets.ts (nunca volta ao navegador);
  // `config` = campos NÃO sensíveis (ambiente, URL da loja...); `conectadoEm` = 1ª validação real.
  credenciais       String?
  config            Json?
  conectadoEm       DateTime?
  // Importação automática (WooCommerce): próxima execução e trava entre instâncias (lease).
  proximoSyncEm     DateTime?
  syncLeaseExpiraEm DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([empresaId, tipo])
  @@index([empresaId])
  @@index([tipo])
  @@index([state])
}

// Histórico da Central de Integrações: uma linha por operação (testar, salvar,
// conectar, desconectar, remover, sincronizar). NUNCA guarda segredo, token ou
// corpo de resposta do provedor — só operação, resultado, código de erro e duração.
model IntegracaoEvento {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  provedor   String // id do provedor na Central (ex.: asaas, mercadolivre, shopee)
  operacao   String // TESTAR | SALVAR | CONECTAR | DESCONECTAR | REMOVER | SINCRONIZAR
  resultado  String // SUCESSO | FALHA
  codigoErro String?
  mensagem   String?
  duracaoMs  Int?
  usuarioId  String?
  createdAt  DateTime @default(now())

  @@index([empresaId, provedor, createdAt])
  @@index([createdAt]) // varredura do monitor de segurança (falhas recentes de todas as empresas)
}

// --- Sincronização automática do Mercado Livre --------------------------------
// Estado-máquina das tarefas recorrentes de sync (produtos / estoque /
// pedidos). POR QUE UMA TABELA PRÓPRIA: o agendamento precisa sobreviver a
// reinicialização, ser recuperável e seguro entre múltiplas instâncias —
// `setInterval` em memória perde o estado no restart e duplica execução com
// mais de um processo. Uma linha por (empresa, tipo) concentra o que falta
// executar e a evidência do que já foi feito (sem duplicar a semântica de
// `Importacao`, que registra cada execução individual).
//
// CONCORRÊNCIA: a trava é o par status=EXECUTANDO + leaseExpiraEm. A execução
// é tomada com updateMany condicional (count=1 => venceu) — operação atômica
// do PostgreSQL, segura entre instâncias sem lock distribuído. Lease vencido
// = execução órfã (processo caiu no meio): o próximo tick desengata e conta
// a recuperação em `recuperadas`.
model SincronizacaoTarefa {
  id                String    @id @default(cuid())
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  // Mesmos identificadores dos tipos de Importacao (MERCADO_LIVRE_*): o
  // histórico de execuções e a tarefa falando a mesma língua.
  tipo              String // MERCADO_LIVRE_PRODUTOS | MERCADO_LIVRE_ESTOQUE | MERCADO_LIVRE_PEDIDOS
  status            String    @default("AGUARDANDO") // AGUARDANDO | EXECUTANDO | PAUSADA
  // Execução vencida = candidata no tick; índice cobre a fila de vencidas.
  proximaExecucaoEm DateTime
  // Lease da execução em andamento; ao expirar, qualquer instância desengata.
  leaseExpiraEm     DateTime?
  instanciaId       String?
  tentativas        Int       @default(0) // falhas consecutivas (backoff exponencial)
  recuperadas       Int       @default(0) // execuções órfãs desengatadas (lease vencido)
  ultimaExecucaoEm  DateTime?
  ultimoSucessoEm   DateTime?
  // Redigido por construção: guarda apenas { motivo, em } — nunca token,
  // segredo, cabeçalho ou corpo de requisição.
  ultimoErro        Json?
  processadosUltima Int       @default(0)
  falhasUltima      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([empresaId, tipo])
  @@index([status, proximaExecucaoEm])
}

/// Caixa durável dos webhooks do Mercado Livre: a rota confirma o recebimento
/// depois de persistir o ponteiro e um worker os consulta/processa em seguida.
model NotificacaoMercadoLivre {
  id                String    @id @default(cuid())
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  eventKey          String
  topic             String
  resource          String
  userId            String
  payload           Json
  status            String    @default("AGUARDANDO") // AGUARDANDO | EXECUTANDO | PROCESSADO | IGNORADO | FALHA_PERMANENTE
  tentativas        Int       @default(0)
  proximaExecucaoEm DateTime  @default(now())
  leaseExpiraEm     DateTime?
  processadaEm      DateTime?
  finalizadaEm      DateTime?
  ultimoErro        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([empresaId, eventKey])
  @@index([status, proximaExecucaoEm])
}

// Conexões Shopee são por loja: ao contrário de IntegracaoExterno (ML), uma
// empresa pode vincular mais de uma loja autorizada.
model ShopeeConexao {
  id                    String         @id @default(cuid())
  empresaId             String
  empresa               Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  shopId                String
  shopName              String?
  accessToken           String?
  refreshToken          String?
  tokenExpiry           DateTime
  refreshTokenExpiry    DateTime?
  refreshLeaseExpiraEm  DateTime?
  pedidosNextSyncAt     DateTime?
  pedidosLeaseExpiraEm  DateTime?
  pedidosSyncTentativas Int            @default(0)
  pedidosJanelaDe       DateTime?
  pedidosJanelaAte      DateTime?
  pedidosCursor         String?
  status                String         @default("CONECTADO")
  connectedAt           DateTime       @default(now())
  ultimoTesteEm         DateTime?
  ultimoSyncEm          DateTime?
  erros                 Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  pedidos               ShopeePedido[]

  @@unique([empresaId, shopId])
  @@unique([id, empresaId])
  @@index([empresaId, status])
  @@index([tokenExpiry])
  @@index([refreshLeaseExpiraEm])
  @@index([pedidosNextSyncAt, pedidosLeaseExpiraEm])
}

// Guarda somente o hash do state OAuth; o valor bruto existe apenas no
// navegador durante a autorização. Empresa e usuário vêm da sessão NEXUS.
model ShopeeOAuthState {
  id         String    @id @default(cuid())
  stateHash  String    @unique
  empresaId  String
  empresa    Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@index([empresaId, usuarioId])
}

// Snapshot de identidade/status de pedido, sem PII nem payload bruto. Este
// registro serve para polling/reconciliação; não representa uma Venda NEXUS.
model ShopeePedido {
  id                String        @id @default(cuid())
  empresaId         String
  empresa           Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  conexaoId         String
  conexao           ShopeeConexao @relation(fields: [conexaoId, empresaId], references: [id, empresaId], onDelete: Restrict)
  orderSn           String
  statusExterno     String
  externalUpdatedAt DateTime
  externalCreatedAt DateTime?
  lastSeenAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([conexaoId, orderSn])
  @@index([empresaId, statusExterno])
  @@index([conexaoId, externalUpdatedAt])
}

model TokenRevogado {
  id        String   @id @default(cuid())
  jti       String   @unique
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([expiraEm])
}

// =============================================================================
// Radar Organizacional — camada de inteligência que cruza os módulos
// =============================================================================
//
// POR QUE CADA TABELA EXISTE (nenhuma duplica estrutura existente):
//
// 1) AvaliacaoComportamental — o prompt do Radar diz que o perfil DISC é
//    "informação levantada pelo RH", ou seja, ENTRADA humana, não medição
//    automática. Sem um lugar para o RH registrar, o campo é sempre null e o
//    Radar mostraria um espaço permanentemente vazio. Nenhum modelo existente
//    guarda isso.
//
// 2) PesquisaBemEstar — mesma lógica: bem-estar é perception humana coletada
//    pelo RH. O Radar só faz o cruzamento; quem mede é a pessoa.
//
// 3) RegistroGamificacao — o prompt proíbe localStorage para informação
//    empresarial. Pontos, conquistas e reconhecimento precisam sobreviver a
//    troca de navegador e ser auditáveis.
//
// 4) AcaoRadar — o botão "Criar Plano de Ação" precisa persistir o que o
//    gestor planejou a partir de um alerta. Hoje ele não grava nada.
//
// Ponto comum: as quatro são multi-tenant (empresaId) e ficam fora do modelo
// de decisão — o Radar mostra sinais, não diagnostica.

enum PerfilDisc {
  D
  I
  S
  C
}

// ===========================================================================
//  Ciclo 1 — Plano de Desenvolvimento DISC
// ===========================================================================
//  Transforma uma avaliação DISC REAL em um plano de desenvolvimento
//  individual.
//
//  POR QUE UMA TABELA NOVA E NÃO REAPROVEITAR `AcaoRadar`
//  --------------------------------------------------
//  `AcaoRadar` é o plano de ação derivado de um ALERTA. O plano de
//  desenvolvimento parte de uma AVALIAÇÃO, e a diferença não é de campo, é de
//  domínio: `AcaoRadar.alertaRef` e `alertaTitulo` são NOT NULL porque a linha
//  só existe quando existe um alerta, e é esse `alertaRef` que faz o badge do
//  alerta virar "Em ação"/"Resolvido" (radar.routes.ts). Um plano de
//  desenvolvimento não tem alerta de origem.
//
//  Forçar o reuso exigiria tornar as duas colunas opcionais e acrescentar
//  seis campos (avaliacaoId, objetivo, competencia, descricao, dataInicio,
//  analiseIA) — e a tabela passaria a guardar duas coisas diferentes com o
//  mesmo nome. Criar a entidade própria é o caminho mais simples de explicar e
//  de manter, que é o critério que o próprio schema usa nas outras decisões.
//
//  RELAÇÕES
//  ----------
//  * `funcionario` — de quem é o plano (CASCADE: plano não sobrevive à pessoa).
//  * `avaliacao`   — a avaliação que o originou. Guardar o id, e não só o
//                    perfil, permite responder "com qual avaliação este plano
//                    foi feito?" depois que a vigente mudar.
//
//  SNAPSHOT
//  --------
//  `perfil` e `scores` são cópia do momento da criação. Sem eles, o histórico
//  mudaria de significado sozinho quando uma avaliação nova entrasse: o plano
//  de 2026 passaria a exibir o perfil de 2027.
//
//  `analiseIA` guarda o que a IA sugeriu e o que o gestor aceitou, editou ou
//  recusou. A IA escreve em UM campo só, nunca em `perfil`/`scores`.

enum StatusPlanoDesenvolvimento {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum ObjetivoDesenvolvimento {
  COMUNICACAO
  LIDERANCA
  ORGANIZACAO
  TRABALHO_EM_EQUIPE
  GESTAO_DE_CONFLITOS
  ATENDIMENTO
  OUTRO
}

enum CompetenciaDesenvolvimento {
  COMUNICACAO
  LIDERANCA
  ORGANIZACAO
  TRABALHO_EM_EQUIPE
  GESTAO_DE_CONFLITOS
  ATENDIMENTO
  PROATIVIDADE
  ADAPTABILIDADE
  OUTRO
}

enum TipoAcaoDesenvolvimento {
  TREINAMENTO
  ACOMPANHAMENTO
  FEEDBACK
  EXERCICIO_PRATICO
  MENTORIA
  OUTRO
}

model PlanoDesenvolvimento {
  id            String                  @id @default(cuid())
  empresaId     String
  empresa       Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  funcionarioId String
  funcionario   Funcionario             @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  /// Avaliação que originou o plano. Snapshot do que foi visto na criação.
  avaliacaoId   String
  avaliacao     AvaliacaoComportamental @relation(fields: [avaliacaoId], references: [id])
  perfil        PerfilDisc?
  scores        Json?

  objetivo      ObjetivoDesenvolvimento
  competencia   CompetenciaDesenvolvimento
  descricao     String
  /// [{ tipo, descricao, concluida }] — `concluida` é o progresso do gestor.
  acoes         Json
  /// Quem conduz o plano. Coluna escalar como `AcaoRadar.responsavelId` e
  /// `AvaliacaoComportamental.aplicadoPorId` — o padrão do projeto é não
  /// declarar relação para `Usuario` e resolver o nome numa consulta à parte.
  /// Mantido assim por consistência; a rota valida que o responsável é desta
  /// empresa antes de gravar.
  responsavelId String?
  dataInicio    DateTime                   @db.Date
  prazo         DateTime?                  @db.Date
  status        StatusPlanoDesenvolvimento @default(PLANEJADO)
  /// Sugestão da IA + o que foi aceito. `null` quando a IA não respondeu: o
  /// plano continua válido e é montado à mão.
  analiseIA     Json?
  observacoes   String?
  origem        Origem                     @default(MANUAL)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([empresaId, status])
  @@index([empresaId, funcionarioId])
  @@index([empresaId, createdAt])
}

// ===========================================================================
//  Ciclo 2 — Treinamentos, participantes e presença
// ===========================================================================
//  POR QUE ENTIDADES NOVAS
//  -----------------------
//  Não existe nada de capacitação no schema: um treinamento é um EVENTO com
//  data, hora, instrutor e local, e nada disso existe em `AvaliacaoComportamental`
//  (que é uma medição pontual), em `PlanoDesenvolvimento` (que é um compromisso
//  de desenvolvimento) ou em `AcaoRadar` (que é reação a um alerta). A ação
//  `TREINAMENTO` do plano de desenvolvimento é um TEXTO dentro de um array — não
//  tem data, não tem sala, não tem lista de quem compareceu. Usar um desses
//  para "agendar" seria guardar um evento como se fosse uma nota.
//
//  RELAÇÃO COM O PLANO DE DESENVOLVIMENTO (Ciclo 1)
//  ------------------------------------------------
//  São entidades diferentes e complementares: o plano diz O QUE desenvolver, o
//  treinamento é UM evento que pode servir a esse plano. Por isso a ligação é
//  explícita e opcional (`planoDesenvolvimentoId`), e não implícita: um
//  treinamento de segurança pode existir sem plano, e um plano pode ter ações
//  que não viram treinamento.
//
//  POR QUE `ParticipanteTreinamento` E NÃO UM ARRAY JSON
//  ---------------------------------------------------
//  Os outros objetos do projeto guardam listas em `Json` (`acoes` do plano,
//  `causas` do alerta) porque são texto livre, consultado nunca. Aqui a lista
//  É a consulta: quantas pessoas tomado presença, quem faltou, o histórico
//  de um funcionário. Isso exige linha, índice e chave única — o que o schema
//  já faz com `@@unique([funcionarioId, data])` no `Ponto`.
//
//  RELAÇÃO COM O PONTO
//  -------------------
//  Deliberadamente SEPARADA. Presença em treinamento não é batida de ponto:
//  não gera falta, não gera hora extra, não entra no espelho de ponto. Um
//  treinamento de 2h não pode aparecer como "2 horas trabalhadas" na folha.
//  Misturar os dois contaminaria o cálculo de jornada com capacitação.
//
//  HORÁRIO
//  --------
//  `horaInicio`/`horaFim` são `String` no formato `HH:MM`, e não `@db.Time`, por
//  exatamente a mesma razão documentada em `Funcionario.horarioEntradaPrevisto`:
//  horário não tem fuso, e um tipo de data/hora no banco convida o bug de
//  fuso que o projeto já cometeu três vezes.

enum StatusTreinamento {
  PLANEJADO
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum PrioridadeTreinamento {
  BAIXA
  MEDIA
  ALTA
}

/// `CONVIDADO` e `CONFIRMADO` descrevem a intenção; `PRESENTE`/`AUSENTE`
/// descrevem o que aconteceu. São estados diferentes de propósito: um
/// treinamento CONCLUIDO com gente ainda em `CONFIRMADO` tem ausência não
/// registrada, e a tela precisa poder dizer isso em vez de mostrar 100%
/// presente por omissão.
enum StatusParticipante {
  CONVIDADO
  CONFIRMADO
  PRESENTE
  AUSENTE
  CANCELADO
}

model Treinamento {
  id                     String            @id @default(cuid())
  empresaId              String
  empresa                Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  titulo                 String
  descricao              String
  /// Catálogo livre de texto (ex.: "COMUNICACAO", "SEGURANCA"). Sem tabela de
  /// categorias: o projeto usa `categoria String` no `Produto` e `tipo String`
  /// na `Meta`, e uma tabela a mais só traria rigidez sem ganho — o filtro é
  /// por valor, e o valor é legível.
  categoria              String
  objetivo               String
  /// Nome de quem ministra. Texto, e não relação com `Usuario`: o instrutor
  /// quase nunca é alguém com login no sistema (consultor, parceiro), e criar
  /// um cadastro de usuário para ele seria inventar dado.
  instrutor              String
  /// Quem responde pelo registro. Coluna escalar, como `AcaoRadar.responsavelId`.
  responsavelId          String?
  data                   DateTime          @db.Date
  /// `HH:MM`. Ver a nota sobre horário acima.
  horaInicio             String
  horaFim                String
  /// Minutos. DEDITO, nunca estimado: se a rota conseguir calcular
  /// (horaFim - horaInicio), o valor gravado é o cálculo; a tela não inventa.
  duracaoMinutos         Int
  local                  String
  /// `null` = sem limite. `0` não é o mesmo que "sem limite": 0 significaria
  /// "ninguém pode participar", que é uma decisão, não ausência de decisão.
  limiteParticipantes    Int?
  status                 StatusTreinamento @default(PLANEJADO)
  /// Opcional: liga o treinamento ao plano de desenvolvimento que o motivou.
  planoDesenvolvimentoId String?
  /// Sugestão da IA que o gestor revisou. NULL quando não houve IA — o
  /// treinamento é válido de qualquer forma, e a origem (`MANUAL`/`IA`) já diz
  /// como ele nasceu.
  analiseIA              Json?
  observacoes            String?
  origem                 Origem            @default(MANUAL)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  participantes ParticipanteTreinamento[]

  @@index([empresaId, status])
  @@index([empresaId, data])
  @@index([empresaId, createdAt])
}

/// N:N entre treinamento e funcionário, com o registro de presença.
///
/// `empresaId` é redundante com o do treinamento, e mesmo assim fica: é o que
/// permite as consultas de multi-tenant rodarem em UMA tabela só
/// (`where: { empresaId }`) sem joins, e o que garante que um `DELETE` em massa
/// de uma empresa não alcance registros de outra.
model ParticipanteTreinamento {
  id            String             @id @default(cuid())
  empresaId     String
  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  treinamentoId String
  treinamento   Treinamento        @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  funcionarioId String
  funcionario   Funcionario        @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  status        StatusParticipante @default(CONVIDADO)
  observacao    String?
  dataRegistro  DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Impede o mesmo funcionário entrar duas vezes no mesmo treinamento.
  @@unique([treinamentoId, funcionarioId])
  // Histórico do funcionário: a ordem de quem treinou quando.
  @@index([empresaId, funcionarioId, dataRegistro])
  // Chamada de presença: quem está em cada treinamento.
  @@index([empresaId, treinamentoId, status])
}

model AvaliacaoComportamental {
  id            String                 @id @default(cuid())
  empresaId     String
  empresa       Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  funcionarioId String
  funcionario   Funcionario            @relation(fields: [funcionarioId], references: [id])
  /// Planos de desenvolvimento criados a partir desta avaliação.
  planos        PlanoDesenvolvimento[]
  perfil        PerfilDisc?
  /// Scores brutos por eixo (0-100). JSON porque o NEXUS não tem um eixo
  /// comportamental guardado em colunas.
  scores        Json?
  /// Texto do RH sobre o contexto profissional avaliado (apoiado, não decisório).
  observacoes   String?
  /// Quem aplicou a avaliação. Auditoria: perfil comportamental é dado sensível.
  aplicadoPorId String?
  dataAvaliacao DateTime               @db.Date
  vigente       Boolean                @default(true)
  origem        Origem                 @default(MANUAL)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([empresaId, funcionarioId])
  @@index([empresaId, dataAvaliacao])
}

model PesquisaBemEstar {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  /// 0-100, autodeclarado pelo colaborador ou registrado pelo RH.
  nota          Int
  /// Uma pergunta livre por resposta guarda a causa apontada pela pessoa.
  resposta      String?
  dataPesquisa  DateTime    @db.Date
  aplicadoPorId String?
  origem        Origem      @default(MANUAL)
  createdAt     DateTime    @default(now())

  @@index([empresaId, dataPesquisa])
  @@index([empresaId, funcionarioId])
}

model RegistroGamificacao {
  id            String             @id @default(cuid())
  empresaId     String
  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  /// Funcionário recebeu; opcional quando o registro é da equipe inteira.
  funcionarioId String?
  funcionario   Funcionario?       @relation(fields: [funcionarioId], references: [id])
  /// 'meta' | 'objetivo' | 'conquista' | 'reconhecimento'
  tipo          String
  descricao     String
  pontos        Int                @default(0)
  /// Regra que gerou o ponto. No Ciclo 5 passou a ser o `id` de um
  /// `CriterioPontuacao` da própria empresa — o valor gravado aqui é o que
  /// A EMPRESA configurou, nunca um valor padrão do NEXUS.
  regraId       String?
  /// Ciclo 5: quando o ponto veio da apuração automática de um critério da
  /// empresa. Lançamento manual do gestor fica com este campo NULO — são dois
  /// caminhos distintos para o mesmo saldo, e a tela precisa saber qual é.
  criterioId    String?
  criterio      CriterioPontuacao? @relation(fields: [criterioId], references: [id], onDelete: SetNull)
  /// De onde veio o evento real (ex.: 'ponto_sem_atraso', 'venda_finalizada').
  eventoOrigem  String?
  eventoId      String?
  data          DateTime           @db.Date
  status        String             @default("ATIVO") // ATIVO, ANULADO
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([empresaId, data])
  @@index([empresaId, tipo])
  /// Ciclo 5: quem automatizou este registro, e o quando — é o que separa um
  /// ponto de apuração de um lançamento manual do gestor.
  @@index([empresaId, criterioId])
}

// ===========================================================================
//  Ciclo 4 — Loja de Recompensas e Resgates
// ===========================================================================
//  POR QUE DUAS TABELAS E NÃO UMA
//  --------------------------
//  A `Recompensa` é o CATÁLOGO: o que a empresa oferece, quanto custa, quanto
//  tem. O `Resgate` é a TRANSAÇÃO: quem pegou o quê, quando e em que status.
//  Uma tabela só misturaria "a empresa tem 10 vale-presente" com "a Ana pegou
//  um deles" — e o estoque não se contaria.
//
//  SALDO DE PONTOS — A CONTA CORRETA
//  -------------------------------
//  `RegistroGamificacao` só SOMA pontos. Um resgate precisa DEBITAR, e o
//  saldo não pode ser `soma(pontos)` por três motivos:
//    1. resgate cancelado devolve os pontos;
//    2. registro com status ANULADO precisa deixar de contar;
//    3. saldo é histórico de saldo, não soma de coluna.
//
//  Por isso o saldo é SEMPRE: soma(registros ATIVOS) − soma(resgates que
//  consumiram pontos). É a fórmula que `saldoDePontos` aplica, e ela está
//  testada. Nenhum número de saldo é gravado em coluna — se fosse, deixaria de
//  bater com os registros no primeiro lançamento.
//
//  ESTOQUE
//  -------
//  `quantidadeDisponivel` é o estoque real, e um resgate SOLICITADO já o
//  reserva: é o que impede que 3 pessoas resgatem o último vale-presente antes
//  de alguém aprovar. Cancelar e rejeitar devolvem ao estoque, na mesma
//  transação que muda o status.
//
//  ESTORNO
//  -------
//  Rejeitar/cancelar NÃO apaga a linha: ela vira histórico. E o débito dos
//  pontos é desfeito pela própria fórmula do saldo (o resgate deixa de contar),
//  e não por um segundo lançamento negativo — que duplicaria a conta e
//  esconderia o erro.

enum CategoriaRecompensa {
  BENEFICIO
  EXPERIENCIA
  CURSO
  ALIMENTACAO
  FOLGA
  BRINDE
  OUTRO
}

enum StatusResgate {
  SOLICITADO
  APROVADO
  ENTREGUE
  REJEITADO
  CANCELADO
}

model Recompensa {
  id                   String              @id @default(cuid())
  empresaId            String
  empresa              Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nome                 String
  descricao            String
  categoria            CategoriaRecompensa @default(OUTRO)
  /// Quanto custa em pontos. `Int`, porque ponto é contagem.
  custoPontos          Int
  /// Estoque REAL. `0` significa "esgotado" e some da vitrine — não
  /// "sem limite", que seria outra decisão e teria outro campo.
  quantidadeDisponivel Int                 @default(0)
  /// `false` esconde da loja sem apagar o histórico de quem já resgatou.
  ativa                Boolean             @default(true)
  observacoes          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  resgates ResgateRecompensa[]

  @@index([empresaId, ativa])
  @@index([empresaId, categoria])
}

model ResgateRecompensa {
  id               String        @id @default(cuid())
  empresaId        String
  empresa          Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  recompensaId     String
  recompensa       Recompensa    @relation(fields: [recompensaId], references: [id], onDelete: Cascade)
  /// Quem resgatou. Coluna escalar, padrão do projeto; o nome é resolvido em
  /// consulta à parte.
  funcionarioId    String
  /// Custo congelado no momento do resgate. Se a empresa reajustar o preço
  /// depois, o histórico continua dizendo o que a pessoa pagou — sem isso, o
  /// registro mentiria sobre a transação antiga.
  pontosUtilizados Int
  status           StatusResgate @default(SOLICITADO)
  /// Quem aprovou/rejeitou/cancelou. NULL enquanto ninguém decidiu.
  aprovadoPorId    String?
  data             DateTime      @db.Date
  aprovadoEm       DateTime?     @db.Date
  entregueEm       DateTime?     @db.Date
  observacoes      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([empresaId, funcionarioId, data])
  @@index([empresaId, status])
}

// ===========================================================================
//  Ciclo 5 — Pontuação CONFIGURÁVEL por empresa
// ===========================================================================
//
//  A REGRA DO CICLO, EM UMA FRASE
//  ---------------------------------
//  O NEXUS não tem opinião sobre quanto vale absenceiro. A EMPRESA decide quais
//  critérios existem, qual condição cada um exige, quantos pontos vale e como o
//  saldo se gasta. O NEXUS só faz seis coisas, e nenhuma delas é opinar:
//    1. lê o evento real do funcionário (falta, meta, advertência, treino…);
//    2. compara com a condição que A EMPRESA configurou;
//    3. credita a quantidade de pontos que A EMPRESA configurou;
//    4. guarda o histórico;
//    5. calcula o saldo;
//    6. deixa o saldo ser gasto nas recompensas que A EMPRESA cadastrou.
//
//  POR QUE NÃO HÁ VALOR PADRÃO NESTE ARQUIVO
//  -------------------------------------------
//  Um `pontos: 10` aqui seria uma política do NEXUS valendo para toda empresa
//  que usa o sistema — exatamente o que este ciclo veio desfazer. Por isso os
//  campos de valor e pontos são obrigatórios na criação e a empresa nasce com
//  ZERO critérios: sem configuração, nada é creditado, e a tela diz isso.
//
//  A TABELA É POR EMPRESA
//  ---------------------
//  `empresaId` está em todas as consultas, e os dois índices começam por ele.
//  Duas empresas podem ter exatamente os mesmos nomes de critério com valores
//  completamente diferentes — e isso é o comportamento correto, não um bug.
//
//  `AvaliacaoCriterio` é o que impede a pontuação de inflar: um critério só
//  credita UMA vez por funcionário por período. Rodar a avaliação dez vezes no
//  mesmo mês continua valendo o mesmo ponto, e a evidência do que foi medido
//  fica congelada na linha — se a falta da empresa mudar depois, o histórico
//  continua dizendo o que o NEXUS viu na apuração.

/// Eventos que o NEXUS consegue VERIFICAR no banco. Não são uma lista de
/// metas: são as perguntas que os dados da empresa permitem responder.
enum EventoPontuacao {
  /// Nenhuma falta registrada no período.
  SEM_FALTA
  /// Nenhum atraso somado no período.
  SEM_ATRASO
  /// Nenhuma advertência no período.
  SEM_ADVERTENCIA
  /// Percentual de uma `Meta` do tipo FUNCIONARIO atingiu o parametro.
  META_BATIDA
  /// Quantos treinamentos o funcionário PRESENDEU no período. O enum
  /// `StatusParticipante` tem PRESENTE/AUSENTE, e nao "CONCLUIDO": o evento
  /// mede presenca, que e o dado que existe de fato.
  TREINAMENTO_PRESENTE
  /// Horas extras somadas no período.
  HORAS_EXTRAS
  /// Valor vendido no período.
  VENDAS_NO_PERIODO
}

/// Como a condição do critério é comparada com o valor medido.
enum OperadorCriterio {
  /// medido == valor  (ex.: 0 faltas)
  IGUAL
  /// medido >= valor (ex.: 100% da meta)
  MAIOR_OU_IGUAL
  /// medido <= valor (ex.: no máximo 2 atrasos)
  MENOR_OU_IGUAL
}

/// Janela em que o critério é medido. Define também a chave de idempotência.
enum PeriodoCriterio {
  MENSAL
  TRIMESTRAL
  ANUAL
}

model CriterioPontuacao {
  id          String           @id @default(cuid())
  empresaId   String
  empresa     Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  /// Nome que A EMPRESA dá ao seu critério. Texto livre: "Zero falta", "Bateu
  /// a meta do trimestre", "Ajudou a equipe" — o NEXUS não padroniza a política.
  nome        String
  descricao   String?
  evento      EventoPontuacao
  operador    OperadorCriterio @default(IGUAL)
  /// Limiar comparado com o valor medido. Significado conforme o evento:
  /// 0 faltas, 100 (percentual), 2 treinamentos, 10 horas…
  valor       Int              @default(0)
  /// Quantos pontos A EMPRESA paga por este critério. Pode ser NEGATIVO: é
  /// assim que uma empresa pune atraso ou advertência sem inventar um segundo
  /// tipo de registro. Zero é válido e significa "criterio de observacao".
  pontos      Int
  periodo     PeriodoCriterio  @default(MENSAL)
  /// `false` desliga o critério sem apagar o histórico já creditado.
  ativo       Boolean          @default(true)
  observacoes String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  avaliacoes AvaliacaoCriterio[]
  /// Pontos que este critério já creditou. `SetNull` no outro lado: apagar o
  /// critério não pode apagar o saldo que ele gerou.
  registros  RegistroGamificacao[]

  @@index([empresaId, ativo])
  @@index([empresaId, evento])
}

model AvaliacaoCriterio {
  id            String            @id @default(cuid())
  empresaId     String
  empresa       Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  criterioId    String
  criterio      CriterioPontuacao @relation(fields: [criterioId], references: [id], onDelete: Cascade)
  funcionarioId String
  /// O que o NEXUS mediu de fato ("faltas=0", "meta=104%"). É a prova de que
  /// o ponto veio de dado real e não de um chute — e fica congelado.
  evidencia     String
  /// Valor medido no momento da apuração, para a tela mostrar o porquê.
  valorMedido   Int               @default(0)
  /// Pontos creditados, congelados. Se a empresa mudar `pontos` no critério
  /// depois, o histórico continua dizendo quanto foi pago naquele dia.
  pontos        Int
  /// Identificador do período ("2026-09", "2026-Q1", "2026"). Entra na chave
  /// de idempotência, e é o que impede o mesmo mês de pagar duas vezes.
  periodo       String
  /// Registro de gamificação gerado por esta avaliação, se houver.
  registroId    String?
  createdAt     DateTime          @default(now())

  /// Um critério credita UMA vez por funcionário por período. Rodar a
  /// avaliação de novo no mesmo mês não soma o mesmo ponto duas vezes.
  @@unique([criterioId, funcionarioId, periodo])
  @@index([empresaId, periodo])
  @@index([empresaId, funcionarioId])
}

model AcaoRadar {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  /// Alerta de origem. Guardamos o código/título para o plano não quebrar se
  /// o alerta for reclassificado depois.
  alertaRef     String
  alertaTitulo  String
  funcionarioId String?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])
  responsavelId String?
  acoes         Json // [{ texto, concluida }]
  prazo         DateTime?    @db.Date
  status        String       @default("ABERTA") // ABERTA, EM_ANDAMENTO, CONCLUIDA, CANCELADA
  observacoes   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([empresaId, status])
  @@index([empresaId, createdAt])
}

// ===========================================================================
//  Ciclo 3 — Liderança Empática (registro de feedback)
// ===========================================================================
//  POR QUE UMA TABELA NOVA E NÃO REAPROVEITAR `RegistroGamificacao`
//  ---------------------------------------------------------------------
//  `RegistroGamificacao` é PLACAR: guarda pontos, a regra que gerou o ponto e o
//  evento de origem. Ele responde "quantos pontos a pessoa tem".
//
//  Feedback de liderança é CONVERSA: precisa guardar o que foi reconhecido, o
//  que precisa desenvolver, o que ficou acordado e QUANDO será revisado. Nada
//  disso cabe em `descricao String` + `pontos Int` — forçar significaria
//  transformar "o gestor conversou com a pessoa" em "+20 pontos", que é o
//  oposto de liderança empática.
//
//  A mesma lógica já valeu para `PlanoDesenvolvimento` e `Treinamento`: cada
//  entidade nova é porque o DOMÍNIO é outro, não porque a anterior estava
//  "ocupada".
//
//  QUEM É "LÍDER" — DECIDIDO COM VOCÊ
//  ---------------------------------
//  Não existe campo `lideranca` no `Funcionario`, e não foi criado um. A
//  liderança é inferida do CARGO, que já existe e já é do gestor. A lista de
//  termos está em `src/modules/rh/lideranca.ts` (`TERMOS_LIDERANCA`) e é
//  VISÍVEL na tela — se ninguém cadastrar o cargo como "Líder", ninguém é
//  considerado líder, e o sistema diz isso em vez de inventar.
//
//  `proximoAcompanhamento` é DATE e não TIMESTAMP pelo mesmo motivo do resto
//  do schema: é o dia do fato, sem hora e sem fuso.

enum TipoFeedback {
  /// Reconhecimento do que foi bem feito.
  POSITIVO
  /// Conversa sobre o que precisa desenvolver.
  DESENVOLVIMENTO
  /// Alinhamento de expectativas e acordos.
  ACORDO
}

enum StatusAcompanhamento {
  PENDENTE
  REALIZADO
  CANCELADO
}

model FeedbackLideranca {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  /// Quem recebeu o feedback.
  funcionarioId String
  funcionario   Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  /// Quem deu o feedback. Coluna escalar, como `AcaoRadar.responsavelId`: o
  /// aplicador é sempre um `Usuario` desta empresa.
  aplicadoPorId String
  data          DateTime     @db.Date
  tipo          TipoFeedback @default(POSITIVO)

  /// Os três blocos que o gestor escreve. `acordos` é o que ficou combinado
  /// — é o campo que diferencia um feedback de um registro de conversa.
  pontosPositivos    String
  pontosADesenvolver String
  acordos            String?

  /// Quando a conversa volta. NULL significa "sem data marcada", que é uma
  /// escolha do gestor — não "esquecido pelo sistema".
  proximoAcompanhamento DateTime?            @db.Date
  status                StatusAcompanhamento @default(PENDENTE)

  /// Data em que o acompanhamento marcado aconteceu.
  realizadoEm DateTime? @db.Date
  observacoes String?
  origem      Origem    @default(MANUAL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([empresaId, data])
  @@index([empresaId, funcionarioId])
  /// A fila de acompanhamento: quem está devendo conversa.
  @@index([empresaId, status, proximoAcompanhamento])
}

// --- FASE 1 PDV PRO - nucleo transacional (append incremental) ---
model VendaPagamento {
  id         String         @id @default(cuid())
  vendaId    String
  venda      Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  empresaId  String
  empresa    Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  forma      FormaPagamento
  valor      Decimal        @db.Decimal(12, 2)
  ordem      Int            @default(1)
  referencia String?
  valorRecebido Decimal? @db.Decimal(12, 2) // PDV: dinheiro entregue pelo cliente
  troco         Decimal? @db.Decimal(12, 2) // PDV: troco devolvido
  status     String         @default("CONFIRMADO")
  createdAt  DateTime       @default(now())

  @@index([vendaId])
  @@index([empresaId, forma])
}

enum StatusReserva {
  ATIVA
  CONVERTIDA
  EXPIRADA
  CANCELADA
}

model EstoqueReserva {
  id         String        @id @default(cuid())
  empresaId  String
  empresa    Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId   String
  produtoId  String
  vendaId    String?
  venda      Venda?        @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  caixaId    String?
  operadorId String?
  quantidade Int
  status     StatusReserva @default(ATIVA)
  expiraEm   DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([empresaId, filialId, produtoId, status])
  @@index([vendaId])
  @@index([expiraEm])
}

enum StatusIdempotencia {
  PROCESSANDO
  CONFIRMADA
  REJEITADA
}

model IdempotencyKey {
  id             String             @id @default(cuid())
  key            String
  empresaId      String
  empresa        Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId       String?
  caixaId        String?
  operadorId     String?
  vendaId        String?
  status         StatusIdempotencia @default(PROCESSANDO)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([empresaId, key])
  @@index([vendaId])
  @@index([caixaId])
}

enum StatusDivergencia {
  ABERTA
  JUSTIFICADA
  RESOLVIDA
}

model DivergenciaCaixa {
  id             String            @id @default(cuid())
  empresaId      String
  empresa        Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  caixaId        String
  caixa          Caixa             @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo           String
  descricao      String
  valorEsperado  Decimal?          @db.Decimal(12, 2)
  valorInformado Decimal?          @db.Decimal(12, 2)
  diferenca      Decimal?          @db.Decimal(12, 2)
  status         StatusDivergencia @default(ABERTA)
  operadorId     String?
  autorizadoPor  String?
  justificativa  String?
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  @@index([caixaId])
  @@index([empresaId, status])
}

// --- Tentativas de login (rate limit persistente no banco) ---
// Armazena cada tentativa de login para aplicar rate limit por IP e por email,
// sobrevivendo a reinícios do servidor e funcionando corretamente atrás de
// proxies (Vercel etc.) graças ao `trustProxy: true` do Fastify.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String // IP real do cliente (extraído de X-Forwarded-For com trustProxy)
  email     String? // email informado no corpo da requisição (pode ser null)
  sucesso   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@index([createdAt]) // varredura do monitor de segurança (logins falhos recentes)
}

// --- Rate limit distribuído (janela fixa) ---
// Um contador por (chave, início da janela), incrementado de forma atômica
// (INSERT ... ON CONFLICT). Compartilhado por todas as instâncias do backend e
// preservado entre reinícios. Sem dados de empresa: acesso só em escopo de sistema (RLS).
model RateLimitJanela {
  chave        String
  janelaInicio DateTime
  contador     Int      @default(1)
  expiraEm     DateTime

  @@id([chave, janelaInicio])
  @@index([expiraEm])
}

// --- Trava de tarefas agendadas entre instâncias ---
// Garante que uma tarefa diária (snapshot de estoque, fechamento de expediente)
// rode uma única vez por dia mesmo com várias instâncias do backend.
model TarefaAgendada {
  nome             String    @id
  ultimoDia        String? // AAAA-MM-DD (UTC) da última execução reivindicada
  leaseExpiraEm    DateTime?
  instancia        String?
  ultimaExecucaoEm DateTime?
  ultimoSucessoEm  DateTime?
  ultimoErro       String?
  updatedAt        DateTime  @updatedAt
}

// --- Se+ï¿½ï¿½o 17: NexusErpRecord ---
// Modelo de registros empresariais do pacote Enterprise (aprovacoes, notas fiscais, etc.)
model NexusErpRecord {
  id          String    @id @default(cuid())
  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  module      String
  title       String
  status      String    @default("rascunho")
  data        Json
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // // approvals NexusErpApproval (comentado)[]
  // // auditLogs NexusErpAuditLog (comentado)[]

  @@index([empresaId, module, createdAt])
  @@index([empresaId, status])
  @@index([empresaId, title])
}

// ============================================================================
// Módulo Produtos (ERP) — 2026-11-21
// ============================================================================

// Dados fiscais do produto (1:1). O NCM continua em Produto.ncm (não duplicado).
// Nenhuma alíquota é presumida: tudo é informado pelo usuário e validado no formato.
model ProdutoFiscal {
  id                      String   @id @default(cuid())
  empresaId               String
  empresa                 Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  produtoId               String   @unique
  produto                 Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  origemMercadoria        Int? // 0 a 8 (tabela de origem da NF-e)
  cest                    String?
  cfopEntrada             String?
  cfopSaida               String?
  cstIcms                 String? // regime normal
  csosn                   String? // Simples Nacional
  aliquotaIcms            Decimal? @db.Decimal(7, 4)
  reducaoBaseIcms         Decimal? @db.Decimal(7, 4)
  cstPis                  String?
  aliquotaPis             Decimal? @db.Decimal(7, 4)
  cstCofins               String?
  aliquotaCofins          Decimal? @db.Decimal(7, 4)
  cstIpi                  String?
  aliquotaIpi             Decimal? @db.Decimal(7, 4)
  codigoEnquadramentoIpi  String?
  cstIbsCbs               String? // reforma tributária (LC 214/2025)
  classificacaoTributaria String? // cClassTrib
  aliquotaIbs             Decimal? @db.Decimal(7, 4)
  aliquotaCbs             Decimal? @db.Decimal(7, 4)
  naturezaOperacao        String?
  informacoesAdicionais   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([empresaId])
}

// Códigos de identificação do produto (vários por produto, únicos por empresa).
// O código principal continua espelhado em Produto.codigoBarras (compatibilidade com o PDV offline).
model ProdutoCodigoBarras {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  codigo    String
  tipo      String // EAN13 | EAN8 | GTIN14 | UPCA | INTERNO | BALANCA
  principal Boolean  @default(false)
  descricao String?
  createdAt DateTime @default(now())

  @@unique([empresaId, codigo])
  @@index([empresaId, produtoId])
}

// Histórico de alterações de preço e custo (quem, quando, de quanto para quanto, por quê).
model ProdutoPrecoHistorico {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  filialId      String?
  filial        Filial?  @relation(fields: [filialId], references: [id], onDelete: Restrict)
  campo         String // PRECO_VENDA | CUSTO | PRECO_COMPRA | TABELA_A | TABELA_B | TABELA_C | PRECO_FILIAL
  valorAnterior Decimal? @db.Decimal(14, 6)
  valorNovo     Decimal? @db.Decimal(14, 6)
  usuarioId     String?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  justificativa String?
  origem        String   @default("MANUAL")
  createdAt     DateTime @default(now())

  @@index([empresaId, produtoId, createdAt])
}

// Vínculo e configuração do produto por filial. Sem linha = vinculado com os padrões do produto.
model ProdutoFilial {
  id              String   @id @default(cuid())
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  produtoId       String
  produto         Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  filialId        String
  filial          Filial   @relation(fields: [filialId], references: [id], onDelete: Restrict)
  ativo           Boolean  @default(true) // false = produto desvinculado/inativo nesta filial
  disponivelVenda Boolean  @default(true)
  precoVenda      Decimal? @db.Decimal(10, 2) // sobrepõe Produto.precoVenda nesta filial
  custo           Decimal? @db.Decimal(14, 6) // custo informado para a filial (informativo)
  estoqueMinimo   Decimal? @db.Decimal(14, 3)
  estoqueMaximo   Decimal? @db.Decimal(14, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([produtoId, filialId])
  @@index([empresaId, filialId])
}

// --- Central de Integrações (Fase B): mensagens do WhatsApp Business -------------
// Uma linha por mensagem enviada pelo NEXUS OS ou recebida pelo webhook da Meta.
// `waMessageId` (wamid) é único por empresa: webhooks repetidos não duplicam nada.
// `conteudo` guarda só o texto/resumo (até 1000 caracteres) — nunca token ou mídia.
model WhatsappMensagem {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  direcao       String // ENVIADA | RECEBIDA
  telefone      String // destinatário (enviada) ou remetente (recebida), só dígitos
  nomeContato   String?
  tipo          String // text | template | document | image | audio | ...
  conteudo      String?
  waMessageId   String?
  status        String // ENVIANDO | ENVIADA | ENTREGUE | LIDA | FALHOU | RECEBIDA
  erro          String?
  origem        String   @default("CENTRAL") // CENTRAL | WEBHOOK | módulo que enviou
  // LGPD: base do envio. CLIENTE_INICIOU (o contato escreveu antes), DECLARADO (o usuário
  // confirmou que o contato autorizou), FORNECEDOR (comunicação comercial B2B), RECEBIDA.
  consentimento String?
  usuarioId     String?
  createdAt     DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@unique([empresaId, waMessageId])
  @@index([empresaId, createdAt])
}

// --- Central de Integrações (Fase B): e-mails enviados pela conta da empresa -------
// Sem corpo nem anexos: só destinatários, assunto, status e o Message-ID do servidor.
model EmailEnvio {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  para      String
  assunto   String
  anexos    Int      @default(0)
  status    String // ENVIADO | FALHOU
  erro      String?
  messageId String?
  origem    String   @default("CENTRAL")
  usuarioId String?
  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
}

// --- LGPD: contatos que pediram para NÃO receber mensagens do WhatsApp ------------
// Entra quando o contato responde SAIR/PARAR/STOP (webhook) ou manualmente; sai com VOLTAR.
// Nenhum envio (Central, Compras) vai para um número desta lista.
model WhatsappDescadastro {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  telefone  String
  origem    String // PALAVRA_CHAVE | MANUAL
  createdAt DateTime @default(now())

  @@unique([empresaId, telefone])
}

// ============================================================================
// NEXUS AI — Fase 01 (fundação). Domínio próprio da inteligência; o PostgreSQL
// continua sendo a fonte da verdade dos dados de negócio. Tudo por empresa (RLS).
// ============================================================================

// Conversa na Central NEXUS AI (substitui gradualmente ConversaIA, que é mantida).
model AIConversa {
  id        String       @id @default(cuid())
  empresaId String
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarioId String
  titulo    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  mensagens AIMensagem[]

  @@index([empresaId, usuarioId, updatedAt])
}

model AIMensagem {
  id         String     @id @default(cuid())
  empresaId  String
  conversaId String
  conversa   AIConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  papel      String // USUARIO | NEXUS
  conteudo   String     @db.Text
  execucaoId String?
  // Fontes, período, limitações e verificação dos números (só nas respostas da NEXUS).
  detalhes   Json?
  createdAt  DateTime   @default(now())

  @@index([empresaId, conversaId, createdAt])
}

// Uma investigação (pergunta do usuário ou evento). Guarda cada etapa para poder
// RETOMAR depois de falha do provedor sem refazer o que já foi feito.
model AIExecucao {
  id                  String                 @id @default(cuid())
  empresaId           String
  empresa             Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarioId           String?
  conversaId          String?
  agente              String
  // Investigação do NEXUS BRAIN que acionou esta (especialista consultado); nulo = investigação principal.
  execucaoPaiId       String?
  origem              String                 @default("PERGUNTA") // PERGUNTA | EVENTO | AGENDADO | SUBAGENTE
  entrada             String                 @db.Text
  status              String // EXECUTANDO | CONCLUIDA | FALHOU | AGUARDANDO_PROVEDOR | LIMITE | BLOQUEADA
  etapas              Json? // histórico de passos (chamadas de ferramenta e resultados) para retomada
  resposta            String?                @db.Text
  verificacao         Json? // resultado do verificador de números
  erro                String?
  modelo              String?
  tokensEntrada       Int                    @default(0)
  tokensSaida         Int                    @default(0)
  custoCentavos       Int                    @default(0)
  duracaoMs           Int?
  idempotencyKey      String?
  // Retorno do usuário sobre a resposta (plano 5A.4): CORRETA | INCORRETA, para revisão.
  avaliacao           String?
  avaliacaoComentario String?
  avaliadoPor         String?
  avaliadoEm          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  ferramentas         AIExecucaoFerramenta[]

  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, createdAt])
  @@index([status, updatedAt])
}

model AIExecucaoFerramenta {
  id         String     @id @default(cuid())
  empresaId  String
  execucaoId String
  execucao   AIExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  ferramenta String
  entrada    Json?
  resultado  Json? // resultado estruturado (fonte dos números da resposta)
  ok         Boolean
  erro       String?
  duracaoMs  Int?
  createdAt  DateTime   @default(now())

  @@index([empresaId, execucaoId])
}

// Consumo por empresa e dia (tokens, custo estimado, investigações).
model AIConsumo {
  id            String  @id @default(cuid())
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  dia           String // AAAA-MM-DD (UTC)
  execucoes     Int     @default(0)
  tokensEntrada Int     @default(0)
  tokensSaida   Int     @default(0)
  custoCentavos Int     @default(0)

  @@unique([empresaId, dia])
}

// Limites por empresa (nulo = padrão da plataforma). Bloqueio desliga só a IA.
model AILimite {
  empresaId            String   @id
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  execucoesMes         Int?
  custoMesCentavos     Int?
  bloqueadoManualmente Boolean  @default(false)
  atualizadoEm         DateTime @updatedAt
}

// ============================================================================
// NEXUS AI — Fase 04: memória empresarial, base documental e hierarquia de investigações.
// ============================================================================

// Memória autorizada da empresa (metas, políticas, critérios, decisões). Editável e
// excluível; o conteúdo é DADO para a IA (nunca instrução) e passa pela proteção contra manipulação.
model AIMemoria {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipo      String // META | POLITICA | CRITERIO | PREFERENCIA | DECISAO
  titulo    String
  conteudo  String   @db.Text
  ativa     Boolean  @default(true)
  criadoPor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, ativa])
}

// Base documental (manuais, procedimentos, políticas). Texto dividido em trechos para busca
// contextual (busca de texto do PostgreSQL em português). `modulo` restringe a leitura a quem
// tem <modulo>.visualizar.
model AIDocumento {
  id         String     @id @default(cuid())
  empresaId  String
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  titulo     String
  modulo     String?
  caracteres Int
  criadoPor  String?
  createdAt  DateTime   @default(now())
  trechos    AITrecho[]

  @@index([empresaId])
}

model AITrecho {
  id          String                      @id @default(cuid())
  empresaId   String
  documentoId String
  documento   AIDocumento                 @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  ordem       Int
  texto       String                      @db.Text
  /// Vetor semântico (pgvector, 768 dimensões, gemini-embedding-001). Opcional.
  embedding   Unsupported("vector(768)")?

  @@index([empresaId, documentoId])
}

// --- NEXUS AI — Fase 06: eventos, insights, aprovações e automações ---------------------
// Outbox de eventos de negócio e de segurança. A DETECÇÃO é determinística (regras no código,
// monitor.ts) e grava aqui com chave única por evento; o worker (lease) processa uma única vez,
// cria o Alerta e o insight mesmo com o provedor de IA fora do ar.
model AIEvento {
  id            String    @id @default(cuid())
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipo          String // LOGIN_FALHO | PERMISSAO_ALTERADA | CANCELAMENTOS | AJUSTE_ESTOQUE | INTEGRACAO_FALHA | WEBHOOK_INVALIDO | MANIPULACAO_IA | ANOMALIA
  chave         String // idempotência: o mesmo fato nunca vira dois eventos
  severidade    String    @default("MEDIA") // BAIXA | MEDIA | ALTA | CRITICA
  dados         Json
  status        String    @default("PENDENTE") // PENDENTE | PROCESSANDO | CONCLUIDO | FALHOU
  tentativas    Int       @default(0)
  leaseExpiraEm DateTime?
  instancia     String?
  erro          String?
  processadoEm  DateTime?
  createdAt     DateTime  @default(now())

  @@unique([empresaId, chave])
  @@index([status, leaseExpiraEm])
  @@index([empresaId, createdAt])
}

// Descoberta da IA ou do monitor (ligada ao Alerta). `modulo` restringe a leitura a quem tem
// <modulo>.visualizar. Evidências são os números calculados pelas regras.
model AIInsight {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  eventoId   String?  @unique
  alertaId   String?
  origem     String   @default("MONITOR") // MONITOR | ROTINA | IA
  tipo       String
  modulo     String
  severidade String   @default("MEDIA")
  titulo     String
  descricao  String   @db.Text
  evidencias Json?
  periodo    String?
  status     String   @default("ABERTO") // ABERTO | LIDO | DESCARTADO
  createdAt  DateTime @default(now())

  @@index([empresaId, status, createdAt])
}

// Ação preparada pela IA aguardando decisão humana (nível 2) ou liberada por política (nível 3).
// Aprovar duas vezes não executa duas vezes: a transição PENDENTE→EXECUTANDO é atômica.
model AIAprovacao {
  id             String    @id @default(cuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  acao           String // ex.: criar_compra_rascunho
  titulo         String
  proposta       Json // parâmetros validados da ação
  evidencias     Json?
  impacto        String?
  valorCentavos  Int?
  nivel          Int       @default(2)
  status         String    @default("PENDENTE") // PENDENTE | EXECUTANDO | EXECUTADA | REJEITADA | FALHOU | EXPIRADA
  solicitadoPor  String?
  execucaoId     String?
  insightId      String?
  decididoPor    String? // usuário ou "politica:<acao>"
  decididoEm     DateTime?
  motivo         String?
  resultado      Json?
  erro           String?
  idempotencyKey String
  expiraEm       DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, status, createdAt])
}

// Política de automação controlada (nível 3) por empresa e ação. Desligada por padrão.
model AIAutomacao {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  acao             String
  ativa            Boolean  @default(false)
  valorMaxCentavos Int?
  atualizadoPor    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([empresaId, acao])
}
