  totalPedidos           Int                        @default(0)
  ultimoPedidoAt         DateTime?
  origem                 Origem                     @default(MANUAL)
  produtosVinculados     Produto[]
  compras                Compra[]
  comprasFornecedor      CompraFornecedor[]
  fatoresConversao       FatorConversao[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([empresaId, status])
  @@index([empresaId, categoria])
  @@index([empresaId, uf])
}

// ===== Fornecedores — cadastro completo (2026-11-21) =====

// Vários contatos por fornecedor; no máximo um principal (garantido pelo backend).
model FornecedorContato {
  id           String     @id @default(cuid())
  empresaId    String
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  nome         String
  cargo        String?
  departamento String?
  telefone     String?
  celular      String?
  whatsapp     String?
  email        String?
  principal    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([empresaId, fornecedorId])
}

//
// Produto fornecido (N:N com o catálogo central de Produtos — nenhum produto é duplicado).
// Cada fornecedor tem a própria referência, código e preço para o mesmo produto.
// Remover o vínculo nunca exclui o produto; o histórico de preços fica em FornecedorPrecoHistorico.
// /
model FornecedorProduto {
  id                 String     @id @default(cuid())
  empresaId          String
  empresa            Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedorId       String
  fornecedor         Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto    @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  referencia         String?
  codigoFornecedor   String?
  descricaoComercial String?
  preco              Decimal?   @db.Decimal(14, 6) // preço de custo praticado por este fornecedor
  ultimoPrecoCompra  Decimal?   @db.Decimal(14, 6) // atualizado pelo recebimento de compra
  precoAtualizadoEm  DateTime?
  prazoEntregaDias   Int?
  pedidoMinimo       Decimal?   @db.Decimal(14, 3)
  status             String     @default("ATIVO") // ATIVO | SUSPENSO
  principal          Boolean    @default(false) // espelhado em Produto.fornecedorId
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([fornecedorId, produtoId])
  @@index([empresaId, produtoId])
  @@index([empresaId, fornecedorId])
}

// Histórico de preço por fornecedor e produto (sobrevive à remoção do vínculo).
model FornecedorPrecoHistorico {
  id            String     @id @default(cuid())
  empresaId     String
  empresa       Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedorId  String
  fornecedor    Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto    @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  campo         String // PRECO | ULTIMA_COMPRA
  valorAnterior Decimal?   @db.Decimal(14, 6)
  valorNovo     Decimal?   @db.Decimal(14, 6)
  origem        String     @default("MANUAL") // MANUAL | COMPRA
  documento     String?
  usuarioId     String?
  usuario       Usuario?   @relation("FornecedorPrecoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([empresaId, fornecedorId, produtoId, createdAt])
}

// Documento do fornecedor: metadados aqui, arquivo no storage privado (lib/storage.ts).
model FornecedorDocumento {
  id           String     @id @default(cuid())
  empresaId    String
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  tipo         String // CARTAO_CNPJ | CONTRATO_SOCIAL | CERTIDAO | CONTRATO | TABELA_PRECOS | OUTRO
  nome         String
  arquivoChave String?
  arquivoNome  String?
  contentType  String?
  tamanhoBytes Int?
  validade     DateTime?
  ativo        Boolean    @default(true) // substituído/removido = false (histórico preservado)
  enviadoPorId String?
  enviadoPor   Usuario?   @relation("FornecedorDocumentoEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([empresaId, fornecedorId])
  @@index([empresaId, validade])
}

// Avaliações ao longo do tempo (notas de 1 a 5).
model FornecedorAvaliacao {
  id           String     @id @default(cuid())
  empresaId    String
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  notaGeral    Int
  pontualidade Int?
  qualidade    Int?
  preco        Int?
  comentario   String?
  usuarioId    String?
  usuario      Usuario?   @relation("FornecedorAvaliacaoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([empresaId, fornecedorId, createdAt])
}

// ===== Fornecedores — pedidos de compra por fornecedor (Seção 11 v2) =====
// Uma linha por pedido da aba /fornecedores. `compraId` é extensão do modelo
// do artefato: sem o vínculo com a Compra original não seria possível
// estornar/atualizar o pedido quando a compra muda de status.
model CompraFornecedor {
  id           String     @id @default(cuid())
  empresaId    String
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  compraId     String?    @unique
  valor        Decimal    @db.Decimal(12, 2)
  status       String // Pendente, Entregue, Atrasado
  dataPedido   DateTime   @default(now())
  dataEntrega  DateTime?

  @@index([empresaId, fornecedorId])
  @@index([empresaId, status])
}

// --- Se+ï¿½+ï¿½o 10 Compras ---
// Decis+ï¿½o arquitetural (Fase 3): a filial de destino +ï¿½ definida na CRIA+ï¿½+ï¿½O
// da compra, n+ï¿½o solta no momento do recebimento. Motivo: uma ordem de
// compra real j+ï¿½ nasce sabendo para onde a mercadoria vai (or+ï¿½amento,
// centro de custo, planejamento de estoque da filial); aceitar a filial s+ï¿½
// no recebimento permitiria receber uma compra numa filial diferente da
// planejada sem nenhum registro de que isso +ï¿½ uma exce+ï¿½+ï¿½o. Com
// Compra.filialId fixo, POST /compras/:id/receber deixa de aceitar
// filialId no corpo e usa sempre compra.filialId ï¿½ï¿½ï¿½ imposs+ï¿½vel divergir.
model Compra {
  id                     String              @id @default(cuid())
  empresaId              String
  empresa                Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId               String
  filial                 Filial              @relation(fields: [filialId], references: [id])
  fornecedorId           String
  fornecedor             Fornecedor          @relation(fields: [fornecedorId], references: [id])
  valorTotal             Decimal             @db.Decimal(12, 2)
  status                 StatusCompra        @default(SOLICITADA)
  condPagamento          String?
  dataCompra             DateTime            @default(now())
  dataRecebimento        DateTime?
  origem                 Origem              @default(MANUAL)
  itens                  CompraItem[]
  createdAt              DateTime            @default(now())
  // ---- Módulo Compras completo (2026-11-21). Tudo opcional ou com padrão. ----
  numero                 Int? // sequencial por empresa (exibido como CP-000123), gerado pelo backend
  responsavelId          String?
  responsavel            Usuario?            @relation("CompraResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  previsaoEntrega        DateTime?
  prioridade             String              @default("NORMAL") // BAIXA | NORMAL | ALTA | URGENTE
  observacoes            String? // internas
  observacoesFornecedor  String? // vão no pedido enviado ao fornecedor
  valorProdutos          Decimal?            @db.Decimal(14, 2) // soma dos itens (com desconto do item)
  desconto               Decimal             @default(0) @db.Decimal(14, 2)
  frete                  Decimal             @default(0) @db.Decimal(14, 2)
  outrasDespesas         Decimal             @default(0) @db.Decimal(14, 2)
  formaPagamento         String? // BOLETO | PIX | TRANSFERENCIA | CARTAO | DINHEIRO | OUTRO
  parcelas               Int                 @default(1)
  primeiroVencimento     DateTime?
  contaFinanceira        String?
  centroCusto            String?
  planoContas            String?
  observacoesFinanceiras String?
  aprovadoPorId          String?
  aprovadoPor            Usuario?            @relation("CompraAprovadaPor", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoEm             DateTime?
  enviadoEm              DateTime?
  confirmadoEm           DateTime?
  motivoCancelamento     String?
  criadoPorId            String?
  criadoPor              Usuario?            @relation("CompraCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPorId        String?
  atualizadoPor          Usuario?            @relation("CompraAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  atualizadoEm           DateTime?
  recebimentos           CompraRecebimento[]
  notasFiscais           CompraNotaFiscal[]
  envios                 CompraEnvio[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, filialId])
  @@index([empresaId, status])
}

// Recebimento de mercadoria (pode haver vários por compra: recebimentos parciais).
// SÓ o recebimento confirmado movimenta estoque. A idempotencyKey impede confirmar o mesmo
// recebimento duas vezes (duplo clique, reenvio do navegador).
model CompraRecebimento {
  id              String                  @id @default(cuid())
  empresaId       String
  empresa         Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  compraId        String
  compra          Compra                  @relation(fields: [compraId], references: [id], onDelete: Restrict)
  filialId        String
  numero          Int // 1, 2, 3... dentro da compra
  usuarioId       String?
  usuario         Usuario?                @relation("CompraRecebimentoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  dataRecebimento DateTime                @default(now())
  notaFiscalId    String?
  notaFiscal      CompraNotaFiscal?       @relation(fields: [notaFiscalId], references: [id], onDelete: SetNull)
  observacoes     String?
  valorRecebido   Decimal                 @db.Decimal(14, 2) // valor proporcional ao recebido (base do financeiro)
  idempotencyKey  String
  itens           CompraRecebimentoItem[]
  createdAt       DateTime                @default(now())

  @@unique([empresaId, idempotencyKey])
  @@unique([compraId, numero])
  @@index([empresaId, compraId])
  @@index([empresaId, dataRecebimento])
}

model CompraRecebimentoItem {
  id                 String            @id @default(cuid())
  empresaId          String
  empresa            Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  recebimentoId      String
  recebimento        CompraRecebimento @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)
  compraItemId       String
  compraItem         CompraItem        @relation(fields: [compraItemId], references: [id], onDelete: Restrict)
  produtoId          String
  quantidadeRecebida Decimal           @db.Decimal(14, 3) // aceita, na unidade de compra (entra no estoque)
  quantidadeBase     Decimal           @db.Decimal(14, 3) // convertida para a unidade base do produto
  quantidadeAvariada Decimal           @default(0) @db.Decimal(14, 3) // chegou danificada (não entra)
  quantidadeRecusada Decimal           @default(0) @db.Decimal(14, 3) // recusada na conferência (não entra)
  divergencia        String?

  @@index([empresaId, recebimentoId])
}

// Nota fiscal de entrada vinculada à compra (dados informados/conferidos; XML e DANFE ficam em
// Documento, no storage privado). Nenhum cálculo tributário é feito aqui.
model CompraNotaFiscal {
  id           String              @id @default(cuid())
  empresaId    String
  empresa      Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  compraId     String
  compra       Compra              @relation(fields: [compraId], references: [id], onDelete: Restrict)
  numero       String
  serie        String?
  chaveAcesso  String? // 44 dígitos
  dataEmissao  DateTime?
  dataEntrada  DateTime?
  valorTotal   Decimal?            @db.Decimal(14, 2)
  status       String              @default("REGISTRADA") // REGISTRADA | CONFERIDA | DIVERGENTE
  divergencias String?
  observacoes  String?
  usuarioId    String?
  recebimentos CompraRecebimento[]
  createdAt    DateTime            @default(now())

  @@unique([empresaId, chaveAcesso])
  @@index([empresaId, compraId])
}

// Cada tentativa de envio do pedido ao fornecedor (e-mail ou WhatsApp), com o resultado REAL:
// ENVIADO (provedor aceitou), FALHOU (erro do provedor), NAO_CONFIGURADO (canal sem credencial) ou
// CONVERSA_ABERTA (link wa.me aberto pelo usuário — NÃO significa mensagem entregue).
model CompraEnvio {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  compraId     String
  compra       Compra   @relation(fields: [compraId], references: [id], onDelete: Restrict)
  canal        String // EMAIL | WHATSAPP
  destinatario String
  status       String
  provedor     String?
  provedorId   String? // id da mensagem no provedor, quando houver
  erro         String?
  usuarioId    String?
  createdAt    DateTime @default(now())

  @@index([empresaId, compraId])
}

model CompraItem {
  id                 String                  @id @default(cuid())
  compraId           String
  compra             Compra                  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto                 @relation(fields: [produtoId], references: [id])
  quantidade         Decimal                 @db.Decimal(14, 3) // quantidade na unidade de compra
  unidadeCompra      String? // símbolo da unidade de compra no momento (ex: "saco", "cx", "kg")
  fatorAplicado      Decimal?                @db.Decimal(14, 6) // fator usado para converter para unidade base
  quantidadeBase     Decimal?                @db.Decimal(14, 3) // quantidade convertida para unidade base
  valorUnit          Decimal                 @db.Decimal(14, 6) // preço por unidade de compra
  // Recebimento parcial (2026-11-21): quanto já entrou (unidade de compra), desconto e observação.
  quantidadeRecebida Decimal                 @default(0) @db.Decimal(14, 3)
  desconto           Decimal                 @default(0) @db.Decimal(14, 2) // valor de desconto do item
  observacao         String?
  recebimentos       CompraRecebimentoItem[]
}

// --- Se+ï¿½+ï¿½o 12 Clientes ---
model Cliente {
  id                 String      @id @default(cuid())
  empresaId          String
  empresa            Empresa     @relation(fields: [empresaId], references: [id])
  nome               String
  documento          String?
  telefone           String?
  email              String?
  endereco           String?
  valorTotalComprado Decimal     @default(0) @db.Decimal(12, 2)
  ticketMedio        Decimal     @default(0) @db.Decimal(10, 2)
  ultimaCompra       DateTime?
  frequencia         Int         @default(0)
  status             StatusGeral @default(ATIVO)
  origem             Origem      @default(MANUAL)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  vendas             Venda[]

  @@index([empresaId])
}

// --- PARTE 3: Se+ï¿½+ï¿½o 13 Vendas ---
enum StatusVenda {
  ABERTA
  FINALIZADA
  CANCELADA
  DEVOLVIDA
  ESTORNADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

model Venda {
  id                    String              @id @default(cuid())
  empresaId             String
  empresa               Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId              String
  setorId               String?
  clienteId             String?
  cliente               Cliente?            @relation(fields: [clienteId], references: [id])
  funcionarioId         String? // Usuario que vendeu
  formaPagamento        FormaPagamento      @default(DINHEIRO)
  /// Em quantas parcelas o cliente pagou (1 = à vista). O PDV oferecia 1x a 6x
  /// e o cupom imprimia "3x", mas o número não era gravado em lugar nenhum:
  /// o comprovante do cliente afirmava um parcelamento inexistente no sistema.
  /// NÃO implica receber em N parcelas no financeiro — a receita continua
  /// uma linha pelo total; isto registra o que foi combinado na venda.
  parcelas              Int                 @default(1)
  status                StatusVenda         @default(ABERTA)
  subtotal              Decimal             @db.Decimal(12, 2)
  desconto              Decimal             @default(0) @db.Decimal(12, 2)
  total                 Decimal             @db.Decimal(12, 2)
  origem                Origem              @default(MANUAL)
  pdvId                 String?
  pdvSincronizado       Boolean             @default(false)
  caixaId               String? // PDV: turno de caixa que fechou a venda
  caixa                 Caixa?              @relation(fields: [caixaId], references: [id])
  // FASE 1 PDV PRO — idempotência: mesma key + mesma empresa = mesma operação.
  // Nulo nas vendas antigas; novas vendas PDV devem preencher. O backend impõe
  // unicidade via tabela IdempotencyKey (fonte normativa), este campo é índice auxiliar.
  idempotencyKey        String?
  // FASE 1 PDV PRO — dia operacional da filial (YYYY-MM-DD como Date UTC meia-noite).
  // Derivado de createdAt + Filial.fusoHorario no momento da criação; nunca editado.
  // Backfill cobre vendas antigas; novas vendas sempre preenchem.
  dataOperacional       DateTime?           @db.Date
  troco                 Decimal?            @db.Decimal(10, 2) // troco devolvido ao cliente
  valorRecebido         Decimal?            @db.Decimal(10, 2) // valor pago pelo cliente
  observacao            String?             @db.VarChar(500) // observação livre
  // FASE 1 PDV PRO — desconto com alçada: quem autorizou quando passou do limite do operador.
  descontoAutorizadoPor String?
  motivoDesconto        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  itens                 VendaItem[]
  pagamentos            VendaPagamento[]
  reservas              EstoqueReserva[]
  movimentacoesCaixa    MovimentacaoCaixa[]

  @@index([empresaId, filialId])
  @@index([caixaId])
  @@index([createdAt])
  @@index([empresaId, filialId, dataOperacional])
  @@index([empresaId, idempotencyKey])
}

model VendaItem {
  id             String   @id @default(cuid())
  vendaId        String
  venda          Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId      String
  quantidade     Decimal  @db.Decimal(14, 3) // quantidade na unidade de venda
  unidadeVenda   String? // símbolo da unidade de venda no momento (ex: "UN", "dz", "kg")
  fatorAplicado  Decimal? @db.Decimal(14, 6) // fator usado para converter para unidade base
  quantidadeBase Decimal? @db.Decimal(14, 3) // quantidade convertida para unidade base (baixa de estoque)
  preco          Decimal  @db.Decimal(10, 2)
  custoUnitario  Decimal  @db.Decimal(10, 2)
  desconto       Decimal  @default(0) @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(12, 2)
  // Venda de KIT: cópia da composição, das quantidades baixadas e dos custos no momento da venda.
  composicaoKit  Json?

  @@index([vendaId])
}

// --- Seï¿½ï¿½o 14 PDV ï¿½ Caixa (turno de operaï¿½ï¿½o de balcï¿½o) ---
enum StatusCaixa {
  ABERTO
  FECHADO
  BLOQUEADO
  EM_FECHAMENTO
  DIVERGENCIA
}

enum TipoMovimentoCaixa {
  ABERTURA
  SANGRIA
  SUPRIMENTO
  VENDA
  ESTORNO
  DEVOLUCAO
  AJUSTE
  FECHAMENTO
}

model Caixa {
  id                   String              @id @default(cuid())
  empresaId            String
  empresa              Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId             String
  filial               Filial              @relation(fields: [filialId], references: [id])
  numero               Int?
  usuarioId            String // operador que abriu o turno
  usuario              Usuario             @relation(fields: [usuarioId], references: [id])
  status               StatusCaixa         @default(ABERTO)
  fundoTroco           Decimal             @default(0) @db.Decimal(12, 2)
  saldo                Decimal             @default(0) @db.Decimal(12, 2) // dinheiro em gaveta: fundo + suprimentos + vendas DINHEIRO - sangrias
  abertoEm             DateTime            @default(now())
  fechadoEm            DateTime?
  valorContado         Decimal?            @db.Decimal(12, 2)
  diferenca            Decimal?            @db.Decimal(12, 2) // contado - esperado
  observacaoFechamento String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  vendas               Venda[]
  movimentacoes        MovimentacaoCaixa[]
  divergencias         DivergenciaCaixa[]

  @@unique([filialId, numero])
  @@index([empresaId, filialId])
  @@index([usuarioId, status])
}

model MovimentacaoCaixa {
  id        String             @id @default(cuid())
  caixaId   String
  caixa     Caixa              @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  vendaId   String?
  venda     Venda?             @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  tipo      TipoMovimentoCaixa
  valor     Decimal            @db.Decimal(12, 2)
  motivo    String?
  usuarioId String
  origem    Origem             @default(MANUAL)
  autorizadoPorId String? // supervisor que autorizou (sangria / estorno no PDV)
  createdAt DateTime           @default(now())

  @@index([caixaId])
}

// PDV: item retirado do carrinho depois de lançado (com autorização do supervisor).
// Trilha contra fraude e linha do relatório de fechamento.
model ItemCanceladoPdv {
  id              String   @id @default(cuid())
  empresaId       String
  caixaId         String
  usuarioId       String
  autorizadoPorId String?
  produtoId       String
  produtoNome     String
  quantidade      Decimal  @db.Decimal(14, 3)
  valorUnitario   Decimal  @db.Decimal(12, 2)
  valorTotal      Decimal  @db.Decimal(12, 2)
  motivo          String
  createdAt       DateTime @default(now())

  @@index([empresaId, caixaId])
}

// ============================================================================
// Etapas 2-9 — Unidades, tipos de produto, conversões e custos
// ============================================================================

enum DimensaoTipo {
  MASSA
  VOLUME
  CONTAGEM
  COMPRIMENTO
  EMBALAGEM
}

enum TipoProdutoEnum {
  MERCADORIA
  INSUMO
  FABRICADO
  USO_INTERNO
  MATERIA_PRIMA // matéria-prima (entra na fabricação)
  PRODUTO_ACABADO // produto acabado de fabricação própria
  SERVICO // serviço (sem controle de estoque)
  KIT // kit: vendido como um produto; a venda baixa os componentes da composição
  FABRICA // fábrica
  NAO_CLASSIFICADO // não classificado
}

enum PoliticaCusto {
  ULTIMO_CUSTO
  MEDIO_PONDERADO
  PADRAO
}

model Dimensao {
  id        String    @id @default(cuid())
  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nome      String // ex: Massa, Volume, Contagem, Comprimento, Embalagem
  codigo    String // ex: MASSA, VOLUME, CONTAGEM, COMPRIMENTO, EMBALAGEM
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  unidades  Unidade[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model Unidade {
  id                 String           @id @default(cuid())
  empresaId          String
  empresa            Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  dimensaoId         String
  dimensao           Dimensao         @relation(fields: [dimensaoId], references: [id])
  nome               String // ex: Kilograma, Grama, Litro, Mililitro, Unidade, Duzia, Caixa
  simbolo            String // ex: kg, g, L, mL, UN, dz, cx
  fatorCanonico      Decimal          @db.Decimal(14, 6) // quanto vale 1 desta unidade na unidade canônica da dimensão
  ativo              Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  produtosBase       Produto[]        @relation("ProdutoUnidadeBase")
  fatoresOrigem      FatorConversao[] @relation("FatorConversaoOrigem")
  fatoresDestino     FatorConversao[] @relation("FatorConversaoDestino")
  consumosInternos   ConsumoInterno[]
  produtosCompra     Produto[]        @relation("ProdutoUnidadeCompra")
  produtosVenda      Produto[]        @relation("ProdutoUnidadeVenda")
  produtosTributavel Produto[]        @relation("ProdutoUnidadeTributavel")
  composicoesKit     ComposicaoKit[]

  @@unique([empresaId, simbolo])
  @@index([empresaId, dimensaoId])
}

model TipoProduto {
  id        String          @id @default(cuid())
  empresaId String
  empresa   Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nome      String // ex: Mercadoria para Revenda, Insumo, Produto Fabricado, Material de Uso Interno
  codigo    TipoProdutoEnum
  descricao String?
  ativo     Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  produtos  Produto[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model FatorConversao {
  id               String      @id @default(cuid())
  empresaId        String
  empresa          Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  produtoId        String
  produto          Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  unidadeOrigemId  String
  unidadeOrigem    Unidade     @relation("FatorConversaoOrigem", fields: [unidadeOrigemId], references: [id])
  unidadeDestinoId String
  unidadeDestino   Unidade     @relation("FatorConversaoDestino", fields: [unidadeDestinoId], references: [id])
  fornecedorId     String?
  fornecedor       Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  fator            Decimal     @db.Decimal(14, 6) // 1 unidadeOrigem = fator unidadeDestino
  vigenciaDe       DateTime?
  vigenciaAte      DateTime?
  ativo            Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([empresaId, produtoId])
  @@index([empresaId, unidadeOrigemId, unidadeDestinoId])
  @@index([empresaId, produtoId, fornecedorId])
}

model ConsumoInterno {
  id             String    @id @default(cuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId       String
  filial         Filial    @relation(fields: [filialId], references: [id])
  produtoId      String
  produto        Produto   @relation(fields: [produtoId], references: [id])
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  quantidade     Decimal   @db.Decimal(14, 3) // na unidade de consumo
  unidadeId      String
  unidade        Unidade   @relation(fields: [unidadeId], references: [id])
  quantidadeBase Decimal   @db.Decimal(14, 3) // convertida para unidade base
  fatorAplicado  Decimal   @db.Decimal(14, 6)
  custoUnitario  Decimal   @db.Decimal(14, 6) // custo por unidade base no momento
  custoTotal     Decimal   @db.Decimal(14, 2)
  motivo         String // motivo obrigatório do consumo
  aprovadoPorId  String? // aprovação quando exigida por política
  aprovadoPor    Usuario?  @relation("ConsumoInternoAprovador", fields: [aprovadoPorId], references: [id])
  aprovadoEm     DateTime?
  documento      String?
  origem         Origem    @default(MANUAL)
  createdAt      DateTime  @default(now())

  @@index([empresaId, filialId])
  @@index([empresaId, produtoId])
  @@index([createdAt])
}

// --- Se+ï¿½+ï¿½o 14 PDV - Integra+ï¿½+ï¿½o oficial ---
enum StatusIntegracao {
  CONECTADO
  ATENCAO
  ERRO
  NAO_CONFIGURADO
}

model IntegracaoPDV {
  id                   String           @id @default(cuid())
  empresaId            String
  empresa              Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nome                 String // ex: PDV Principal
  tipo                 String // API_OFICIAL, SDK_OFICIAL, WEBHOOK_OFICIAL, BANCO_AUTORIZADO
  url                  String?
  status               StatusIntegracao @default(NAO_CONFIGURADO)
  ultimaSincronizacao  DateTime?
  proximaSincronizacao DateTime?
  qtdRegistros         Int              @default(0)
  erros                Json? // array de erros
  historico            Json? // array historico
  origem               Origem           @default(INTEGRACAO)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([empresaId])
}

// --- Se+ï¿½+ï¿½o 15 Financeiro ---
enum TipoFinanceiro {
  RECEITA
  DESPESA
}

enum StatusFinanceiro {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

model Financeiro {
  id                 String           @id @default(cuid())
  empresaId          String
  empresa            Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId           String?
  tipo               TipoFinanceiro
  categoria          String // vendas, fornecedores, salarios, servi+ï¿½os, impostos, operacionais
  centroCusto        String?
  descricao          String
  valor              Decimal          @db.Decimal(12, 2)
  vencimento         DateTime?
  status             StatusFinanceiro @default(PENDENTE)
  vendaId            String? // link com venda quando for receita de venda
  compraId           String?
  origem             Origem           @default(MANUAL)
  // Cobrança externa (Central de Integrações, Fase C2): Asaas (boleto/PIX) ou Mercado Pago
  // (link de pagamento). A baixa automática só acontece depois de consultar o pagamento
  // na API do provedor com as credenciais da própria empresa.
  cobrancaProvedor   String? // ASAAS | MERCADO_PAGO
  cobrancaId         String? // id da cobrança (Asaas) ou da preferência (Mercado Pago)
  cobrancaUrl        String? // link de pagamento para o cliente
  cobrancaStatus     String? // último status informado pelo provedor
  pagamentoExternoId String? // id do pagamento confirmado no provedor
  pagoEm             DateTime?
  createdAt          DateTime         @default(now())

  @@index([empresaId, tipo])
