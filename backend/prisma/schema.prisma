  /// Comprovante em PDF, referÃƒÆ’Ã‚Âªncia a `Documento` (bucket). NULL atÃƒÆ’Ã‚Â© o anexo.
  documentoId   String?
  documento     Documento?          @relation(fields: [documentoId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([empresaId, folhaId])
  @@index([funcionarioId, status])
}

/// 13Ãƒâ€šÃ‚Âº salary: controle por ano-calendÃƒÆ’Ã‚Â¡rio, com parcelas e proporcionalidade.
model DecimoTerceiro {
  id            String   @id @default(cuid())
