//  Ciclo 3 ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â LideranÃƒÆ’Ã‚Â§a EmpÃƒÆ’Ã‚Â¡tica (registro de feedback)
// ===========================================================================
//  POR QUE UMA TABELA NOVA E NÃƒÆ’Ã†â€™O REAPROVEITAR `RegistroGamificacao`
//  ---------------------------------------------------------------------
//  `RegistroGamificacao` ÃƒÆ’Ã‚Â© PLACAR: guarda pontos, a regra que gerou o ponto e o
//  evento de origem. Ele responde "quantos pontos a pessoa tem".
//
//  Feedback de lideranÃƒÆ’Ã‚Â§a ÃƒÆ’Ã‚Â© CONVERSA: precisa guardar o que foi reconhecido, o
//  que precisa desenvolver, o que ficou acordado e QUANDO serÃƒÆ’Ã‚Â¡ revisado. Nada
//  disso cabe em `descricao String` + `pontos Int` ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â forÃƒÆ’Ã‚Â§ar significaria
//  transformar "o gestor conversou com a pessoa" em "+20 pontos", que ÃƒÆ’Ã‚Â© o
//  oposto de lideranÃƒÆ’Ã‚Â§a empÃƒÆ’Ã‚Â¡tica.
//
//  A mesma lÃƒÆ’Ã‚Â³gica jÃƒÆ’Ã‚Â¡ valeu para `PlanoDesenvolvimento` e `Treinamento`: cada
//  entidade nova ÃƒÆ’Ã‚Â© porque o DOMÃƒÆ’Ã‚ÂNIO ÃƒÆ’Ã‚Â© outro, nÃƒÆ’Ã‚Â£o porque a anterior estava
//  "ocupada".
//
//  QUEM ÃƒÆ’Ã¢â‚¬Â° "LÃƒÆ’Ã‚ÂDER" ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â DECIDIDO COM VOCÃƒÆ’Ã…Â 
//  ---------------------------------
//  NÃƒÆ’Ã‚Â£o existe campo `lideranca` no `Funcionario`, e nÃƒÆ’Ã‚Â£o foi criado um. A
//  lideranÃƒÆ’Ã‚Â§a ÃƒÆ’Ã‚Â© inferida do CARGO, que jÃƒÆ’Ã‚Â¡ existe e jÃƒÆ’Ã‚Â¡ ÃƒÆ’Ã‚Â© do gestor. A lista de
//  termos estÃƒÆ’Ã‚Â¡ em `src/modules/rh/lideranca.ts` (`TERMOS_LIDERANCA`) e ÃƒÆ’Ã‚Â©
//  VISÃƒÆ’Ã‚ÂVEL na tela ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â se ninguÃƒÆ’Ã‚Â©m cadastrar o cargo como "LÃƒÆ’Ã‚Â­der", ninguÃƒÆ’Ã‚Â©m ÃƒÆ’Ã‚Â©
//  considerado lÃƒÆ’Ã‚Â­der, e o sistema diz isso em vez de inventar.
//
//  `proximoAcompanhamento` ÃƒÆ’Ã‚Â© DATE e nÃƒÆ’Ã‚Â£o TIMESTAMP pelo mesmo motivo do resto
//  do schema: ÃƒÆ’Ã‚Â© o dia do fato, sem hora e sem fuso.

enum TipoFeedback {
  /// Reconhecimento do que foi bem feito.
  POSITIVO
  /// Conversa sobre o que precisa desenvolver.
  DESENVOLVIMENTO
  /// Alinhamento de expectativas e acordos.
  ACORDO
}

enum StatusAcompanhamento {
  PENDENTE
  REALIZADO
  CANCELADO
}

model FeedbackLideranca {
  id            String   @id @default(cuid())
  empresaId     String
  /// Quem recebeu o feedback.
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  /// Quem deu o feedback. Coluna escalar, como `AcaoRadar.responsavelId`: o
  /// aplicador ÃƒÆ’Ã‚Â© sempre um `Usuario` desta empresa.
  aplicadoPorId String
  data          DateTime @db.Date
  tipo          TipoFeedback @default(POSITIVO)

  /// Os trÃƒÆ’Ã‚Âªs blocos que o gestor escreve. `acordos` ÃƒÆ’Ã‚Â© o que ficou combinado
  /// ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â ÃƒÆ’Ã‚Â© o campo que diferencia um feedback de um registro de conversa.
  pontosPositivos    String
  pontosADesenvolver String
  acordos            String?

  /// Quando a conversa volta. NULL significa "sem data marcada", que ÃƒÆ’Ã‚Â© uma
  /// escolha do gestor ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â nÃƒÆ’Ã‚Â£o "esquecido pelo sistema".
  proximoAcompanhamento DateTime? @db.Date
  status         StatusAcompanhamento @default(PENDENTE)

  /// Data em que o acompanhamento marcado aconteceu.
  realizadoEm    DateTime? @db.Date
  observacoes    String?
  origem         Origem    @default(MANUAL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId, data])
  @@index([empresaId, funcionarioId])
  /// A fila de acompanhamento: quem estÃƒÆ’Ã‚Â¡ devendo conversa.
  @@index([empresaId, status, proximoAcompanhamento])
}

// --- FASE 1 PDV PRO - nucleo transacional (append incremental) ---
model VendaPagamento {
  id String @id @default(cuid())
  vendaId String
  venda Venda @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  empresaId String
  forma FormaPagamento
  valor Decimal @db.Decimal(12, 2)
  ordem Int @default(1)
  referencia String?
  status String @default("CONFIRMADO")
  createdAt DateTime @default(now())
  @@index([vendaId])
  @@index([empresaId, forma])
}
enum StatusReserva {
  ATIVA
  CONVERTIDA
  EXPIRADA
  CANCELADA
}
model EstoqueReserva {
  id String @id @default(cuid())
  empresaId String
  filialId String
  produtoId String
  vendaId String?
  venda Venda? @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  caixaId String?
  operadorId String?
  quantidade Int
  status StatusReserva @default(ATIVA)
  expiraEm DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([empresaId, filialId, produtoId, status])
  @@index([vendaId])
  @@index([expiraEm])
}
enum StatusIdempotencia {
  PROCESSANDO
  CONFIRMADA
  REJEITADA
}
model IdempotencyKey {
  id String @id @default(cuid())
  key String
  empresaId String
  filialId String?
  caixaId String?
  operadorId String?
  vendaId String?
  status StatusIdempotencia @default(PROCESSANDO)
  responseStatus Int?
  responseBody Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([empresaId, key])
  @@index([vendaId])
  @@index([caixaId])
}
enum StatusDivergencia {
  ABERTA
  JUSTIFICADA
  RESOLVIDA
}
model DivergenciaCaixa {
  id String @id @default(cuid())
  empresaId String
  caixaId String
  caixa Caixa @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo String
  descricao String
  valorEsperado Decimal? @db.Decimal(12, 2)
  valorInformado Decimal? @db.Decimal(12, 2)
  diferenca Decimal? @db.Decimal(12, 2)
  status StatusDivergencia @default(ABERTA)
  operadorId String?
  autorizadoPor String?
  justificativa String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([caixaId])
  @@index([empresaId, status])
}


// --- Tentativas de login (rate limit persistente no banco) ---
// Armazena cada tentativa de login para aplicar rate limit por IP e por email,
// sobrevivendo a reinÃƒÆ’Ã‚Â­cios do servidor e funcionando corretamente atrÃƒÆ’Ã‚Â¡s de
// proxies (Vercel etc.) graÃƒÆ’Ã‚Â§as ao `trustProxy: true` do Fastify.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String   // IP real do cliente (extraÃƒÆ’Ã‚Â­do de X-Forwarded-For com trustProxy)
  email     String?  // email informado no corpo da requisiÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o (pode ser null)
  sucesso   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

