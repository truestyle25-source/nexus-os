  simbolo        String   // ex: kg, g, L, mL, UN, dz, cx
  fatorCanonico  Decimal  @db.Decimal(14, 6) // quanto vale 1 desta unidade na unidade canÃƒÆ’Ã‚Â´nica da dimensÃƒÆ’Ã‚Â£o
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
