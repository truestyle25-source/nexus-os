generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Origem {
  MANUAL
  IMPORTADO
  API
  AUTOMATICO
  PDV
  PONTO
  INTEGRACAO
  IA
}

enum StatusGeral {
  ATIVO
  INATIVO
  ARQUIVADO
}

enum AcaoAuditoria {
  CRIAR
  EDITAR
  EXCLUIR
  LOGIN
  LOGOUT
  IMPORTAR
  SINCRONIZAR
  ALTERAR_PERMISSAO
  ALTERAR_CONFIG
  EXPORTAR
}

enum TipoMovEstoque {
  ENTRADA
  SAIDA
  AJUSTE
  INVENTARIO
  PERDA
  AVARIA
  TRANSFERENCIA
  DEVOLUCAO
  VENDA
  COMPRA
  PRODUCAO // entrada de produto acabado na produção
  CONSUMO_INSUMO // saída de insumo consumido na produção
  DESCARTE // saída por descarte (vencido, inutilizável)
}

enum StatusCompra {
  SOLICITADA // legado: pedido criado pela tela antiga (equivale a rascunho)
  PEDIDO // confirmado pelo fornecedor
  RECEBIDA // tudo recebido (entrada no estoque feita)
  CANCELADA
  // Fluxo completo (2026-11-21): rascunho → aprovação → envio → confirmação → recebimento → conclusão
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADA
  ENVIADA // enviada ao fornecedor, aguardando confirmação
  PARCIAL // parcialmente recebida
  CONCLUIDA // recebida e encerrada (ou saldo pendente encerrado)
}

model Empresa {
  id                       String                     @id @default(cuid())
  nome                     String
  razaoSocial              String?
  cnpj                     String?                    @unique
  inscricaoEstadual        String?
  responsavelCpf           String?
  responsavelRg            String?
  cep                      String?
  endereco                 String?
  cidade                   String?
  estado                   String?
  // SIMPLES_NACIONAL | SIMPLES_EXCESSO_SUBLIMITE | REGIME_NORMAL — decide CSOSN (Simples) x CST (normal)
  regimeTributario         String?
  // Fuso IANA da empresa. O registro de ponto usa para decidir a que DIA
  // pertence uma marcação: às 23h30 em São Paulo a batida é do dia 27, e o
  // mesmo instante em UTC seria do dia 28. Ausente => `America/Sao_Paulo`.
  fusoHorario              String?                    @default("America/Sao_Paulo")
  status                   StatusGeral                @default(ATIVO)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  origem                   Origem                     @default(MANUAL)
  filiais                  Filial[]
  usuarios                 Usuario[]
  setores                  Setor[]
  produtos                 Produto[]
  fornecedores             Fornecedor[]
  // Compras: quando true, pedido precisa de aprovação (compras.administrar) antes do envio.
  comprasExigeAprovacao    Boolean                    @default(false)
  compraRecebimentos       CompraRecebimento[]
  compraRecebimentoItens   CompraRecebimentoItem[]
  compraNotasFiscais       CompraNotaFiscal[]
  compraEnvios             CompraEnvio[]
  fornecedorContatos       FornecedorContato[]
  fornecedorProdutos       FornecedorProduto[]
  fornecedorPrecos         FornecedorPrecoHistorico[]
  fornecedorDocumentos     FornecedorDocumento[]
  fornecedorAvaliacoes     FornecedorAvaliacao[]
  clientes                 Cliente[]
  assinatura               Assinatura?
  importacoes              Importacao[]
  sincronizacoesML         SincronizacaoTarefa[]
  notificacoesMercadoLivre NotificacaoMercadoLivre[]
  shopeeConexoes           ShopeeConexao[]
  shopeeAutorizacoes       ShopeeOAuthState[]
  producoesKit             ProducaoKit[]
  dimensoes                Dimensao[]
  unidades                 Unidade[]
  tiposProduto             TipoProduto[]
  fatoresConversao         FatorConversao[]
  consumosInternos         ConsumoInterno[]
  nexusErpRecords          NexusErpRecord[]

  // Relações inversas de empresaId (FKs adicionadas em 2026-11-20)
  acaoRadars               AcaoRadar[]
  advertencias             Advertencia[]
  alertas                  Alerta[]
  auditorias               Auditoria[]
  avaliacaoComportamentals AvaliacaoComportamental[]
  avaliacaoCriterios       AvaliacaoCriterio[]
  caixas                   Caixa[]
  cargos                   Cargo[]
  categorias               Categoria[]
  chaveApis                ChaveApi[]
  composicaoKits           ComposicaoKit[]
  compras                  Compra[]
  compraFornecedors        CompraFornecedor[]
  contagemInventarios      ContagemInventario[]
  conversaIAs              ConversaIA[]
  criterioPontuacaos       CriterioPontuacao[]
  dREs                     DRE[]
  decimoTerceiros          DecimoTerceiro[]
  departamentos            Departamento[]
  desligamentos            Desligamento[]
  divergenciaCaixas        DivergenciaCaixa[]
  documentos               Documento[]
  estoques                 Estoque[]
  estoqueMovimentacaos     EstoqueMovimentacao[]
  estoqueReservas          EstoqueReserva[]
  estoqueSnapshotDiarios   EstoqueSnapshotDiario[]
  feedbackLiderancas       FeedbackLideranca[]
  financeiros              Financeiro[]
  folhas                   Folha[]
  funcionarios             Funcionario[]
  idempotencyKeys          IdempotencyKey[]
  indicadorDiarios         IndicadorDiario[]
  integracaoExternos       IntegracaoExterno[]
  integracaoEventos        IntegracaoEvento[]
  whatsappMensagens        WhatsappMensagem[]
  emailEnvios              EmailEnvio[]
  whatsappDescadastros     WhatsappDescadastro[]
  aiConversas              AIConversa[]
  aiExecucoes              AIExecucao[]
  aiConsumos               AIConsumo[]
  aiLimite                 AILimite?
  aiMemorias               AIMemoria[]
  aiDocumentos             AIDocumento[]
  aiEventos                AIEvento[]
  aiInsights               AIInsight[]
  aiAprovacoes             AIAprovacao[]
  aiAutomacoes             AIAutomacao[]
  integracaoPDVs           IntegracaoPDV[]
  integracaoPontos         IntegracaoPonto[]
  lancamentoFolhas         LancamentoFolha[]
  metas                    Meta[]
  notificacaos             Notificacao[]
  pagamentoRHs             PagamentoRH[]
  participanteTreinamentos ParticipanteTreinamento[]
  pesquisaBemEstars        PesquisaBemEstar[]
  pixCobrancas             PixCobranca[]
  pixSettingsLista         PixSettings[]
  planoDesenvolvimentos    PlanoDesenvolvimento[]
  pontos                   Ponto[]
  recompensas              Recompensa[]
  registroGamificacaos     RegistroGamificacao[]
  regraAutomacaos          RegraAutomacao[]
  relatorioGerados         RelatorioGerado[]
  resgateRecompensas       ResgateRecompensa[]
  sessaoInventarios        SessaoInventario[]
  shopeePedidos            ShopeePedido[]
  suspensaos               Suspensao[]
  treinamentos             Treinamento[]
  vendas                   Venda[]
  vendaPagamentos          VendaPagamento[]
  // Módulo Produtos (ERP) — 2026-11-21
  produtosFiscal           ProdutoFiscal[]
  produtosCodigosBarras    ProdutoCodigoBarras[]
  produtosPrecoHistorico   ProdutoPrecoHistorico[]
  produtosFiliais          ProdutoFilial[]
}

// --- Importação de dados (CSV/API) --------------------------------------------
// A tabela existe desde a migration 202609130001_importacao; o model entrou no
// schema na FASE 1 (correção das migrations) para manter paridade total entre
// schema.prisma e a cadeia de migrations (migrate diff vazio).
model Importacao {
  id           String   @id
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipo         String
  status       String
  mapeamento   Json?
  erros        Json?
  qtdTotal     Int      @default(0)
  qtdImportada Int      @default(0)
  qtdErro      Int      @default(0)
  origem       Origem   @default(IMPORTADO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([empresaId, createdAt])
}

model Filial {
  id                   String                  @id @default(cuid())
  empresaId            String
  empresa              Empresa                 @relation(fields: [empresaId], references: [id])
  nome                 String
  cnpj                 String?
  cidade               String?
  estado               String?
  // FASE 1 PDV PRO — fuso IANA da filial. Prevalece sobre Empresa.fusoHorario
  // para data operacional do caixa/vendas. Ausente => America/Sao_Paulo.
  // UTC continua sendo o instante absoluto (createdAt); o fuso só deriva o DIA operacional.
  fusoHorario          String?                 @default("America/Sao_Paulo")
  status               StatusGeral             @default(ATIVO)
  origem               Origem                  @default(MANUAL)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  setores              Setor[]
  usuarios             Usuario[]
  estoques             Estoque[]
  movimentacoesOrigem  EstoqueMovimentacao[]   @relation("MovOrigem")
  movimentacoesDestino EstoqueMovimentacao[]   @relation("MovDestino")
  compras              Compra[]
  snapshotsEstoque     EstoqueSnapshotDiario[]
  caixas               Caixa[]
  producoesKit         ProducaoKit[]
  consumosInternos     ConsumoInterno[]
  sessoesInventario    SessaoInventario[]
  produtosConfig       ProdutoFilial[]
  historicoPrecos      ProdutoPrecoHistorico[]
  fornecedores         Fornecedor[]

  @@index([empresaId])
}

model Setor {
  id        String      @id @default(cuid())
  empresaId String
  filialId  String?
  empresa   Empresa     @relation(fields: [empresaId], references: [id])
  filial    Filial?     @relation(fields: [filialId], references: [id])
  nome      String
  descricao String?
  status    StatusGeral @default(ATIVO)
  origem    Origem      @default(MANUAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  usuarios  Usuario[]

  @@index([empresaId, filialId])
}

model Usuario {
  id                        String                     @id @default(cuid())
  empresaId                 String
  filialId                  String?
  setorId                   String?
  empresa                   Empresa                    @relation(fields: [empresaId], references: [id])
  filial                    Filial?                    @relation(fields: [filialId], references: [id])
  setor                     Setor?                     @relation(fields: [setorId], references: [id])
  nome                      String
  email                     String                     @unique
  senhaHash                 String
  // Tokens emitidos ANTES deste instante são recusados (troca/redefinição de senha encerra todas as sessões).
  sessoesValidasDesde       DateTime?
  status                    StatusGeral                @default(ATIVO)
  origem                    Origem                     @default(MANUAL)
  cargo                     String?
  ultimoLogin               DateTime?
  permissoes                Permissao[]
  caixas                    Caixa[]
  auditorias                Auditoria[]
  documentosEnviados        Documento[]
  folhaFechadaPor           Folha[]
  movimentacoes             EstoqueMovimentacao[]
  tokensRecuperacao         TokenRecuperacaoSenha[]
  fichaFuncionario          Funcionario[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  sessoesInventarioCriou    SessaoInventario[]         @relation("SessaoInventarioCriador")
  sessoesInventarioFechou   SessaoInventario[]         @relation("SessaoInventarioConclusor")
  contagensInventarioFeitas ContagemInventario[]       @relation("ContagemInventarioAutor")
  importacoes               Importacao[]
  shopeeAutorizacoes        ShopeeOAuthState[]
  producoesKit              ProducaoKit[]
  consumosInternos          ConsumoInterno[]
  consumosInternosAprovou   ConsumoInterno[]           @relation("ConsumoInternoAprovador")
  alteracoesPreco           ProdutoPrecoHistorico[]
  fornecedoresComprador     Fornecedor[]               @relation("FornecedorComprador")
  comprasResponsavel        Compra[]                   @relation("CompraResponsavel")
  comprasAprovadas          Compra[]                   @relation("CompraAprovadaPor")
  comprasCriadas            Compra[]                   @relation("CompraCriadaPor")
  comprasAlteradas          Compra[]                   @relation("CompraAtualizadaPor")
  comprasRecebidas          CompraRecebimento[]        @relation("CompraRecebimentoUsuario")
  fornecedoresCriados       Fornecedor[]               @relation("FornecedorCriadoPor")
  fornecedoresAlterados     Fornecedor[]               @relation("FornecedorAtualizadoPor")
  fornecedorPrecosAlterados FornecedorPrecoHistorico[] @relation("FornecedorPrecoUsuario")
  fornecedorDocumentos      FornecedorDocumento[]      @relation("FornecedorDocumentoEnviadoPor")
  fornecedorAvaliacoes      FornecedorAvaliacao[]      @relation("FornecedorAvaliacaoUsuario")

  @@index([empresaId])
}

model Permissao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo    String
  acao      String
  permitido Boolean  @default(false)
  origem    Origem   @default(MANUAL)
  createdAt DateTime @default(now())

  @@unique([usuarioId, modulo, acao])
  @@index([usuarioId])
}

// Se+ï¿½+ï¿½o 5 - recupera+ï¿½+ï¿½o de senha. Armazena apenas o hash do token; o valor
// bruto +ï¿½ entregue uma +ï¿½nica vez ao usu+ï¿½rio pelo canal de envio (e-mail),
// que ainda n+ï¿½o est+ï¿½ integrado nesta base (ver PEND+ï¿½NCIAS no relat+ï¿½rio).
model TokenRecuperacaoSenha {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
}

model Auditoria {
  id            String        @id @default(cuid())
  usuarioId     String?
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id])
  empresaId     String?
  // SetNull: a trilha de auditoria sobrevive à exclusão da empresa.
  empresa       Empresa?      @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  acao          AcaoAuditoria
  entidade      String
  entidadeId    String?
  valorAnterior Json?
  valorNovo     Json?
  origem        Origem
  ip            String?
  contexto      String?
  createdAt     DateTime      @default(now())

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([createdAt])
  @@index([empresaId])
}

// --- PARTE 2: Se+ï¿½+ï¿½o 8 Produtos ---
model Categoria {
  id             String      @id @default(cuid())
  empresaId      String
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nome           String
  descricao      String?
  // Hierarquia: grupo (nível 0) e subgrupos 1, 2 e 3. O produto aponta para a categoria mais específica.
  categoriaPaiId String?
  categoriaPai   Categoria?  @relation("CategoriaHierarquia", fields: [categoriaPaiId], references: [id], onDelete: Restrict)
  subcategorias  Categoria[] @relation("CategoriaHierarquia")
  nivel          Int         @default(0)
  produtos       Produto[]
  createdAt      DateTime    @default(now())

  @@index([empresaId])
}

model Produto {
  id                           String                     @id @default(cuid())
  empresaId                    String
  empresa                      Empresa                    @relation(fields: [empresaId], references: [id])
  categoriaId                  String?
  categoria                    Categoria?                 @relation(fields: [categoriaId], references: [id])
  fornecedorId                 String?
  fornecedor                   Fornecedor?                @relation(fields: [fornecedorId], references: [id])
  tipoProdutoId                String?
  tipoProduto                  TipoProduto?               @relation(fields: [tipoProdutoId], references: [id])
  unidadeBaseId                String?
  unidadeBase                  Unidade?                   @relation("ProdutoUnidadeBase", fields: [unidadeBaseId], references: [id])
  politicaCusto                PoliticaCusto              @default(MEDIO_PONDERADO)
  nome                         String
  marca                        String?
  sku                          String?
  codigoBarras                 String?
  custo                        Decimal                    @db.Decimal(14, 6)
  precoVenda                   Decimal                    @db.Decimal(10, 2)
  margem                       Decimal?                   @db.Decimal(5, 2) // calculada: (preco-custo)/preco*100
  unidade                      String                     @default("UN") // unidade legado — mantida para compatibilidade de leitura antiga
  estoqueMinimo                Decimal                    @default(5) @db.Decimal(14, 3)
  estoqueMaximo                Decimal                    @default(100) @db.Decimal(14, 3)
  pontoPedido                  Decimal                    @default(0) @db.Decimal(14, 3)
  peso                         String?
  ncm                          String?
  precoPromocional             Decimal?                   @db.Decimal(10, 2)
  promocaoInicio               DateTime?
  promocaoFim                  DateTime?
  promocaoLimite               Int?
  validade                     DateTime?
  imagem                       String?
  descricao                    String?
  status                       StatusGeral                @default(ATIVO)
  ehKit                        Boolean                    @default(false)
  // ---- Cadastro ERP (2026-11-21). Todos opcionais ou com padrão: nenhum dado existente muda. ----
  referencia                   String?
  descricaoResumida            String?
  fabricante                   String?
  codigoExterno                String?
  unidadeCompraId              String?
  unidadeCompra                Unidade?                   @relation("ProdutoUnidadeCompra", fields: [unidadeCompraId], references: [id])
  unidadeVendaId               String?
  unidadeVenda                 Unidade?                   @relation("ProdutoUnidadeVenda", fields: [unidadeVendaId], references: [id])
  unidadeTributavelId          String?
  unidadeTributavel            Unidade?                   @relation("ProdutoUnidadeTributavel", fields: [unidadeTributavelId], references: [id])
  centroCustoVenda             String?
  centroCustoContabil          String?
  quantidadeEmbalagem          Decimal?                   @db.Decimal(14, 3)
  diasValidade                 Int?
  // Parâmetros
  embalagem                    Boolean                    @default(false)
  vendaFracionada              Boolean                    @default(false)
  controlaBalanca              Boolean                    @default(false)
  enviaCozinha                 Boolean                    @default(false)
  produtoGlp                   Boolean                    @default(false)
  imprimeFichaExpedicao        Boolean                    @default(false)
  // Estoque
  controlaEstoque              Boolean                    @default(true)
  permiteEstoqueNegativo       Boolean                    @default(false)
  permiteTransferenciaNegativa Boolean                    @default(false)
  controlaValidade             Boolean                    @default(false)
  controlaLote                 Boolean                    @default(false)
  estoqueSeguranca             Decimal                    @default(0) @db.Decimal(14, 3)
  estoqueIdeal                 Decimal?                   @db.Decimal(14, 3)
  densidade                    Decimal?                   @db.Decimal(14, 6)
  pesoEmbalagem                Decimal?                   @db.Decimal(14, 3)
  // Preços (custo = custo médio/política; os demais são informativos ou tabelas)
  precoCompra                  Decimal?                   @db.Decimal(14, 6)
  ultimoCustoAquisicao         Decimal?                   @db.Decimal(14, 6)
  precoTabelaA                 Decimal?                   @db.Decimal(10, 2)
  precoTabelaB                 Decimal?                   @db.Decimal(10, 2)
  precoTabelaC                 Decimal?                   @db.Decimal(10, 2)
  descontoMaximoPercentual     Decimal?                   @db.Decimal(5, 2)
  comissaoPercentual           Decimal?                   @db.Decimal(5, 2)
  despesasPercentual           Decimal?                   @db.Decimal(5, 2)
  // Premiação (vigência opcional)
  premiacaoPercentual          Decimal?                   @db.Decimal(5, 2)
  premiacaoInicio              DateTime?
  premiacaoFim                 DateTime?
  premiacaoRegra               String?
  // PDV (só o que o PDV atual de fato usa)
  disponivelPdv                Boolean                    @default(true)
  posicaoPdv                   Int?
  fiscal                       ProdutoFiscal?
  codigosBarras                ProdutoCodigoBarras[]
  historicoPrecos              ProdutoPrecoHistorico[]
  filiaisConfig                ProdutoFilial[]
  origem                       Origem                     @default(MANUAL)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  estoques                     Estoque[]
  movimentacoes                EstoqueMovimentacao[]
  snapshotsEstoque             EstoqueSnapshotDiario[]
  comprasItens                 CompraItem[]
  composicaoComoKit            ComposicaoKit[]            @relation("KitProduto")
  composicaoComoIngrediente    ComposicaoKit[]            @relation("IngredienteProduto")
  movimentacoesComoKit         EstoqueMovimentacao[]      @relation("MovimentacaoKit")
  fornecedoresVinculo          FornecedorProduto[]
  fornecedorPrecos             FornecedorPrecoHistorico[]
  producoesKit                 ProducaoKit[]
  consumosInternos             ConsumoInterno[]
  fatoresConversao             FatorConversao[]

  @@unique([empresaId, sku])
  @@unique([empresaId, codigoBarras])
  @@index([empresaId])
  @@index([sku])
  @@index([empresaId, tipoProdutoId])
  @@index([empresaId, referencia])
}

model ComposicaoKit {
  id                   String   @id @default(cuid())
  empresaId            String
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  kitProdutoId         String
  ingredienteProdutoId String
  quantidadePorKit     Decimal  @db.Decimal(12, 3) // quantidade por kit na UNIDADE BASE do componente (é o que baixa do estoque)
  // Composição informada pelo usuário (2026-11-21): quantidade na unidade escolhida (ex.: 500 g de um insumo em kg).
  // Nulos nas linhas antigas = a quantidade foi informada direto na unidade base.
  unidadeId            String?
  unidade              Unidade? @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  quantidade           Decimal? @db.Decimal(14, 6)
  ordem                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  kitProduto           Produto  @relation("KitProduto", fields: [kitProdutoId], references: [id], onDelete: Cascade)
  ingredienteProduto   Produto  @relation("IngredienteProduto", fields: [ingredienteProdutoId], references: [id], onDelete: Restrict)

  @@unique([kitProdutoId, ingredienteProdutoId])
  @@index([empresaId, kitProdutoId])
  @@index([empresaId, ingredienteProdutoId])
}

model ProducaoKit {
  id                  String   @id @default(cuid())
  empresaId           String
  filialId            String
  produtoKitId        String
  usuarioId           String?
  quantidade          Decimal  @db.Decimal(14, 3) // quantidade produzida (na unidade de produção)
  unidadeProducao     String? // símbolo da unidade de produção
  fatorAplicado       Decimal? @db.Decimal(14, 6) // fator para converter para unidade base do produto
  quantidadeProduzida Decimal  @db.Decimal(14, 3) // quantidade efetivamente produzida (após perdas)
  perda               Decimal  @default(0) @db.Decimal(14, 3) // perda registrada na produção
  custoUnitario       Decimal  @db.Decimal(14, 6)
  custoTotal          Decimal  @db.Decimal(14, 2)
  composicaoSnapshot  Json // cópia da ficha técnica, fatores e custos da data da produção
  idempotencyKey      String
  createdAt           DateTime @default(now())
  filial              Filial   @relation(fields: [filialId], references: [id], onDelete: Restrict)
  produtoKit          Produto  @relation(fields: [produtoKitId], references: [id], onDelete: Restrict)
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario             Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, produtoKitId, createdAt])
  @@index([filialId, createdAt])
}

// --- Se+ï¿½+ï¿½o 9 Estoque ---
model Estoque {
  id         String               @id @default(cuid())
  empresaId  String
  empresa    Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId   String
  produtoId  String
  produto    Produto              @relation(fields: [produtoId], references: [id])
  filial     Filial               @relation(fields: [filialId], references: [id])
  quantidade Decimal              @default(0) @db.Decimal(14, 3)
  valorTotal Decimal              @default(0) @db.Decimal(14, 2)
  lote       String? // número do lote para controle de validade
  local      String? // local de armazenamento (prateleira, estante, etc.)
  updatedAt  DateTime             @updatedAt
  contagens  ContagemInventario[]

  @@unique([filialId, produtoId])
  @@index([empresaId])
}

// Decis+ï¿½o arquitetural (Fase 3, d+ï¿½vida t+ï¿½cnica registrada em
// DEBITO-TECNICO.md item 8): giro real precisa de estoque m+ï¿½dio no
// per+ï¿½odo, que por sua vez precisa de uma s+ï¿½rie hist+ï¿½rica de saldo di+ï¿½rio
// ï¿½ï¿½ï¿½ a posi+ï¿½+ï¿½o atual (Estoque) e o log de eventos (EstoqueMovimentacao) n+ï¿½o
// bastam sozinhos porque reconstruir o saldo em cada dia passado a partir
// s+ï¿½ do log seria caro de consultar toda vez. Uma linha por
// produto+ï¿½filial+ï¿½dia +ï¿½ o suficiente (n+ï¿½o guarda hist+ï¿½rico de pre+ï¿½o por
// unidade nem lote ï¿½ï¿½ï¿½ isso seria over-engineering para o que a Se+ï¿½+ï¿½o 9
// pede). Alimentada por src/scripts/gerarSnapshotsDiarios.ts (rodado uma
// vez por dia por um agendador externo ï¿½ï¿½ï¿½ este projeto n+ï¿½o inclui um
// scheduler) ou por POST /estoque/snapshot/gerar.
// ===========================================================================
//  Ciclo 6 — Sessão de Inventário
// ===========================================================================
//
//  POR QUE UMA SESSÃO E NÃO UM CAMPO NA FOLHA
//  -----------------------------------------
//  A folha de inventário morre com a tela: fechar o navegador perde a contagem
//  inteira. Um inventário de depósito leva horas ou dias, e a empresa fecha a
//  loja às 18h com metade dela contada. A sessão é o registro que sobrevive ao
//  navegador — reabrir amanhã continua de onde parou.
//
//  O SALDO DO SISTEMA É CONGELADO NA ABERTURA
//  --------------------------------------------
//  `quantidadeSistema` é gravada no momento em que a sessão é criada e nunca
//  muda. Isso não é economia de consulta, é o que dá sentido ao número: se o
//  estoque muda no meio da contagem (uma venda, uma entrada de compra) e a
//  divergência fosse recalculada a cada leitura, o inventário compararia a
//  contagem física com um alvo que se moveu — e acharia desvio onde só houve
//  operação normal. Congelado, a divergência é a diferença entre o que estava
//  lá quando alguém abriu a folha e o que realmente existe.
//
//  A IDENTIFICAÇÃO DO ITEM É COPIADA, NÃO REFERENCIADA
//  ---------------------------------------------------
//  Produto, unidade e local são gravados como texto. Um inventário é documento
//  de trabalho: ele precisa continuar legível depois que o produto foi
//  renomeado ou desativado, e uma linha que vira "null" porque o cadastro
//  mudou é pior que inútil. O `estoqueId` fica só como rastro, e pode sumir.
//
//  VISÃO CEGA FICA REGISTRADA
//  --------------------------
//  `cegas` diz se aquela sessão foi contada sem o saldo visível. Um período
//  depois, o histórico mostra se a contagem foi cega — e o `criadoPorId` diz
//  quem abriu. É a diferença entre "inventário" e "conferência", e precisa ser
//  auditável.

enum StatusSessaoInventario {
  ABERTA
  CONCLUIDA
  CANCELADA
}

model SessaoInventario {
  id             String                 @id @default(cuid())
  empresaId      String
  empresa        Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  /// Rótulo que a empresa dá à contagem ("Inventário 3T2026 — Centro").
  nome           String
  filialId       String
  filial         Filial                 @relation(fields: [filialId], references: [id])
  status         StatusSessaoInventario @default(ABERTA)
  /// `true` quando a folha foi aberta sem o saldo do sistema à vista.
  cegas          Boolean                @default(true)
  /// Quem abriu a folha e quando — a autoria é o que dá valor ao histórico.
  criadoPorId    String?
  criadoPor      Usuario?               @relation("SessaoInventarioCriador", fields: [criadoPorId], references: [id])
  criadoEm       DateTime               @default(now())
  /// Quem fechou a contagem. NULL enquanto a sessão está aberta.
  concluidoPorId String?
  concluidoPor   Usuario?               @relation("SessaoInventarioConclusor", fields: [concluidoPorId], references: [id])
  concluidoEm    DateTime?
  observacoes    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  contagens ContagemInventario[]

  /// Duas folhas abertas na mesma filial transformam uma contagem em duas
  /// versões diferentes do mesmo número.
  @@index([empresaId, status])
  @@index([empresaId, filialId, criadoEm])
}

model ContagemInventario {
  id        String           @id @default(cuid())
  empresaId String
  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sessaoId  String
  sessao    SessaoInventario @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  /// Rastro da linha de estoque contada. `SetNull`: o produto pode ser
  /// desativado ou a linha removida, e a contagem já feita continua valendo.
  estoqueId String?
  estoque   Estoque?         @relation(fields: [estoqueId], references: [id], onDelete: SetNull)

  // Cópia do que foi contado — o inventário precisa continuar legível.
  produtoId         String
  produtoNome       String
  unidade           String?
  local             String?
  /// Saldo do sistema NO MOMENTO DA ABERTURA. Congelado, nunca recalculado.
  quantidadeSistema Decimal   @db.Decimal(14, 3)
  /// NULL enquanto ninguém contou. É o que distingue "não contado" de
  /// "contado como zero" — os dois sãoZero no papel, e um deles é erro.
  quantidadeContada Decimal?  @db.Decimal(14, 3)
  /// Quem contou este item e quando.
  contadoPorId      String?
  contadoPor        Usuario?  @relation("ContagemInventarioAutor", fields: [contadoPorId], references: [id])
  contadoEm         DateTime?
  observacoes       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([sessaoId, estoqueId])
  @@index([empresaId, sessaoId])
}

// ===========================================================================
//  Snapshot diario de saldo — base do giro real (ver DEBITO-TECNICO.md item 8).
// ===========================================================================

// ===========================================================================
//  Snapshot diario de saldo — base do giro real (ver DEBITO-TECNICO.md item 8).
//  Uma linha por dia, filial e produto: reconstruir o saldo de um dia passado
//  a partir so do log de movimentos seria caro de consultar toda vez.
// ===========================================================================

model EstoqueSnapshotDiario {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filialId      String
  filial        Filial   @relation(fields: [filialId], references: [id])
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id])
  data          DateTime // truncado para 00:00 do dia
  quantidade    Decimal  @db.Decimal(14, 3)
  custoUnitario Decimal  @db.Decimal(14, 6)
  valorTotal    Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  @@unique([filialId, produtoId, data])
  @@index([empresaId, data])
}

model EstoqueMovimentacao {
  id              String         @id @default(cuid())
  empresaId       String
  empresa         Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  produtoId       String
  produto         Produto        @relation(fields: [produtoId], references: [id])
  // Filial onde o efeito de estoque desta linha ocorre. Para TRANSFERENCIA,
  // esta é a filial de ORIGEM (a quantidade sai daqui); filialDestinoId
  // aponta a filial que recebe — uma segunda linha (tipo TRANSFERENCIA,
  // quantidade positiva) é criada na filial de destino, ligada pelo mesmo
  // valor de `documento` (ver estoque.service.ts).
  filialId        String
  filial          Filial         @relation("MovOrigem", fields: [filialId], references: [id])
  filialDestinoId String?
  filialDestino   Filial?        @relation("MovDestino", fields: [filialDestinoId], references: [id])
  usuarioId       String?
  usuario         Usuario?       @relation(fields: [usuarioId], references: [id])
  quantidade      Decimal        @db.Decimal(14, 3) // positivo entrada, negativo saida - mas tipo define
  tipo            TipoMovEstoque
  motivo          String?
  documento       String? // NF, pedido, venda id; para TRANSFERENCIA, agrupa as duas pontas
  origem          Origem
  // Rastreabilidade (2026-11-21): saldo da filial antes e depois, e custo unitário aplicado.
  // Nulos nas movimentações anteriores a esta versão.
  saldoAnterior   Decimal?       @db.Decimal(14, 3)
  saldoPosterior  Decimal?       @db.Decimal(14, 3)
  custoUnitario   Decimal?       @db.Decimal(14, 6)
  // Baixa de componente feita pela venda de um KIT: aponta o kit vendido (origem da movimentação).
  kitProdutoId    String?
  kitProduto      Produto?       @relation("MovimentacaoKit", fields: [kitProdutoId], references: [id], onDelete: SetNull)
  // Entrada gerada pelo recebimento de compra (rastreio pedido → recebimento → movimentação).
  recebimentoId   String?
  createdAt       DateTime       @default(now())

  @@index([empresaId, produtoId])
  @@index([empresaId, filialId])
  @@index([empresaId, kitProdutoId])
  @@index([createdAt])
}

// --- Se+ï¿½+ï¿½o 11 Fornecedores ---
model Fornecedor {
  // v2 (aba /fornecedores — artefato "nexus-fornecedores-add-v2"):
  // - status virou TEXT: o design system exige Ativo/Crítico/Inativo e o enum
  //   StatusGeral não tem "Crítico" (migração converte ATIVO/INATIVO/ARQUIVADO).
  // - cnpjCpf renomeado para cnpj (campo do formulário ADD).
  // - relação Produto[] renomeada para produtosVinculados para liberar o nome
  //   `produtos` do CSV textual ("Camisa, Boné") exigido pelo modal ADD.
  // - categoria com default "Outros" para o POST legado (tela de Compras)
  //   continuar gravando sem enviar a coluna.
  id                     String                     @id @default(cuid())
  empresaId              String
  empresa                Empresa                    @relation(fields: [empresaId], references: [id])
  nome                   String
  cnpj                   String?
  categoria              String                     @default("Outros") // Malharia, Jeans, Bonés, Acessórios, Calçados, Outros
  status                 String                     @default("Ativo") // Ativo, Crítico, Inativo
  contato                String?
  whatsapp               String?
  telefone               String?
  email                  String?
  endereco               String?
  produtos               String? // CSV "Camisa, Boné" — o que o fornecedor fornece
  condicaoPagamento      String? // À vista, 30 dias, 30/60, 30/60/90
  observacoes            String?
  // ---- Cadastro completo (2026-11-21). Todos opcionais ou com padrão: nenhum dado existente muda. ----
  // status (TEXT) passa a aceitar também "Bloqueado" (não recebe pedidos). nome = razão social / nome.
  codigo                 Int? // sequencial por empresa (exibido como F000001), gerado pelo backend
  filialId               String?
  filial                 Filial?                    @relation(fields: [filialId], references: [id], onDelete: SetNull)
  tipoPessoa             String                     @default("JURIDICA") // JURIDICA | FISICA
  nomeFantasia           String?
  inscricaoEstadual      String?
  ieIsento               Boolean                    @default(false)
  inscricaoMunicipal     String?
  cnae                   String?
  dataAbertura           DateTime?
  regimeTributario       String?
  segmento               String?
  // Endereço estruturado (o campo legado "endereco" continua como texto livre)
  cep                    String?
  logradouro             String?
  numero                 String?
  complemento            String?
  bairro                 String?
  cidade                 String?
  uf                     String?
  pais                   String                     @default("Brasil")
  codigoIbge             String?
  enderecoCobranca       Json? // { cep, logradouro, numero, complemento, bairro, cidade, uf, codigoIbge }
  enderecoAlternativo    Json?
  site                   String?
  emailPedidos           String?
  emailNfe               String?
  // Financeiro (dados bancários: só com fornecedores.administrar)
  formaPagamento         String? // BOLETO | PIX | TRANSFERENCIA | CARTAO
  chavePix               String?
  tipoChavePix           String?
  banco                  String?
  codigoBanco            String?
  agencia                String?
  conta                  String?
  contaDigito            String?
  tipoConta              String? // CORRENTE | POUPANCA | PAGAMENTO
  titular                String?
  titularDocumento       String?
  limiteCredito          Decimal?                   @db.Decimal(14, 2)
  naturezaFinanceira     String?
  planoContas            String?
  centroCusto            String?
  // Fiscal (informativo: nenhum cálculo é feito a partir destes campos)
  contribuinteIcms       Boolean?
  optanteSimples         Boolean?
  retemIrrf              Boolean                    @default(false)
  retemPis               Boolean                    @default(false)
  retemCofins            Boolean                    @default(false)
  retemCsll              Boolean                    @default(false)
  retemIss               Boolean                    @default(false)
  retemInss              Boolean                    @default(false)
  cfopEntrada            String?
  observacoesFiscais     String?
  // Compras e logística
  prazoEntregaDias       Int?
  pedidoMinimo           Decimal?                   @db.Decimal(14, 2)
  modalidadeFrete        String? // CIF | FOB
  transportadora         String?
  compradorId            String?
  comprador              Usuario?                   @relation("FornecedorComprador", fields: [compradorId], references: [id], onDelete: SetNull)
  condicoesComerciais    String?
  observacoesLogisticas  String?
  // Qualidade / homologação
  homologado             Boolean                    @default(false)
  dataHomologacao        DateTime?
  homologadoPor          String?
  validadeCndFederal     DateTime?
  validadeFgts           DateTime?
  validadeCndt           DateTime?
  // Observações internas (nunca enviadas ao fornecedor)
  infoComerciais         String?
  restricoesAtendimento  String?
  orientacoesCompradores String?
  // Auditoria do cadastro (preenchida só pelo backend)
  criadoPorId            String?
  criadoPor              Usuario?                   @relation("FornecedorCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPorId        String?
  atualizadoPor          Usuario?                   @relation("FornecedorAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  contatos               FornecedorContato[]
  produtosFornecidos     FornecedorProduto[]
