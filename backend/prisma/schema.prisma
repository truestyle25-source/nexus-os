  tentativas         Int       @default(0) // falhas consecutivas (backoff exponencial)
  recuperadas        Int       @default(0) // execuÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Âµes ÃƒÆ’Ã‚Â³rfÃƒÆ’Ã‚Â£s desengatadas (lease vencido)
  ultimaExecucaoEm   DateTime?
