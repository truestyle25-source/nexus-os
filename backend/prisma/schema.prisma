/// Documento anexado, guardado em bucket (S3 ou Supabase Storage).
///
/// POR QUE EXISTE
/// -------------
/// Antes as colunas `documentos` de AdvertÃƒÆ’Ã‚Âªncia/SuspensÃƒÆ’Ã‚Â£o/Desligamento eram
 /// `String[]` guardando apenas o NOME do arquivo ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â sem binÃƒÆ’Ã‚Â¡rio, sem caminho, sem
 /// chave. O nome aparecia na tela e no dossie, mas o arquivo nÃƒÆ’Ã‚Â£o existia em lugar
 /// nenhum: era metadado de arquivo inexistente.
 ///
 /// Aqui fica o endereÃƒÆ’Ã‚Â§o real: `chave` ÃƒÆ’Ã‚Â© o caminho dentro do bucket e
 /// `bucket`/`provedor` dizem ONDE ele estÃƒÆ’Ã‚Â¡. O download nunca usa `nomeArquivo`
 /// para montar caminho ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â usa `chave`, que ÃƒÆ’Ã‚Â© o que o provedor reconhece.
 ///
 /// SEGURANÃƒÆ’Ã¢â‚¬Â¡A
 /// ---------
 ///   ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢ `empresaId` ÃƒÆ’Ã‚Â© obrigatÃƒÆ’Ã‚Â³rio e toda leitura filtra por ele: documento de uma
 ///     empresa nunca ÃƒÆ’Ã‚Â© acessÃƒÆ’Ã‚Â­vel por usuÃƒÆ’Ã‚Â¡rio de outra (isolamento por tenant).
 ///   ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢ O bucket ÃƒÆ’Ã‚Â© PRIVADO. O acesso ÃƒÆ’Ã‚Â© por URL assinada com expiraÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o curta
 ///     (`/rh/documentos/:id/download`), nunca por URL pÃƒÆ’Ã‚Âºblica permanente.
 ///   ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢ `contentType` e `tamanho` gravam o que foi declarado no upload e sÃƒÆ’Ã‚Â£o
 ///     devolvidos no download ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â o `Content-Type` da resposta vem daqui, para o
 ///     navegador nÃƒÆ’Ã‚Â£o abrir HTML onde se esperava PDF.
///
model Documento {
  id             String   @id @default(cuid())
  empresaId      String
  // Entidade dona do anexo: Funcionario | Advertencia | Suspensao | Desligamento
  // Guardada como string (e nÃƒÆ’Ã‚Â£o como relaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o) porque o mesmo bucket serve a
  // vÃƒÆ’Ã‚Â¡rias telas; a validaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o de que a entidade existe e pertence ÃƒÆ’Ã‚Â  mesma
  // empresa acontece na rota de upload.
  entidadeTipo    String
  entidadeId      String
  /// Atalho de relacao quando o anexo e de um funcionÃƒÆ’Ã‚Â¡rio (dossiÃƒÆ’Ã‚Âª). O
  /// `Documento` continua genÃƒÆ’Ã‚Â©rico: anexos de AdvertÃƒÆ’Ã‚Âªncia/SuspensÃƒÆ’Ã‚Â£o/Desligamento
  /// usam apenas `entidadeTipo`/`entidadeId`.
  funcionarioId   String?
  funcionario     Funcionario? @relation(fields: [funcionarioId], references: [id])
  // Nome original, sÃƒÆ’Ã‚Â³ para exibiÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o. NUNCA usado para montar caminho no bucket.
  nomeOriginal    String
  // Chave real dentro do bucket, ex.: "empresa-abc/rh/1699999999-contrato.pdf"
  chave           String   @unique
  bucket          String
  provedor        String   @default("s3") // s3 | supabase
  contentType     String
  tamanho         Int      // bytes
  // DescriÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o livre de onde veio (ex.: "Atestado de ponto").
  descricao       String?
  // Quem anexou ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â para auditoria de quem expÃƒÆ’Ã‚Âµe documento de terceiro.
  enviadoPorId    String?
  enviadoPor      Usuario? @relation(fields: [enviadoPorId], references: [id])
  // "disponivel" | "arquivado" ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â o arquivamento NÃƒÆ’Ã†â€™O apaga o objeto do bucket;
  // sÃƒÆ’Ã‚Â³ o esconde do acesso operacional (ver janela de 30 dias no RH).
  situacao         String    @default("disponivel")
  comprovanteDe    PagamentoRH[]
  createdAt        DateTime  @default(now())

  @@index([empresaId, entidadeTipo, entidadeId])
  @@index([funcionarioId])
  @@index([empresaId, situacao])
  @@index([entidadeId])
}

model Advertencia {
