}

/// De onde veio o lanÃƒÆ’Ã‚Â§amento. `PONTO` sÃƒÆ’Ã‚Â³ existe se o mÃƒÆ’Ã‚Â³dulo de ponto tiver
/// batidas reais na competÃƒÆ’Ã‚Âªncia; `AUTOMATICO` ÃƒÆ’Ã‚Â© o salÃƒÆ’Ã‚Â¡rio-base e adicionais
/// derivados do cadastro.
enum OrigemLancamento {
  AUTOMATICO
