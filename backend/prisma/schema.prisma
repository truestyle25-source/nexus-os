  // Redigido por construÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o: guarda apenas { motivo, em } ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â nunca token,
  // segredo, cabeÃƒÆ’Ã‚Â§alho ou corpo de requisiÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o.
  ultimoErro         Json?
  processadosUltima  Int       @default(0)
  falhasUltima       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([empresaId, tipo])
  @@index([status, proximaExecucaoEm])
