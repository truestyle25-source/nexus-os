// ============================================================================
// Etapas 2-9 ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â Unidades, tipos de produto, conversÃƒÆ’Ã‚Âµes e custos
// ============================================================================

enum DimensaoTipo {
  MASSA
  VOLUME
  CONTAGEM
  COMPRIMENTO
  EMBALAGEM
}

enum TipoProdutoEnum {
  MERCADORIA
